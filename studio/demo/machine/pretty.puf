;; pretty.puf -- terms and values back as text.
(require "syntax.puf")
(require "store.puf")
(provide show-term show-value)

(define (show-term [t : Term]) : Str
  (match t
    [(Num n) (number->string n)]
    [(Var x) (symbol->string x)]
    [(Lam x body) (string-append "(λ " (string-append (symbol->string x) (string-append ". " (string-append (show-term body) ")"))))]
    [(App f a) (paren (string-append (show-term f) (string-append " " (show-term a))))]
    [(Add a b) (paren (string-append (show-term a) (string-append " + " (show-term b))))]
    [(If0 c t e) (paren (string-append "if0 " (string-append (show-term c) (string-append " " (string-append (show-term t) (string-append " " (show-term e)))))))]))

(define (show-value [v : Value]) : Str
  (match v
    [(NumV n) (number->string n)]
    [(Clo x body _) (string-append "#<closure " (string-append (show-term (Lam x body)) ">"))]))

(define (paren [s : Str]) : Str
  (string-append "(" (string-append s ")")))
