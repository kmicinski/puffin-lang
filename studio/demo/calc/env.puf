;; env.puf -- environments: what a name is bound to, innermost first.
(provide Env empty-env extend lookup)

(define-type-alias Env (List (Pairof Sym Int)))

(: empty-env Env)
(define empty-env '())

(define (extend [env : Env] [x : Sym] [v : Int]) : Env
  (cons (cons x v) env))

;; an unbound name is an error: the checker cannot rule it out
(define (lookup [env : Env] [x : Sym]) : Int
  (cond [(null? env) (error (string-append "unbound variable " (symbol->string x)))]
        [(eq? (car (car env)) x) (cdr (car env))]
        [else (lookup (cdr env) x)]))
