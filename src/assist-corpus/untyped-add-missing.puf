;; assist: assists @ "[`(add ,a ,b) (list" +1
;; untyped and partial: a match that shares a case with this one
;; offers what it has that this one lacks
(define (eval-expr e)
  (match e
    [`(add ,a ,b) (+ (eval-expr a) (eval-expr b))]
    [`(mul ,a ,b) (* (eval-expr a) (eval-expr b))]
    [(? fixnum? n) n]))

(define (show e)
  (match e
    [`(add ,a ,b) (list 'plus (show a) (show b))]))

(println (eval-expr '(mul 2 3)))
