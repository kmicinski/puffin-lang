== apply 1: add-missing-cases
;; assist: assists @ "(match e" +7 observed=observed.sexp
;; observed shapes the match already handles are not offered again;
;; the new cases' binders are made up, never copied from other matches
(define (interp e env)
  (match e
    [`(add ,l ,r) (+ (interp l env) (interp r env))]
    [(? symbol? v) (cdr (assoc v env))]
    [`(lam ,a ,b) (error "TODO: lam")]
    [(? fixnum? n) (error "TODO: Int")]
    [`(app ,a ,b) (error "TODO: app")]))

(define (show e)
  (match e
    [`(lam (,x) ,body) (list 'fun x (show body))]
    [_ e]))
