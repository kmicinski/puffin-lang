== apply 1: extract
;; assist: assists @ "(+ (ev a env)" +0 select=25
;; extracting a recursive call: the function's own name is global, so
;; it is not a parameter of the extracted function
(define (extracted a env b)
  (+ (ev a env) (ev b env)))

(define (ev e env)
  (match e
    [`(add ,a ,b) (extracted a env b)]
    [_ 0]))
(ev '(add 1 2) '())
== check (exit 0)
{"ok":true}
