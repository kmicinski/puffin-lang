;; assist: assists @ "[`(+ ,a ,b) 1]" +1
;; a partial match over a grammar: the productions no clause can match,
;; in declaration order
(define-grammar Expr
  #:keywords (+ -)
  Int
  (+ Expr Expr)
  (- Expr Expr))

(define (size [e : Expr]) : Int
  (match e
    [`(+ ,a ,b) 1]
    [(? fixnum? n) (error "TODO: Int")]
    [`(- ,e1 ,e2) (let ([r1 (size e1)] [r2 (size e2)]) (error "TODO: -"))]))

(println (size '(+ 1 2)))
