;; assist: rename @ "(f x y)" +3 new=u
;; a parameter shadowed by a let: only the parameter's own uses change
;; -- not the let's x, not the x inside quoted data
(define (f x y)
  (let ([x (+ x 1)] [z x])
    (define (g w) (* w x))
    (let loop ([i 0] [acc '(x y)])
      (if (< i y) (loop (+ i 1) (cons (g i) acc)) (list x z acc)))))
(f 1 2)
