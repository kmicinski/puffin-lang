;; assist: assists @ "(match e" +3
;; the grammar's name avoids the type names already taken (Expr is),
;; and a constructor named like a head does not matter: grammars are
;; structural, nothing is renamed. The file's data says add holds Ints,
;; yet ev recurses into them -- the check after applying says so
(define-type Expr (Add) (Sub))

(define (ev e)
  (match e
    [`(add ,a ,b) (+ (ev a) (ev b))]
    [`(mul ,a ,b) (* (ev a) (ev b))]
    [_ e]))

(ev '(add 1 2))
