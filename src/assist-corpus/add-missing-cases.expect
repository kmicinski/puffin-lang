;; assist: assists @ "[(Num n) 1]" +1
;; a partial match: the constructors it misses, in declaration
;; order, in the existing clauses' bracket style and indentation
(define-type Expr
  (Num Int)
  (Add Expr Expr)
  (Mul Expr Expr)
  (Neg Expr))

(define (size [e : Expr]) : Int
  (match e
    [(Num n) 1]
    [(Mul a b) (+ 1 (+ (size a) (size b)))]
    [(Add e1 e2) (let ([r1 (size e1)] [r2 (size e2)]) (error "TODO: Add"))]
    [(Neg e1) (let ([r1 (size e1)]) (error "TODO: Neg"))]))

(println (size (Num 3)))
