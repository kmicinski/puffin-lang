;; assist: assists @ "(* w (+ n 1))" +0 select=13
;; a selection becomes a new function; its free locals (w, n) become
;; parameters, in order of first mention, and the selection a call
(define-type Expr (Num Int) (Add Expr Expr))

(define (score [e : Expr] [w : Int]) : Int
  (match e
    [(Num n) (* w (+ n 1))]
    [(Add a b) (+ (score a w) (score b w))]))

(score (Num 1) 2)
