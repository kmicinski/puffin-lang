;; define-types through the module system (docs/GRAMMARS.md,
;; docs/MODULES.md): expressions and patterns name a constructor the
;; way they name anything -- bare when imported unqualified, P.Cat
;; under #:as, respelled by #:rename. Templates and quotes are DATA: a
;; constructor builds the list headed by its own source spelling, so a
;; template writes that spelling however the constructor was imported.
(require "ast.puf")
(require "pretty.puf" #:as P)
(require "colors.puf" #:only (Color Red Green color-name) #:rename ((Red Rouge)))

;; unqualified: the templates spell Add / Num / Mul
(define (double [e : Expr]) : Expr `(Mul (Num 2) ,e))
(println (ev (double (mk-sum (list 1 2 3)))))         ;; 12
(println (ev '(Add (Num 40) (Mul (Num 1) (Num 2)))))   ;; 42
(println (match (mk-sum (list 5))
           [`(Add (Num 0) (Num ,n)) n]
           [_ 'other]))                                 ;; 5

;; qualified: expressions and constructor patterns say P.Cat, P.Text;
;; the data they build and match is (Cat ...), (Text ...)
(define doc (P.Cat (P.Text "ab") `(Cat (Text "c") (Text "d"))))
(println (P.render doc))                                ;; abcd
(println (match doc
           [(P.Cat (P.Text s) _) s]
           [`(Text ,s) s]))                              ;; ab

;; #:rename respells the constructor, not its data: Rouge IS Red
(println (color-name Rouge))                            ;; red
(println (map color-name (list 'Red 'Green)))           ;; (red green)
(println (equal? Rouge 'Red))                           ;; #t (one value)
(ev (double `(Num ,(read))))
