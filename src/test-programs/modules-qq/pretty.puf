;; a second define-type, imported #:as-qualified by main: expressions
;; and patterns there say P.Text / P.Cat, its data stays (Text ...)
(provide Doc Text Cat render)

(define-type Doc
  (Text Str)
  (Cat Doc Doc))

(define (render [d : Doc]) : Str
  (match d
    [`(Text ,s) s]
    [`(Cat ,a ,b) (string-append (render a) (render b))]))
