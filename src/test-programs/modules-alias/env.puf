;; env.puf -- an environment module: the alias is exported like a type
(provide Env Value IntV Str2 empty-env extend lookup)

(define-type Value (IntV Int))
(define-type-alias Env (Hash Str Value))
(define-type-alias Str2 (Pairof Str Str))

(define (empty-env) : Env (hash))
(define (extend [env : Env] [x : Str] [v : Value]) : Env (hash-set env x v))
(define (lookup [env : Env] [x : Str]) : Value (hash-ref env x))
