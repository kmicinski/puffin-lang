;; puffincc -- assist.puf: editor assists, `puffincc --assist OP FILE
;; [POS]` (docs/STUDIO.md §2.1, §5).
;;
;; Each operation runs in its own process and prints JSON on stdout.
;; A fatal error (reader, resolver, type error) prints puffincc's usual
;; `error: ... [file:line]` text and exits non-zero instead. Positions
;; are byte offsets into FILE.
;;
;;   check FILE         {"ok":true}
;;   forms FILE         {"forms":[{"key":..,"start":..,"end":..,"line":..}, ...]}
;;   type-at FILE POS   {"type":"Expr"} | {"type":null}
;;   rename FILE POS NEW {"edits":[...]} | {"error":..}: every occurrence of
;;                      the name's binder, refused when the new name
;;                      would change what any name refers to
;;   assists FILE POS   one JSON object per line, each an assist
;;                      {"id":..,"title":..,"source":..,"edits":[{"start":..,"end":..,"text":..}]},
;;                      then {"done":true}. A type error elsewhere in
;;                      the file can stop the checker part way: the
;;                      assists already printed stand.
;;
;; Types at a point come from a probe: the target's text is wrapped in
;; (#%probe ...), the program is checked, and the checker reports the
;; type it synthesized through probe-hook (system.puf). Every assist is
;; a plain text edit computed from syntax.puf's spans; nothing here
;; reprints a tree, so comments and layout outside an edit survive.
;;
;; The driver hands in two functions, since main.puf owns how a file
;; becomes a program: (load-entry path) -> (list forms origins), and
;; (assemble forms origins) -> the (program ...) to check, prelude
;; included.

(require "system.puf")
(require "tables.puf")     ;; prim-table (did-you-mean candidates)
(require "reader.puf")
(require "syntax.puf")
(require "modules.puf")   ;; str-cat
(require "types.puf")     ;; collect-adts, ctor-*, subst, ty, typecheck-program
(require "desugar.puf")   ;; desugar (runs the typechecker first)

;; ---- JSON ---------------------------------------------------------------

(: json-str (-> Str Str))
(define (json-str s)
  (let loop ([i 0] [acc (list "\"")])
    (if (>= i (string-length s))
        (string-concat (reverse (cons "\"" acc)))
        (let ([b (string-byte s i)])
          (loop (+ i 1)
                (cons (cond [(eq? b 34) "\\\""]
                            [(eq? b 92) "\\\\"]
                            [(eq? b 10) "\\n"]
                            [(eq? b 13) "\\r"]
                            [(eq? b 9) "\\t"]
                            [(< b 32) (str-cat "\\u00" (hex2 b))]
                            [else (substring s i (+ i 1))])
                      acc))))))

(define (hex2 b)
  (let ([digits "0123456789abcdef"])
    (str-cat (substring digits (quotient b 16) (+ (quotient b 16) 1))
             (substring digits (remainder b 16) (+ (remainder b 16) 1)))))

;; pairs: (key . already-rendered-json)
(define (json-obj pairs)
  (str-cat "{"
           (string-join (map (lambda (kv) (str-cat (json-str (car kv)) ":" (cdr kv))) pairs) ",")
           "}"))
(define (json-list xs) (str-cat "[" (string-join xs ",") "]"))
(define (json-int n) (number->string n))

;; ---- the entry file's text and syntax ------------------------------------

(define entry-path "")
(define entry-text "")
(define entry-nodes '())

(define (node-text n) (substring entry-text (syn-start n) (syn-end n)))
(define (lst? n) (eq? (car n) 'lst))
(define (atom? n) (eq? (car n) 'atom))
(define (lst-open n) (fourth n))
(define (lst-kids n) (fifth n))
(define (lst-tail n) (car (cdr (cdr (cdr (cdr (cdr n)))))))   ;; a dotted tail's node, or #f
(define (atom-datum n) (fourth n))
(define (fourth xs) (car (cdr (cdr (cdr xs)))))
(define (fifth xs) (car (cdr (cdr (cdr (cdr xs))))))

;; the symbol at the head of a list node, or #f
(define (head-sym n)
  (if (and (lst? n) (pair? (lst-kids n)))
      (let ([h (car (lst-kids n))])
        (if (and (atom? h) (symbol? (atom-datum h))) (atom-datum h) #f))
      #f))

;; the column (0-based) and line (1-based) of a byte offset
(define (col-of pos)
  (let loop ([i pos])
    (if (or (eq? i 0) (eq? (string-byte entry-text (- i 1)) 10))
        (- pos i)
        (loop (- i 1)))))
(define (line-of pos) (reader-advance-line-in entry-text 0 pos 1))
(define (reader-advance-line-in s from to line)
  (let loop ([j from] [line line])
    (if (>= j to)
        line
        (loop (+ j 1) (if (eq? (string-byte s j) 10) (+ line 1) line)))))

(define (spaces n) (string-concat (map (lambda (i) " ") (range 0 n))))

;; ---- forms ------------------------------------------------------------------

;; a top-level form's stable key: what it defines, else its kind and
;; ordinal. Version history and analysis facts key on these.
(define (form-key n expr-index)
  (let ([d (syn->datum n)])
    (match d
      [`(define (,f . ,_) ,_ ...) #:when (symbol? f) (str-cat "define:" (symbol->string f))]
      [`(define ,x ,_ ...) #:when (symbol? x) (str-cat "define:" (symbol->string x))]
      [`(define-type (,t . ,_) ,_ ...) #:when (symbol? t) (str-cat "define-type:" (symbol->string t))]
      [`(define-type ,t ,_ ...) #:when (symbol? t) (str-cat "define-type:" (symbol->string t))]
      [`(: ,x ,_) #:when (symbol? x) (str-cat "sig:" (symbol->string x))]
      [`(require ,m ,_ ...) #:when (string? m) (str-cat "require:" m)]
      [`(provide ,_ ...) "provide"]
      [_ (str-cat "expr:" (number->string expr-index))])))

(define (op-forms)
  (let loop ([ns entry-nodes] [i 0] [seen (hash)] [acc '()])
    (if (null? ns)
        (println (json-obj (list (cons "forms" (json-list (reverse acc))))))
        (let* ([n (car ns)]
               [k0 (form-key n i)]
               [dup (hash-ref/default seen k0 0)]
               [k (if (eq? dup 0) k0 (str-cat k0 "#" (number->string (+ dup 1))))])
          (loop (cdr ns) (+ i 1) (hash-set seen k0 (+ dup 1))
                (cons (json-obj (list (cons "key" (json-str k))
                                      (cons "start" (json-int (syn-start n)))
                                      (cons "end" (json-int (syn-end n)))
                                      (cons "line" (json-int (line-of (syn-start n))))))
                      acc))))))

;; ---- probes -----------------------------------------------------------------

(define (splice-probe start end)
  (str-cat (substring entry-text 0 start)
           "(#%probe " (substring entry-text start end) ")"
           (substring entry-text end (string-length entry-text))))

;; check the program with [start, end) probed; hook gets (type env)
;; once, the first time the checker reaches the probe
(define (run-probe start end hook load-entry assemble)
  (let ([fired #f])
    (set! source-override (cons entry-path (splice-probe start end)))
    (set! probe-hook (lambda (t env)
                       (unless fired
                         (set! fired #t)
                         (hook t env))))
    (let ([fo (load-entry entry-path)])
      (typecheck-program (assemble (first fo) (second fo))))
    (set! probe-hook #f)
    (set! source-override #f)
    fired))

(define (render-type t) (value->string (ty t)))

;; is the node at the head of `path` (innermost first) somewhere a
;; probe must not go: a binder, a type, or a match pattern? Probing
;; one would change what the form means.
(define (binder-position? path)
  (or (in-match-pattern? path)
      (let loop ([p path] [i 0])
        (if (or (null? p) (null? (cdr p)))
            #f
            (let* ([child (car p)] [parent (car (cdr p))]
                   [h (head-sym parent)]
                   [kids (if (lst? parent) (lst-kids parent) '())]
                   [at (lambda (k) (and (> (length kids) k) (eq? (list-ref kids k) child)))]
                   ;; child is a let's binding list: the cursor is a
                   ;; binder iff it IS the name of the binding it is in
                   [names-binding? (lambda ()
                                     (and (eq? i 2)
                                          (let ([b (list-ref path 1)])
                                            (and (lst? b) (pair? (lst-kids b))
                                                 (eq? (car (lst-kids b)) (car path))))))])
              (cond
                ;; (define x ...), (define (f a [b : T]) ...), (lambda (a ...) ...)
                [(and (member h '(define lambda λ)) (at 1)) #t]
                ;; (let ([x e] ...) ...), and a named let's name and bindings
                [(and (member h '(let let* letrec)) (at 1) (lst? child)) (names-binding?)]
                [(and (eq? h 'let) (at 1) (atom? child)) #t]
                [(and (eq? h 'let) (at 2) (lst? child)) (names-binding?)]
                ;; types: (ann e T), (: x T), (define-type ...)
                [(and (eq? h 'ann) (at 2)) #t]
                [(member h '(: define-type)) #t]
                [else (loop (cdr p) (+ i 1))]))))))

(define (in-match-pattern? path)
  (let loop ([p path])
    (cond
      [(or (null? p) (null? (cdr p)) (null? (cdr (cdr p)))) #f]
      [(let ([clause (car (cdr p))] [m (car (cdr (cdr p)))])
         (and (eq? (head-sym m) 'match) (lst? clause) (pair? (lst-kids clause))
              (eq? (car (lst-kids clause)) (car p))
              (memq-node clause (cdr (cdr (lst-kids m))))))
       #t]
      [else (loop (cdr p))])))

(define (memq-node n ns)
  (cond [(null? ns) #f] [(eq? (car ns) n) #t] [else (memq-node n (cdr ns))]))

;; at a binder, the type it is declared with: [x : T] in a define's
;; or lambda's formals gives T's text; else #f
(define (declared-binder-type path)
  (and (pair? path) (pair? (cdr path))
       (let* ([n (car path)] [p (car (cdr path))] [kids (if (lst? p) (lst-kids p) '())])
         ;; [x : T] in formals, [x : T e] in a let
         (and (atom? n) (>= (length kids) 3) (eq? (car kids) n)
              (atom? (second kids)) (eq? (atom-datum (second kids)) ':)
              (node-text (third kids))))))

(define (op-type-at pos load-entry assemble)
  (let* ([path (syn-path-at entry-nodes pos)])
    (if (or (null? path) (binder-position? path))
        (println (json-obj (list (cons "type" (let ([t (declared-binder-type path)])
                                                (if t (json-str t) "null"))))))
        (let* ([n (car path)]
               [fired (run-probe (syn-start n) (syn-end n)
                                 (lambda (t env)
                                   (println (json-obj (list (cons "type" (json-str (render-type t)))))))
                                 load-entry assemble)])
          (unless fired (println (json-obj (list (cons "type" "null")))))))))

;; ---- assists: shared pieces ---------------------------------------------------

(define (edit start end text)
  (json-obj (list (cons "start" (json-int start)) (cons "end" (json-int end))
                  (cons "text" (json-str text)))))

(define (emit-assist id title source edits)
  (println (json-obj (list (cons "id" (json-str id)) (cons "title" (json-str title))
                           (cons "source" (json-str source))
                           (cons "edits" (json-list edits))))))

(define (lower-initial s)
  (let ([b (string-byte s 0)])
    (if (and (< 64 b) (< b 91))
        (substring "abcdefghijklmnopqrstuvwxyz" (- b 65) (- b 64))
        (substring s 0 1))))

;; a binder name for a field of type t (adt? says which names are ADTs)
(define (binder-base t adt?)
  (cond [(eq? t 'Int) "n"] [(eq? t 'Bool) "b"] [(eq? t 'Str) "s"] [(eq? t 'Sym) "sym"]
        [(eq? t 'Void) "v"]
        [(symbol? t) (if (adt? t) (lower-initial (symbol->string (nm t))) "x")]
        [(pair? t)
         (let ([h (car t)])
           (cond [(eq? h 'List) "xs"] [(eq? h 'Vec) "vec"] [(eq? h 'Hash) "h"] [(eq? h 'Set) "st"]
                 [(eq? h 'Pairof) "p"] [(or (eq? h '->) (eq? h '->*)) "f"]
                 [(eq? h 'Mut) (binder-base (car (cdr t)) adt?)]
                 [(and (symbol? h) (adt? h)) (lower-initial (symbol->string (nm h)))]
                 [else "x"]))]
        [else "x"]))

;; fresh binder names for field types: a base used twice, or one the
;; context already uses, is numbered (e1 e2)
(define (field-names fts adt? avoid)
  (let* ([bases (map (lambda (t) (binder-base t adt?)) fts)]
         [count (lambda (b) (length (filter (lambda (x) (string=? x b)) bases)))])
    (let loop ([bs bases] [seen (hash)] [acc '()])
      (if (null? bs)
          (reverse acc)
          (let* ([b (car bs)]
                 [k (+ 1 (hash-ref/default seen b 0))]
                 [numbered? (or (> (count b) 1) (member b avoid))])
            (loop (cdr bs) (hash-set seen b k)
                  (cons (if numbered? (str-cat b (number->string k)) b) acc)))))))

(define (todo-body ctor-name rec-calls)
  (let ([err (str-cat "(error \"TODO: " ctor-name "\")")])
    (if (null? rec-calls)
        err
        (str-cat "(let ("
                 (string-join (map (lambda (rc) (str-cat "[" (car rc) " " (cdr rc) "]")) rec-calls) " ")
                 ") " err ")"))))

;; one clause [(C x y) body]; rec maps a field (name . type) to a
;; recursive-call text or #f
(define (ctor-clause open name fts adt? avoid rec)
  (let* ([close (if (eq? open 91) "]" ")")]
         [openers (if (eq? open 91) "[" "(")]
         [names (field-names fts adt? avoid)]
         [pat (if (null? fts) name (str-cat "(" name " " (string-join names " ") ")"))]
         [calls (filter-map (lambda (nt) (rec nt)) (map2 cons names fts))]
         [rec-calls (map2 (lambda (c i) (cons (str-cat "r" (number->string i)) c))
                          calls (range 1 (+ 1 (length calls))))])
    (str-cat openers pat " " (todo-body name rec-calls) close)))

;; the top-level node containing a path
(define (top-of path) (last path))

;; an enclosing (define (f p ...) ...): (f . param-names), or #f
(define (enclosing-function path)
  (match (syn->datum (top-of path))
    [`(define (,f ,ps ...) ,_ ...) #:when (symbol? f)
     (cons f (map (lambda (p) (match p [`(,x : ,_) x] [x x])) ps))]
    [_ #f]))

;; the recursive call for field b, when the function's parameter
;; `param` is the one being matched: (f a ... b ... c)
(define (rec-call fn param b)
  (let ([args (map (lambda (p) (if (eq? p param) b (symbol->string p))) (cdr fn))])
    (str-cat "(" (symbol->string (car fn)) " " (string-join args " ") ")")))

;; where new clauses go in match node m, and how they are indented
(define (clause-insertion m)
  (let ([clauses (cdr (cdr (lst-kids m)))])
    (if (null? clauses)
        (list (syn-end (car (cdr (lst-kids m)))) (+ (col-of (syn-start m)) 2) 91)
        (let ([lastc (last clauses)])
          (list (syn-end lastc) (col-of (syn-start (car clauses)))
                (if (lst? (car clauses)) (lst-open (car clauses)) 91))))))

(define (insert-clauses-edit m clause-texts)
  (let* ([ins (clause-insertion m)]
         [indent (spaces (second ins))])
    (edit (first ins) (first ins)
          (string-concat (map (lambda (c) (str-cat "\n" indent c)) clause-texts)))))

;; ---- ADT tables (from the checker's own collect-adts) -------------------------

(define adt-tables (ann #f _))
(define (adts) (first adt-tables))
(define (ctors) (second adt-tables))
(define (ctor-orders) (third adt-tables))
(define (adt-name? t) (hash-has-key? (adts) t))
;; source spelling -> the (possibly module-mangled) constructor
(define (ctor-by-source s)
  (findf (lambda (c) (eq? (nm c) s)) (hash-keys (ctors))))

;; the ADT a type names, with its arguments: (name . args), or #f
(define (adt-of t)
  (cond [(and (symbol? t) (adt-name? t)) (cons t '())]
        [(and (pair? t) (symbol? (car t)) (adt-name? (car t))) (cons (car t) (cdr t))]
        [else #f]))

;; a constructor's field types with the scrutinee's type arguments
;; substituted for its parameters
(define (ctor-field-types c args)
  (let* ([info (hash-ref (ctors) c)]
         [env (make-hash)])
    (map2 (lambda (p a) (hash-set! env p a)) (ctor-params info) args)
    (map (lambda (ft) (subst ft env)) (ctor-fields info))))

;; ---- assist: fill match / add missing cases (from the scrutinee's type) ---------

;; the constructors (source spellings) a match's clauses already
;; cover; 'all when a clause can't be proven partial (mirrors
;; check-match-exhaustiveness in types.puf)
(define (covered-ctors m owner)
  (let loop ([cls (cdr (cdr (lst-kids m)))] [acc '()])
    (if (null? cls)
        (reverse acc)
        (let* ([cl (car cls)]
               [p (if (and (lst? cl) (pair? (lst-kids cl))) (syn->datum (car (lst-kids cl))) '_)]
               [cname (cond [(symbol? p) p]
                            [(and (pair? p) (symbol? (car p))) (car p)]
                            [else #f])]
               [c (and cname (ctor-by-source cname))])
          (cond
            [(and c (eq? (ctor-owner (hash-ref (ctors) c)) owner)) (loop (cdr cls) (cons cname acc))]
            [c (loop (cdr cls) acc)]
            [(and (pair? p) (symbol? (car p)) (not (member (car p) '(quote quasiquote cons list vector ?))))
             ;; an unknown head: not a pattern this checker proves partial
             'all]
            [else 'all])))))

(define (match-assists m path t)
  (let* ([ad (adt-of t)])
    (when ad
      (let* ([owner (car ad)] [args (cdr ad)]
             [order (hash-ref/default (ctor-orders) owner '())]
             [covered (covered-ctors m owner)])
        (unless (eq? covered 'all)
          (let* ([missing (filter (lambda (c) (not (member (nm c) covered))) order)]
                 [fn (enclosing-function path)]
                 [scrut (car (cdr (lst-kids m)))]
                 [scrut-sym (and (atom? scrut) (symbol? (atom-datum scrut)) (atom-datum scrut))]
                 [param (and fn scrut-sym (member scrut-sym (cdr fn)) scrut-sym)]
                 [avoid (map symbol->string (append (if scrut-sym (list scrut-sym) '())
                                                    (if fn (cons (car fn) (cdr fn)) '())))]
                 [open (third (clause-insertion m))]
                 [rec (lambda (nt)
                        (and param (equal? (cdr nt) t) (rec-call fn param (car nt))))]
                 [texts (map (lambda (c)
                               (ctor-clause open (symbol->string (nm c)) (ctor-field-types c args)
                                            adt-name? avoid rec))
                             missing)]
                 [tname (render-type t)])
            (when (pair? missing)
              (if (null? covered)
                  (emit-assist "fill-match" (str-cat "Fill match on " tname) "type"
                               (list (insert-clauses-edit m texts)))
                  (emit-assist "add-missing-cases"
                               (str-cat "Add missing cases: "
                                        (string-join (map (lambda (c) (symbol->string (nm c))) missing) ", "))
                               "type"
                               (list (insert-clauses-edit m texts)))))))))))

;; ---- assist: case-split a binder in a constructor pattern ----------------------

;; path: innermost first. The cursor's atom sits directly in a
;; constructor pattern (C ... x ...) somewhere inside clause cl of m.
(define (case-split-assist m cl path t)
  (let* ([a (car path)])
    (when (and (atom? a) (symbol? (atom-datum a)) (pair? (cdr path)))
      (let* ([p (car (cdr path))]
             [cname (head-sym p)]
             [c (and cname (not (eq? (car (lst-kids p)) a)) (ctor-by-source cname))])
        (when c
          (let* ([ad (adt-of t)]
                 ;; the clause's own pattern gets the scrutinee's type
                 ;; arguments; deeper patterns keep the parameters
                 [args (if (and ad (eq? p (car (lst-kids cl))) (eq? (car ad) (ctor-owner (hash-ref (ctors) c))))
                           (cdr ad)
                           '())]
                 [fts (ctor-field-types c args)]
                 [i (index-of-node a (cdr (lst-kids p)))]
                 [ft (list-ref fts i)]
                 [fad (adt-of ft)])
            (when fad
              (let* ([order (hash-ref/default (ctor-orders) (car fad) '())]
                     [avoid (map symbol->string (symbols-of (syn->datum cl)))]
                     [indent (str-cat "\n" (spaces (col-of (syn-start cl))))]
                     [x (atom-datum a)]
                     ;; the guard and body still see x: rebuild it from
                     ;; its parts when they mention it
                     [uses-x? (member x (symbols-of (map syn->datum (cdr (lst-kids cl)))))]
                     [texts
                      (map (lambda (d)
                             (let* ([dfts (ctor-field-types d (cdr fad))]
                                    [names (field-names dfts adt-name? avoid)]
                                    [repl (if (null? dfts)
                                              (symbol->string (nm d))
                                              (str-cat "(" (symbol->string (nm d)) " " (string-join names " ") ")"))])
                               (split-clause cl a repl uses-x?)))
                           order)])
                (emit-assist "case-split"
                             (str-cat "Split " (symbol->string (atom-datum a)) " into "
                                      (string-join (map (lambda (d) (symbol->string (nm d))) order) ", "))
                             "type"
                             (list (edit (syn-start cl) (syn-end cl) (string-join texts indent))))))))))))

;; clause cl with binder atom a replaced by pattern text repl; when
;; the clause's guard or body mentions the binder, each body form is
;; wrapped to rebind it to the value the pattern took apart
(define (split-clause cl a repl rebind?)
  (let* ([kids (lst-kids cl)]
         [pat (car kids)]
         [pat-text (str-cat (substring entry-text (syn-start pat) (syn-start a))
                            repl
                            (substring entry-text (syn-end a) (syn-end pat)))]
         [rest-start (syn-end pat)]
         [rest-end (- (syn-end cl) 1)]
         [rest (substring entry-text rest-start rest-end)]
         [x (symbol->string (atom-datum a))]
         [opener (substring entry-text (syn-start cl) (syn-start pat))]
         [closer (substring entry-text rest-end (syn-end cl))])
    (if (and rebind? (pair? (cdr kids)) (not (has-guard? kids)))
        (str-cat opener pat-text " (let ([" x " " repl "])"
                 (substring entry-text rest-start (syn-start (car (cdr kids))))
                 (substring entry-text (syn-start (car (cdr kids))) rest-end)
                 ")" closer)
        (str-cat opener pat-text rest closer))))

;; a clause [p #:when g body ...]
(define (has-guard? kids)
  (and (pair? (cdr kids)) (atom? (car (cdr kids)))
       (eq? (atom-datum (car (cdr kids))) (string->symbol "#:when"))))

(define (index-of-node n ns)
  (let loop ([ns ns] [i 0])
    (cond [(null? ns) #f] [(eq? (car ns) n) i] [else (loop (cdr ns) (+ i 1))])))

(define (symbols-of d)
  (cond [(symbol? d) (list d)]
        [(pair? d) (append (symbols-of (car d)) (symbols-of (cdr d)))]
        [else '()]))

;; ---- assist: cases from patterns already in the file (untyped data) -------------

;; a clause pattern's family key: what shape of value it recognizes,
;; independent of binder names; #f for binders, wildcards, literals,
;; and constructor patterns (types handle those)
(define (pattern-key d)
  (match d
    ;; list/cons patterns, not quasiquote: a literal quasiquote or
    ;; unquote inside a quasiquote pattern would read as an escape
    [(list 'quasiquote (cons h _)) #:when (symbol? h) (str-cat "qq:" (symbol->string h))]
    [(list 'quote h) #:when (symbol? h) (str-cat "quote:" (symbol->string h))]
    [(cons '? (cons pred _)) #:when (symbol? pred) (str-cat "pred:" (symbol->string pred))]
    [(cons 'list (cons (list 'quote h) _)) #:when (symbol? h) (str-cat "qq:" (symbol->string h))]
    [_ #f]))

;; every match node in the file, with its enclosing top-level form
(define (all-matches)
  (append-map (lambda (top) (map (lambda (m) (cons m top)) (matches-in top))) entry-nodes))
(define (matches-in n)
  (let ([inner (append-map matches-in (syn-kids n))])
    (if (eq? (head-sym n) 'match) (cons n inner) inner)))

;; a match's recognized cases: ((key . pattern-node) ...)
(define (match-cases m)
  (filter-map (lambda (cl)
                (and (lst? cl) (pair? (lst-kids cl))
                     (let ([k (pattern-key (syn->datum (car (lst-kids cl))))])
                       (and k (cons k (car (lst-kids cl)))))))
              (cdr (cdr (lst-kids m)))))

;; the pattern for the shape a quasiquote template builds
(define (template-pattern n)
  (let ([t (fifth n)])
    ;; `(neg ,x) is already a pattern; `(* ,(f a) ,b) is not
    (or (and (general-qq? (syn->datum n)) (node-text n))
        (shape-pattern (list 'list (head-sym t)
                             (if (lst-tail t) #f (length (lst-kids t))))
                       '())
        (node-text n))))

;; quasiquote templates the file BUILDS, outside match patterns:
;; `(add ,a ,b) offers the case `(add ,a ,b)
(define (constructed-cases)
  (let walk ([ns entry-nodes] [acc '()])
    (if (null? ns)
        acc
        (let ([n (car ns)])
          (cond
            [(eq? (head-sym n) 'match)
             ;; the scrutinee, and each clause's guard and body -- not its pattern
             (walk (append (list (car (cdr (lst-kids n))))
                           (append (append-map (lambda (cl) (if (and (lst? cl) (pair? (lst-kids cl))) (cdr (lst-kids cl)) '()))
                                               (cdr (cdr (lst-kids n))))
                                   (cdr ns)))
                   acc)]
            [(and (eq? (car n) 'sugar) (eq? (fourth n) 'quasiquote))
             (let ([k (pattern-key (syn->datum n))])
               (walk (cdr ns) (if (and k (not (assoc k acc))) (cons (cons k n) acc) acc)))]
            [(eq? (car n) 'sugar) (walk (cdr ns) acc)]
            [else (walk (append (syn-kids n) (cdr ns)) acc)])))))

(define (top-name top)
  (match (syn->datum top)
    [`(define (,f . ,_) ,_ ...) (symbol->string f)]
    [`(define ,x ,_ ...) (value->string x)]
    [_ "a top-level expression"]))

(define (case-key-label k)   ;; "qq:add" -> "add"
  (substring k (+ 1 (index-of-colon k)) (string-length k)))
(define (index-of-colon k)
  (let loop ([i 0]) (if (eq? (string-byte k i) 58) i (loop (+ i 1)))))

(define (pattern-clause open pat-text label)
  (str-cat (if (eq? open 91) "[" "(") pat-text " (error \"TODO: " label "\")" (if (eq? open 91) "]" ")")))

(define (pattern-assists m)
  (let* ([mine (match-cases m)]
         [my-keys (map car mine)]
         [open (third (clause-insertion m))]
         [families
          (filter (lambda (f) (pair? (cdr f)))
                  (map (lambda (mt) (cons (top-name (cdr mt)) (match-cases (car mt))))
                       (filter (lambda (mt) (not (eq? (car mt) m))) (all-matches))))]
         [built (constructed-cases)]
         [families (if (pair? built) (append families (list (cons #f built))) families)]
         ;; a family is relevant when it shares a case with this match
         ;; (or this match has none yet); offer what it adds
         [offers
          (filter-map
           (lambda (f)
             (let ([new (filter (lambda (kc) (not (member (car kc) my-keys))) (cdr f))])
               (and (pair? new)
                    (or (null? my-keys) (ormap (lambda (kc) (member (car kc) my-keys)) (cdr f)))
                    (cons (car f) new))))
           families)]
         ;; one offer per distinct set of new cases, the largest first
         [offers (dedupe-offers (sort offers (lambda (a b) (> (length (cdr a)) (length (cdr b))))))])
    (let loop ([os offers] [n 0])
      (when (and (pair? os) (< n 3))
        (let* ([o (car os)]
               [labels (map (lambda (kc) (case-key-label (car kc))) (cdr o))]
               ;; another match's pattern is copied verbatim; a template
               ;; the file builds is code, not a pattern: render its shape
               [texts (map (lambda (kc)
                             (pattern-clause open
                                             (if (car o) (node-text (cdr kc)) (template-pattern (cdr kc)))
                                             (case-key-label (car kc))))
                           (cdr o))])
          (emit-assist (if (null? my-keys) "fill-match" "add-missing-cases")
                       (str-cat (cond [(not (car o)) "Match the shapes this file builds: "]
                                      [(null? my-keys) (str-cat "Match like " (str-cat (car o) ": "))]
                                      [else (str-cat "Add cases from " (str-cat (car o) ": "))])
                                (string-join labels ", "))
                       "patterns"
                       (list (insert-clauses-edit m texts)))
          (loop (cdr os) (+ n 1)))))))

(define (dedupe-offers os)
  (let loop ([os os] [seen '()] [acc '()])
    (if (null? os)
        (reverse acc)
        (let ([ks (sort (map car (cdr (car os))) string<?)])
          (if (member ks seen)
              (loop (cdr os) seen acc)
              (loop (cdr os) (cons ks seen) (cons (car os) acc)))))))

;; ---- assist: structural-recursion template for a define-type ---------------------

(define (template-assist top)
  (match (syn->datum top)
    [`(define-type ,head ,cs ...)
     (let* ([tname (match head [`(,n ,_ ...) n] [n n])]
            [params (match head [`(,_ ,ps ...) ps] [_ '()])]
            [tann (if (null? params)
                      (symbol->string tname)
                      (str-cat "(" (symbol->string tname) " "
                               (string-join (map (lambda (p) "_") params) " ") ")"))]
            [fname (str-cat "fn-for-" (string-downcase (symbol->string tname)))]
            [v (lower-initial (symbol->string tname))]
            [recursive? (lambda (ft) (or (eq? ft tname) (and (pair? ft) (eq? (car ft) tname))))]
            [clauses
             (map (lambda (c)
                    (ctor-clause 91 (symbol->string (car c)) (cdr c)
                                 adt-name? (list v fname)
                                 (lambda (nt) (and (recursive? (cdr nt))
                                                   (str-cat "(" fname " " (car nt) ")")))))
                  cs)])
       (emit-assist "template"
                    (str-cat "Write a function over " (symbol->string tname) " (structural recursion)")
                    "type"
                    (list (edit (syn-end top) (syn-end top)
                                (str-cat "\n\n(define (" fname " [" v " : " tann "])\n"
                                         "  (match " v
                                         (string-concat (map (lambda (cl) (str-cat "\n    " cl)) clauses))
                                         "))")))))]
    [_ (void)]))

(define (string-downcase s)
  (string-concat
   (map (lambda (i)
          (let ([b (string-byte s i)])
            (if (and (< 64 b) (< b 91))
                (substring "abcdefghijklmnopqrstuvwxyz" (- b 65) (- b 64))
                (substring s i (+ i 1)))))
        (range 0 (string-length s)))))

;; ---- assist: stub an unbound function from a call ------------------------------

(define special-forms
  '(define lambda λ let let* letrec if cond case match when unless begin while set!
    quote quasiquote unquote and or not else ann : define-type require provide
    foreign define-foreign-type list vector hash set))

;; names bound around the cursor by the forms on its path
(define (local-binders path)
  (append-map
   (lambda (n)
     (match (syn->datum n)
       [`(define (,f . ,ps) ,body ...) (cons f (append (formal-names ps) (body-defines body)))]
       [`(,lam ,ps ,body ...) #:when (member lam '(lambda λ)) (append (formal-names ps) (body-defines body))]
       [`(let ,name (,bs ...) ,_ ...) #:when (symbol? name) (cons name (binding-names bs))]
       [`(,l (,bs ...) ,_ ...) #:when (member l '(let let* letrec)) (binding-names bs)]
       [`(match ,_ ,cls ...) (append-map (lambda (cl) (if (pair? cl) (pattern-vars-of (car cl)) '())) cls)]
       [_ '()]))
   path))
;; the names a match pattern binds: plain binders, constructor and
;; list/cons/vector arguments, a ?-pattern's subpattern, a quasiquote
;; pattern's unquotes -- not literal heads, quoted data, or the
;; quasiquote/unquote markers themselves
(define (pattern-vars-of d)
  (match d
    [(? symbol? x) (if (or (eq? x '_) (ctor-by-source x)) '() (list x))]
    [(list 'quote _) '()]
    [(list 'quasiquote t) (qq-vars-of t)]
    [(cons '? (cons _ rest)) (append-map pattern-vars-of rest)]
    [(cons h args) #:when (member h '(list cons vector)) (append-map pattern-vars-of args)]
    [(cons h args) #:when (and (symbol? h) (ctor-by-source h)) (append-map pattern-vars-of args)]
    [_ '()]))
(define (qq-vars-of t)
  (match t
    [(list 'unquote p) (pattern-vars-of p)]
    [(cons a b) (append (qq-vars-of a) (qq-vars-of b))]
    [_ '()]))

(define (formal-names ps)
  (cond [(symbol? ps) (list ps)]
        [(pair? ps) (cons (match (car ps) [`(,x : ,_) x] [x x]) (formal-names (cdr ps)))]
        [else '()]))
(define (binding-names bs) (filter-map (lambda (b) (and (pair? b) (symbol? (car b)) (car b))) bs))
(define (body-defines body)
  (filter-map (lambda (f) (match f
                            [`(define (,g . ,_) ,_ ...) g]
                            [`(define ,x ,_) #:when (symbol? x) x]
                            [_ #f]))
              body))

;; every name the program defines at top level, prelude and imports
;; included, in source spelling
(define (program-names forms)
  (append (filter-map (lambda (f) (match f
                                    [`(define (,g . ,_) ,_ ...) (nm g)]
                                    [`(define ,x ,_ ...) #:when (symbol? x) (nm x)]
                                    [`(: ,x ,_) (nm x)]
                                    [_ #f]))
                      forms)
          (map nm (hash-keys (ctors)))))

(define (stub-assist path forms)
  ;; the innermost call around the cursor; nothing inside quoted data
  ;; or a match pattern is a call
  (let ([call (and (not (ormap (lambda (n) (eq? (car n) 'sugar)) path))
                   (not (in-match-pattern? path))
                   (findf head-sym path))])
    (begin
      (when call
        (let ([f (head-sym call)])
          (unless (or (prim? f) (member f special-forms)
                      (member f (local-binders path))
                      (member f (program-names forms))
                      (eq? (string-byte (symbol->string f) 0) 35))   ;; #%internal
            (let* ([args (cdr (lst-kids call))]
                   [names (map2 (lambda (a i)
                                  (if (and (atom? a) (symbol? (atom-datum a)))
                                      (symbol->string (atom-datum a))
                                      (str-cat "x" (number->string i))))
                                args (range 1 (+ 1 (length args))))]
                   [names (dedupe-names names)]
                   [top (top-of path)]
                   [fs (symbol->string f)])
              (emit-assist "stub"
                           (str-cat "Define " fs " (stub, " (number->string (length args)) " arguments)")
                           "call-site"
                           (list (edit (syn-start top) (syn-start top)
                                       (str-cat "(define (" fs (if (null? names) "" " ") (string-join names " ") ")\n"
                                                "  (error \"TODO: " fs "\"))\n\n")))))))))))

(define (dedupe-names names)
  (let loop ([ns names] [i 1] [seen '()] [acc '()])
    (if (null? ns)
        (reverse acc)
        (let ([n (if (member (car ns) seen) (str-cat "x" (number->string i)) (car ns))])
          (loop (cdr ns) (+ i 1) (cons n seen) (cons n acc))))))

;; ---- assist: identity traversal over a define-type -----------------------------

;; the pass that rebuilds every case unchanged, recursing into
;; recursive fields -- ready to change one case
(define (traversal-assist top)
  (match (syn->datum top)
    [`(define-type ,head ,cs ...)
     (let* ([tname (match head [`(,n ,_ ...) n] [n n])]
            [params (match head [`(,_ ,ps ...) ps] [_ '()])]
            [tstr (symbol->string tname)]
            [tann (if (null? params) tstr
                      (str-cat "(" tstr " " (string-join (map (lambda (p) "_") params) " ") ")"))]
            [fname (str-cat "walk-" (string-downcase tstr))]
            [v (lower-initial tstr)]
            [recursive? (lambda (ft) (or (eq? ft tname) (and (pair? ft) (eq? (car ft) tname))))]
            [clauses
             (map (lambda (c)
                    (let* ([cname (symbol->string (car c))]
                           [names (field-names (cdr c) adt-name? (list v fname))]
                           [args (map2 (lambda (n ft) (if (recursive? ft) (str-cat "(" fname " " n ")") n))
                                       names (cdr c))])
                      (if (null? names)
                          (str-cat "[" cname " " cname "]")
                          (str-cat "[(" cname " " (string-join names " ") ") ("
                                   cname " " (string-join args " ") ")]"))))
                  cs)])
       (emit-assist "traversal"
                    (str-cat "Write an identity traversal over " tstr " (rebuild every case)")
                    "type"
                    (list (edit (syn-end top) (syn-end top)
                                (str-cat "\n\n(define (" fname " [" v " : " tann "]) : " tann "\n"
                                         "  (match " v
                                         (string-concat (map (lambda (cl) (str-cat "\n    " cl)) clauses))
                                         "))")))))]
    [_ (void)]))

;; ---- observations (docs/STUDIO.md §3.1, layer 4) --------------------------------

;; --observed FILE: the session's record, ((f CALLS ((shape ...) ...)) ...)
(define observed-file (ann #f _))
(define observed-record '())

(define (load-observed!)
  (when observed-file
    (let ([forms (read-forms-from-string (read-file observed-file))])
      (set! observed-record (if (pair? forms) (car forms) '())))))

;; (calls . per-argument shape lists) for function f, or #f
(define (observed-of f) ((observed-of-in observed-record) f))
(define (observed-of-in record)
  (lambda (f)
    (let ([hit (findf (lambda (r) (and (pair? r) (eq? (car r) f))) record)])
      (and hit (cons (second hit) (third hit))))))

;; a shape's case key, comparable with pattern-key's (so observed
;; shapes a match already handles are not offered again); #f when a
;; shape has no pattern
(define (shape-key s)
  (match s
    ['Int "pred:fixnum?"] ['Str "pred:string?"] ['Bool "pred:boolean?"]
    ['Vec "pred:vector?"] ['Hash "pred:hash?"] ['Proc "pred:procedure?"]
    ['Nil "nil"] ['Pair "cons"]
    ;; observed symbols are usually variables: one case for all of them
    [(list 'sym _) "pred:symbol?"]
    [(list 'list h _) (str-cat "qq:" (symbol->string h))]
    [(list 'adt c) (str-cat "ctor:" (symbol->string c))]
    [_ #f]))

;; every case key a match's clauses already handle, constructor
;; patterns and '() included
(define (clause-keys m)
  (filter-map (lambda (cl)
                (and (lst? cl) (pair? (lst-kids cl))
                     (let ([d (syn->datum (car (lst-kids cl)))])
                       (cond [(pattern-key d) (pattern-key d)]
                             [(equal? d '(quote ())) "nil"]
                             [(and (pair? d) (eq? (car d) 'cons)) "cons"]
                             [(and (pair? d) (symbol? (car d)) (ctor-by-source (car d)))
                              (str-cat "ctor:" (symbol->string (car d)))]
                             [(and (symbol? d) (ctor-by-source d)) (str-cat "ctor:" (symbol->string d))]
                             [else #f]))))
              (cdr (cdr (lst-kids m)))))

;; the first element of xs for each key
(define (dedupe-by key xs)
  (let loop ([xs xs] [seen '()] [acc '()])
    (cond [(null? xs) (reverse acc)]
          [(member (key (car xs)) seen) (loop (cdr xs) seen acc)]
          [else (loop (cdr xs) (cons (key (car xs)) seen) (cons (car xs) acc))])))

(define binder-letters '("a" "b" "c" "d" "e" "f" "g" "h"))

;; the pattern text for a shape: a quasiquote pattern the file
;; already uses for the same head is copied verbatim (its binder
;; names are the author's); else binders are made up
(define (shape-pattern s avoid)
  (match s
    ['Int "(? fixnum? n)"] ['Str "(? string? s)"] ['Bool "(? boolean? b)"]
    ['Vec "(? vector? v)"] ['Hash "(? hash? h)"] ['Proc "(? procedure? f)"]
    ['Nil "'()"] ['Pair "(cons hd tl)"]
    [(list 'sym _) "(? symbol? x)"]
    [(list 'list h n)
     (let ([known (findf (lambda (kc) (and (string=? (car kc) (str-cat "qq:" (symbol->string h)))
                                           (general-qq? (syn->datum (cdr kc)))))
                         (append-map (lambda (mt) (match-cases (car mt))) (all-matches)))])
       (cond
         [known (node-text (cdr known))]
         [(eq? n #f) (str-cat "`(" (symbol->string h) " ,xs ...)")]
         [else
          (let ([names (filter (lambda (x) (not (member x avoid))) binder-letters)])
            (str-cat "`(" (symbol->string h)
                     (string-concat (map (lambda (x) (str-cat " ," x)) (take names (min (- n 1) (length names)))))
                     ")"))]))]
    [(list 'adt c)
     (let ([k (ctor-by-source c)])
       (cond [(not k) #f]
             [(null? (ctor-fields (hash-ref (ctors) k))) (symbol->string c)]
             [else (str-cat "(" (symbol->string c) " "
                            (string-join (field-names (ctor-fields (hash-ref (ctors) k)) adt-name? avoid) " ")
                            ")")]))]
    [_ #f]))

;; a quasiquote pattern that matches every list with its head and
;; shape: past the head, only unquoted binders, ellipses, and nested
;; lists of the same -- `(add ,a ,b) is general, `(add 0 ,b) is not
(define (general-qq? d)
  (match d
    [(list 'quasiquote (cons h rest)) (and (symbol? h) (general-qq-elems? rest))]
    [_ #f]))
(define (general-qq-elems? xs)
  (cond [(null? xs) #t]
        [(not (pair? xs)) #f]
        [else (and (general-qq-elem? (car xs)) (general-qq-elems? (cdr xs)))]))
(define (general-qq-elem? x)
  (match x
    [(list 'unquote v) (symbol? v)]
    [(list 'unquote-splicing v) (symbol? v)]
    ['... #t]
    [(? pair? _) (general-qq-elems? x)]
    [_ #f]))

(define (shape-label s)
  (match s
    [(list 'sym _) "Sym"]
    [(list 'list h _) (symbol->string h)]
    [(list 'adt c) (symbol->string c)]
    [_ (value->string s)]))

;; the scrutinee as a parameter: (fn index param) when the match is on
;; a parameter of its enclosing function, else #f
(define (scrutinee-param m path)
  (let* ([fn (enclosing-function path)]
         [scrut (car (cdr (lst-kids m)))]
         [x (and (atom? scrut) (symbol? (atom-datum scrut)) (atom-datum scrut))]
         [i (and fn x (index-of (cdr fn) x))])
    (and i (list fn i x))))

(define (observed-match-assist m path)
  (shape-match-assist m path (observed-of-in observed-record) "observed"
                      "Match on observed values: " "Add observed cases: " " call" " calls"))

;; is the enclosing function's i-th formal written [x : T]?
(define (param-annotated? path i)
  (match (syn->datum (top-of path))
    [`(define (,_ ,ps ...) ,_ ...) (and (< i (length ps)) (pair? (list-ref ps i)))]
    [_ #f]))

;; the same from the file's own calls with literal arguments
(define (call-site-match-assist m path)
  (shape-match-assist m path (observed-of-in (call-site-record)) "call-site"
                      "Match on the shapes passed at call sites: " "Add cases passed at call sites: "
                      " call site" " call sites"))

;; cases for a match on a parameter, from a record of the shapes that
;; parameter takes (observations or call sites)
(define (shape-match-assist m path lookup source fill-title add-title one many)
  (let ([sp (scrutinee-param m path)])
    ;; an annotated parameter has a type to fill from; shapes are for
    ;; the untyped ones
    (when (and sp (not (param-annotated? path (second sp))))
      (let* ([fn (first sp)] [i (second sp)] [x (third sp)]
             [obs (lookup (car fn))])
        (when (and obs (< i (length (cdr obs))))
          (let* ([have (clause-keys m)]
                 [avoid (map symbol->string (cons x (cdr fn)))]
                 [new (dedupe-by shape-key
                                 (filter (lambda (s) (let ([k (shape-key s)])
                                                       (and k (not (member k have)) (shape-pattern s avoid))))
                                         (list-ref (cdr obs) i)))]
                 [open (third (clause-insertion m))]
                 [texts (map (lambda (s) (pattern-clause open (shape-pattern s avoid) (shape-label s))) new)]
                 [calls (number->string (car obs))])
            (when (pair? new)
              (emit-assist (if (null? (cdr (cdr (lst-kids m)))) "fill-match" "add-missing-cases")
                           (str-cat (if (null? (cdr (cdr (lst-kids m)))) fill-title add-title)
                                    (string-join (map shape-label new) ", ")
                                    " (" calls (if (string=? calls "1") one many) ")")
                           source
                           (list (insert-clauses-edit m texts))))))))))

;; ---- layer 3, first cut: shapes at call sites ---------------------------------------

;; Without running anything, the file's calls with literal arguments
;; already say what a function receives: (interp '(add 1 2) env)
;; passes interp a (list add 3). call-site-record has the observation
;; record's form, ((f CALLS ((shape ...) ...)) ...), counting only the
;; calls that pass at least one literal.
(define call-site-cache (ann #f _))
(define (call-site-record)
  (unless call-site-cache
    (set! call-site-cache (build-call-site-record)))
  call-site-cache)

(define (build-call-site-record)
  (let* ([fns (filter-map (lambda (top) (match (syn->datum top)
                                          [`(define (,f ,ps ...) ,_ ...)
                                           #:when (and (symbol? f) (andmap (lambda (p) (or (symbol? p) (pair? p))) ps))
                                           (cons f (length ps))]
                                          [_ #f]))
                          entry-nodes)]
         [calls (append-map (lambda (top) (calls-in top fns)) entry-nodes)])
    (filter-map
     (lambda (fa)
       (let* ([f (car fa)] [arity (cdr fa)]
              [mine (filter (lambda (c) (and (eq? (car c) f) (eq? (length (cdr c)) arity))) calls)]
              [shaped (filter (lambda (c) (ormap (lambda (s) s) (cdr c))) mine)])
         (and (pair? shaped)
              (list f (length shaped)
                    (map (lambda (i)
                           (dedupe-by (lambda (s) s)
                                      (filter-map (lambda (c) (list-ref (cdr c) i)) shaped)))
                         (range 0 arity))))))
     fns)))

;; every call to one of fns in node n: (f shape-or-#f ...), outside
;; quoted data
(define (calls-in n fns)
  (cond
    [(atom? n) '()]
    [(eq? (car n) 'sugar)
     (cond [(eq? (fourth n) 'quote) '()]
           [(eq? (fourth n) 'quasiquote) (calls-in-template (fifth n) fns)]
           [else (calls-in (fifth n) fns)])]
    [else
     (let* ([h (head-sym n)]
            [here (if (and h (assoc h fns) (not (eq? h 'define)))
                      (list (cons h (map literal-shape (cdr (lst-kids n)))))
                      '())])
       (append here (append-map (lambda (k) (calls-in k fns)) (lst-kids n))))]))

;; calls inside a quasiquote template's unquotes
(define (calls-in-template n fns)
  (cond
    [(and (eq? (car n) 'sugar) (member (fourth n) '(unquote unquote-splicing))) (calls-in (fifth n) fns)]
    [(eq? (car n) 'sugar) (calls-in-template (fifth n) fns)]
    [(lst? n) (append-map (lambda (k) (calls-in-template k fns)) (lst-kids n))]
    [else '()]))

;; the shape of a literal argument, or #f
(define (literal-shape n)
  (cond
    [(atom? n)
     (let ([d (atom-datum n)])
       (cond [(fixnum? d) 'Int] [(string? d) 'Str] [(boolean? d) 'Bool]
             [(and (symbol? d) (ctor-by-source d)
                   (null? (ctor-fields (hash-ref (ctors) (ctor-by-source d)))))
              (list 'adt d)]
             [else #f]))]
    [(eq? (car n) 'sugar)
     (cond [(eq? (fourth n) 'quote) (datum-shape (syn->datum (fifth n)))]
           [(eq? (fourth n) 'quasiquote)
            (let ([t (fifth n)])
              (and (lst? t) (pair? (lst-kids t)) (head-sym t)
                   (list 'list (head-sym t)
                         (if (ormap (lambda (k) (and (eq? (car k) 'sugar) (eq? (fourth k) 'unquote-splicing)))
                                    (lst-kids t))
                             #f
                             (length (lst-kids t))))))]
           [else #f])]
    [(and (head-sym n) (ctor-by-source (head-sym n))) (list 'adt (head-sym n))]
    [else #f]))

(define (datum-shape d)
  (cond [(null? d) 'Nil] [(symbol? d) (list 'sym d)] [(fixnum? d) 'Int] [(string? d) 'Str]
        [(boolean? d) 'Bool]
        [(and (pair? d) (symbol? (car d)) (list? d)) (list 'list (car d) (length d))]
        [(pair? d) 'Pair]
        [else #f]))

;; the type a list of shapes supports, or _
(define (shapes-type ss)
  (let ([ts (map (lambda (s)
                   (match s
                     ['Int 'Int] ['Str 'Str] ['Bool 'Bool]
                     [(list 'sym _) 'Sym]
                     [(list 'list _ _) 'list] ['Nil 'list] ['Pair 'list]
                     [(list 'adt c) (let ([k (ctor-by-source c)])
                                      (if k (ctor-owner (hash-ref (ctors) k)) '_))]
                     [_ '_]))
                 ss)])
    (cond [(null? ts) '_]
          [(andmap (lambda (t) (equal? t (car ts))) ts)
           (let ([t (car ts)])
             (cond [(eq? t 'list) "(List _)"]
                   [(eq? t '_) "_"]
                   [(and (adt-name? t) (pair? (hash-ref (adts) t)))
                    (str-cat "(" (symbol->string (nm t))
                             (string-concat (map (lambda (p) " _") (hash-ref (adts) t))) ")")]
                   [else (symbol->string (nm t))]))]
          [else "_"])))

;; on a top-level (define (f a ...) ...) with no annotations and no
;; (: f ...) yet: declare f's type from the argument types observed
(define (annotate-assist top)
  (match (syn->datum top)
    [`(define (,f ,ps ...) ,body ...)
     #:when (and (symbol? f) (andmap symbol? ps)
                 (not (and (pair? body) (eq? (car body) ':))))
     (let ([obs (observed-of f)]
           [declared (findf (lambda (n) (match (syn->datum n) [`(: ,g ,_) (eq? g f)] [_ #f])) entry-nodes)])
       (when (and obs (not declared) (eq? (length (cdr obs)) (length ps)))
         (let ([ts (map shapes-type (cdr obs))])
           (unless (andmap (lambda (t) (string=? t "_")) ts)
             (let ([sig (str-cat "(-> " (string-join (append ts (list "_")) " ") ")")]
                   [calls (number->string (car obs))])
               (emit-assist "annotate"
                            (str-cat "Annotate " (symbol->string f) " from " calls
                                     (if (string=? calls "1") " observed call: " " observed calls: ") sig)
                            "observed"
                            (list (edit (syn-start top) (syn-start top)
                                        (str-cat "(: " (symbol->string f) " " sig ")\n")))))))))]
    [_ (void)]))

;; ---- assist: fill a typed hole ------------------------------------------------------

;; ?? marks a missing expression. Outside assists it is an unbound
;; name, so a program with a hole does not compile; under a probe it
;; checks as _ (types.puf lookup). At a hole, offer the locals whose
;; type fits the hole's expected type (exact matches first), and,
;; when that type is an ADT, each constructor applied to new holes.

;; the hole's expected type from where it sits: an argument gets the
;; operator's formal (probed), a define's body its declared result;
;; and the probe's env gives the locals in scope. Calls (k type env).
(define (hole-goal path k load-entry assemble)
  (let* ([hole (car path)]
         [p (and (pair? (cdr path)) (car (cdr path)))]
         [pkids (if (and p (lst? p)) (lst-kids p) '())]
         [i (index-of-node hole pkids)]
         [top (top-of path)]
         [declared-rt (match (syn->datum top)
                        [`(define (,_ . ,_) : ,rt ,_ ...) rt]
                        [_ '_])])
    (if (and i (> i 0) (head-sym p) (not (member (head-sym p) special-forms)))
        ;; an argument: probe the operator for its arrow
        (run-probe (syn-start (car pkids)) (syn-end (car pkids))
                   (lambda (t env) (k (formal-at (blank-tyvars t) (- i 1)) env))
                   load-entry assemble)
        (run-probe (syn-start hole) (syn-end hole)
                   (lambda (t env)
                     (k (if (tail-of-define? path) declared-rt '_) env))
                   load-entry assemble))))

;; is the node at the head of path in tail position of its top-level
;; define's body -- the last body form, or reached from it through
;; the tail positions of match clauses, if/when/unless branches,
;; let/let*/begin bodies, and cond clauses? Its value is then the
;; function's result.
(define (tail-of-define? path)
  (let loop ([p path])
    (if (or (null? p) (null? (cdr p)))
        #f
        (let* ([n (car p)] [parent (car (cdr p))]
               [kids (if (lst? parent) (lst-kids parent) '())]
               [last? (and (pair? kids) (eq? (last kids) n))]
               [h (head-sym parent)]
               [grand (and (pair? (cdr (cdr p))) (car (cdr (cdr p))))])
          (cond
            [(null? (cdr (cdr p)))   ;; parent is the top-level form
             (and last? (eq? h 'define))]
            [(and last? (member h '(if when unless let let* letrec begin))) (loop (cdr p))]
            [(and (eq? h 'if) (> (length kids) 2) (eq? (list-ref kids 2) n)) (loop (cdr p))]
            ;; a match or cond clause [p body ...]: its last form
            [(and last? grand (member (head-sym grand) '(match cond))
                  (memq-node parent (cdr (lst-kids grand))))
             (loop (cdr (cdr p)))]
            [else #f])))))

;; the type of argument i under arrow type t, or _
(define (formal-at t i)
  (match t
    [`(-> ,as ... ,_) (if (< i (length as)) (list-ref as i) '_)]
    [`(->* (,as ...) ,rest ,_) (if (< i (length as)) (list-ref as i) rest)]
    [_ '_]))

(define (hole-assists path load-entry assemble)
  (let ([hole (car path)])
    (hole-goal
     path
     (lambda (goal env)
       (let* ([locals (dedupe-by car (filter (lambda (b) (and (symbol? (car b))
                                                               (not (eq? (car b) '??))))
                                             env))]
              [fits (filter (lambda (b) (consistent? (cdr b) goal)) locals)]
              [exact (filter (lambda (b) (and (not (eq? goal '_)) (equal? (cdr b) goal))) fits)]
              [loose (filter (lambda (b) (not (member b exact))) fits)]
              [ranked (take (append exact loose) (min 8 (length (append exact loose))))]
              [gname (render-type goal)])
         (for-each-node
          (lambda (b)
            (emit-assist "fill-hole"
                         (str-cat "Fill ?? with " (symbol->string (car b)) " : " (render-type (cdr b))
                                  (if (eq? goal '_) "" (str-cat "  (goal " gname ")")))
                         "type"
                         (list (edit (syn-start hole) (syn-end hole) (symbol->string (car b))))))
          ranked)
         ;; the enclosing function itself, when the goal is its result
         (let ([fn (enclosing-function path)]
               [rt (match (syn->datum (top-of path)) [`(define (,_ . ,_) : ,rt ,_ ...) rt] [_ '_])])
           (when (and fn (not (eq? goal '_)) (equal? rt goal))
             (let ([text (str-cat "(" (symbol->string (car fn))
                                  (string-concat (map (lambda (p) " ??") (cdr fn))) ")")])
               (emit-assist "fill-hole" (str-cat "Fill ?? with " text "  (recursion; goal " gname ")") "type"
                            (list (edit (syn-start hole) (syn-end hole) text))))))
         (let ([ad (adt-of goal)])
           (when ad
             (for-each-node
              (lambda (c)
                (let* ([n (length (ctor-fields (hash-ref (ctors) c)))]
                       [text (if (eq? n 0)
                                 (symbol->string (nm c))
                                 (str-cat "(" (symbol->string (nm c))
                                          (string-concat (map (lambda (i) " ??") (range 0 n))) ")"))])
                  (emit-assist "fill-hole" (str-cat "Fill ?? with " text "  (goal " gname ")") "type"
                               (list (edit (syn-start hole) (syn-end hole) text)))))
              (hash-ref/default (ctor-orders) (car ad) '()))))))
     load-entry assemble)))

;; ---- assist: extract a selection into a function ------------------------------------

;; the node a selection [s, e) means: the one spanning it exactly
;; (whitespace trimmed), else the smallest node containing it
(define (selection-node s e)
  (let* ([s2 (skip-space-forward s e)]
         [e2 (skip-space-backward s2 e)]
         [path (syn-path-at entry-nodes s2)])
    (findf (lambda (n) (and (<= (syn-start n) s2) (<= e2 (syn-end n)))) path)))

(define (space-byte? b) (if (member b '(32 9 10 13)) #t #f))
(define (skip-space-forward s e)
  (if (and (< s e) (space-byte? (string-byte entry-text s))) (skip-space-forward (+ s 1) e) s))
(define (skip-space-backward s e)
  (if (and (< s e) (space-byte? (string-byte entry-text (- e 1)))) (skip-space-backward s (- e 1)) e))

;; the path from a node up to its top-level form, node first
(define (path-to n)
  (let loop ([p (syn-path-at entry-nodes (syn-start n))])
    (cond [(null? p) '()]
          [(eq? (car p) n) p]
          [else (loop (cdr p))])))

;; a node's text re-indented for column `col`: continuation lines lose
;; the node's own column and gain col
(define (reindent n col)
  (let ([from (col-of (syn-start n))])
    (string-join
     (let loop ([lines (split-lines (node-text n))] [first #t] [acc '()])
       (if (null? lines)
           (reverse acc)
           (loop (cdr lines) #f
                 (cons (if first (car lines) (str-cat (spaces col) (drop-spaces (car lines) from)))
                       acc))))
     "\n")))

(define (split-lines s)
  (let loop ([i 0] [start 0] [acc '()])
    (cond [(eq? i (string-length s)) (reverse (cons (substring s start i) acc))]
          [(eq? (string-byte s i) 10) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc))]
          [else (loop (+ i 1) start acc)])))

(define (drop-spaces line k)
  (let loop ([i 0])
    (if (and (< i k) (< i (string-length line)) (eq? (string-byte line i) 32))
        (loop (+ i 1))
        (substring line i (string-length line)))))

;; a top-level name no form defines yet
(define (fresh-top-name base)
  (let ([taken (filter-map (lambda (n) (match (syn->datum n)
                                         [`(define (,f . ,_) ,_ ...) f]
                                         [`(define ,x ,_ ...) x]
                                         [_ #f]))
                           entry-nodes)])
    (let loop ([i 1])
      (let ([name (if (eq? i 1) base (str-cat base "-" (number->string i)))])
        (if (member (string->symbol name) taken) (loop (+ i 1)) name)))))

;; Extract the selected expression into a new top-level function. Its
;; parameters are the selection's free locals: the names it mentions
;; that the forms around it bind, in order of first mention.
(define (extract-assist s e)
  (let ([n (selection-node s e)])
    (when (and n (not (eq? (car n) 'sugar)))
      (let* ([path (path-to n)]
             [top (top-of path)])
        (unless (or (eq? n top) (binder-position? path))
          (let* ([tops (map atom-datum (append-map top-binders entry-nodes))]
                 ;; a function's own name (a recursive call) is global,
                 ;; not a free local
                 [around (filter (lambda (x) (not (member x tops))) (local-binders (cdr path)))]
                 [mentioned (dedupe-by (lambda (x) x) (symbols-of (syn->datum n)))]
                 [free (filter (lambda (x) (member x around)) mentioned)]
                 [name (fresh-top-name "extracted")]
                 [params (map symbol->string free)]
                 [call (str-cat "(" name (if (null? params) "" " ") (string-join params " ") ")")])
            (emit-assist "extract"
                         (str-cat "Extract into a function: " call)
                         "syntax"
                         (list (edit (syn-start top) (syn-start top)
                                     (str-cat "(define (" name (if (null? params) "" " ")
                                              (string-join params " ") ")\n  "
                                              (reindent n 2) ")\n\n"))
                               (edit (syn-start n) (syn-end n) call)))))))))

;; ---- assist: did you mean --------------------------------------------------------------

;; Levenshtein distance, two rows
(define (edit-distance a b)
  (let* ([n (string-length a)] [m (string-length b)]
         [first-row (make-vector (+ m 1))])
    (let init ([j 0]) (when (<= j m) (vector-set! first-row j j) (init (+ j 1))))
    (let row ([i 1] [prev first-row])
      (if (> i n)
          (vector-ref prev m)
          (let ([cur (make-vector (+ m 1))])
            (vector-set! cur 0 i)
            (let col ([j 1])
              (when (<= j m)
                (vector-set! cur j
                             (min (+ 1 (vector-ref prev j))
                                  (min (+ 1 (vector-ref cur (- j 1)))
                                       (+ (vector-ref prev (- j 1))
                                          (if (eq? (string-byte a (- i 1)) (string-byte b (- j 1))) 0 1)))))
                (col (+ j 1))))
            (row (+ i 1) cur))))))

;; the surface prims, by name
(define (prim-names)
  (filter-map (lambda (row) (and (pair? row) (symbol? (car row)) (eq? (fourth row) #t) (car row)))
              prim-table))

;; on a name nothing binds: the bound names closest to it
(define (did-you-mean-assist path forms)
  (let ([a (car path)])
    (when (and (atom? a) (symbol? (atom-datum a))
               (not (binder-position? path))
               (not (ormap (lambda (n) (eq? (car n) 'sugar)) path)))
      (let* ([x (atom-datum a)]
             [xs (symbol->string x)]
             [bound (append (local-binders path) (program-names forms))])
        (unless (or (prim? x) (member x special-forms) (member x bound)
                    (eq? x '??) (eq? (string-byte xs 0) 35))
          (let* ([limit (if (< (string-length xs) 5) 1 2)]
                 [scored (filter-map (lambda (b)
                                       (and (symbol? b)
                                            (let ([d (edit-distance xs (symbol->string b))])
                                              (and (<= d limit) (cons d b)))))
                                     (dedupe-by (lambda (b) b)
                                                (append bound (append (prim-names) special-forms))))]
                 [best (sort scored (lambda (p q) (< (car p) (car q))))])
            (for-each-node
             (lambda (p)
               (emit-assist "did-you-mean"
                            (str-cat "Replace " xs " with " (symbol->string (cdr p)) " (did you mean?)")
                            "syntax"
                            (list (edit (syn-start a) (syn-end a) (symbol->string (cdr p))))))
             (take best (min 3 (length best))))))))))


;; ---- assist: promote an s-expression language to a define-type -----------------------

;; A match whose cases are quasiquote patterns like `(add ,a ,b) is an
;; untyped language. Promote it: declare (define-type Expr (Add _ _)
;; ...) from the cases' heads and arities, and rewrite the file to use
;; it -- every match clause over those shapes becomes a constructor
;; pattern, every quasiquote template and quoted datum that builds them
;; a constructor call. Fields start as _ (gradual), to tighten later.
;; Code that takes such data apart by hand ((car e), (cadr e)) is not
;; rewritten; the check after applying shows where it breaks.

;; `(h ,x ...) with only unquoted binders past the head: (h . names)
(define (simple-qq d)
  (match d
    [(list 'quasiquote (cons h rest))
     (and (symbol? h) (list? rest)
          (andmap (lambda (x) (match x [(list 'unquote v) (symbol? v)] [_ #f])) rest)
          (cons h (map (lambda (x) (second x)) rest)))]
    [_ #f]))

(define (capitalize s)
  (let ([b (string-byte s 0)])
    (if (and (< 96 b) (< b 123))
        (str-cat (substring "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (- b 97) (- b 96)) (substring s 1 (string-length s)))
        s)))

;; family: ((head arity ctor-name) ...)
(define promote-family '())
(define (family-ctor h n)
  (let ([hit (findf (lambda (f) (and (eq? (first f) h) (eq? (second f) n))) promote-family)])
    (and hit (third hit))))

;; the text of node n with every promotable use rewritten; `pattern?`
;; says n sits where a match pattern does
(define (promote-text n pattern?)
  (cond
    [(atom? n) (node-text n)]
    [(eq? (car n) 'sugar)
     (let ([head (fourth n)])
       (cond
         [(and pattern? (eq? head 'quasiquote))
          (let ([sq (simple-qq (syn->datum n))])
            (let ([c (and sq (family-ctor (car sq) (length (cdr sq))))])
              (if c
                  (if (null? (cdr sq)) c (str-cat "(" c " " (string-join (map symbol->string (cdr sq)) " ") ")"))
                  (node-text n))))]
         [(eq? head 'quasiquote) (or (promote-template (fifth n)) (node-text n))]
         [(eq? head 'quote) (or (promote-quoted (syn->datum (fifth n))) (node-text n))]
         [else (str-cat (substring entry-text (syn-start n) (syn-start (fifth n)))
                        (promote-text (fifth n) pattern?))]))]
    [(and (not pattern?) (eq? (head-sym n) 'match) (pair? (cdr (lst-kids n))))
     (rebuild n (lambda (k i)
                  (cond [(< i 2) (promote-text k #f)]
                        [(and (lst? k) (pair? (lst-kids k)))
                         (rebuild k (lambda (k2 j) (promote-text k2 (eq? j 0))))]
                        [else (node-text k)])))]
    [else (rebuild n (lambda (k i) (promote-text k pattern?)))]))

;; n's text with each kid replaced by (f kid index); the gaps between
;; kids (whitespace, comments, brackets) are kept verbatim
(define (rebuild n f)
  (let loop ([kids (syn-kids n)] [i 0] [at (syn-start n)] [acc '()])
    (if (null? kids)
        (string-concat (reverse (cons (substring entry-text at (syn-end n)) acc)))
        (let ([k (car kids)])
          (loop (cdr kids) (+ i 1) (syn-end k)
                (cons (f k i) (cons (substring entry-text at (syn-start k)) acc)))))))

;; a quasiquote template building a family shape: its constructor call
(define (promote-template t)
  (and (lst? t) (head-sym t) (not (lst-tail t))
       (let* ([h (head-sym t)] [args (cdr (lst-kids t))]
              [c (family-ctor h (length args))])
         (and c
              (let ([parts (map (lambda (a)
                                  (cond
                                    [(and (eq? (car a) 'sugar) (eq? (fourth a) 'unquote))
                                     (promote-text (fifth a) #f)]
                                    [(atom? a)
                                     (let ([d (atom-datum a)])
                                       (if (symbol? d) (str-cat "'" (node-text a)) (node-text a)))]
                                    [(lst? a) (promote-template a)]
                                    [else #f]))
                                args)])
                (and (andmap (lambda (p) p) parts)
                     (if (null? parts) c (str-cat "(" c " " (string-join parts " ") ")"))))))))

;; quoted data that is all family shapes and atoms: constructor calls
(define (promote-quoted d)
  (cond
    [(and (pair? d) (symbol? (car d)) (list? d) (family-ctor (car d) (length (cdr d))))
     (let ([c (family-ctor (car d) (length (cdr d)))]
           [parts (map promote-quoted-arg (cdr d))])
       (and (andmap (lambda (p) p) parts)
            (if (null? parts) c (str-cat "(" c " " (string-join parts " ") ")"))))]
    [else #f]))
(define (promote-quoted-arg d)
  (cond [(fixnum? d) (number->string d)]
        [(boolean? d) (if d "#t" "#f")]
        [(string? d) (json-str d)]
        [(symbol? d) (str-cat "'" (symbol->string d))]
        [(null? d) "'()"]
        [else (promote-quoted d)]))

(define (fresh-type-name base forms)
  (let ([taken (append (map nm (hash-keys (adts))) (program-names forms))])
    (let loop ([i 1])
      (let ([name (if (eq? i 1) base (str-cat base (number->string i)))])
        (if (member (string->symbol name) taken) (loop (+ i 1)) name)))))

(define (promote-assist m path forms)
  (let* ([shapes (filter-map (lambda (cl) (and (lst? cl) (pair? (lst-kids cl))
                                               (simple-qq (syn->datum (car (lst-kids cl))))))
                             (cdr (cdr (lst-kids m))))]
         [heads (dedupe-by (lambda (s) s) (map car shapes))]
         [taken (append (map nm (hash-keys (ctors))) (program-names forms))])
    (when (>= (length heads) 2)
      (let ([family (map (lambda (h)
                           (let ([s (findf (lambda (s) (eq? (car s) h)) shapes)])
                             (list h (length (cdr s)) (capitalize (symbol->string h)))))
                         heads)])
        ;; one arity per head, and constructor names that are free
        (when (and (andmap (lambda (f) (andmap (lambda (s) (or (not (eq? (car s) (first f)))
                                                               (eq? (length (cdr s)) (second f))))
                                                shapes))
                           family)
                   (not (ormap (lambda (f) (member (string->symbol (third f)) taken)) family)))
          (set! promote-family family)
          (let* ([tname (fresh-type-name "Expr" forms)]
                 [evidence (field-evidence family)]
                 [decl (str-cat "(define-type " tname
                                (string-concat
                                 (map (lambda (f)
                                        (str-cat "\n  (" (third f)
                                                 (string-concat
                                                  (map (lambda (i) (str-cat " " (field-type evidence (first f) i tname)))
                                                       (range 0 (second f))))
                                                 ")"))
                                      family))
                                ")\n\n")]
                 [top (top-of path)]
                 ;; each changed top-level form is one edit; the
                 ;; declaration goes in front of the match's own form
                 [changed (filter-map (lambda (t)
                                        (let ([new (promote-text t #f)])
                                          (and (not (string=? new (node-text t))) (cons t new))))
                                      entry-nodes)]
                 [edits (map (lambda (tn)
                               (edit (syn-start (car tn)) (syn-end (car tn))
                                     (if (eq? (car tn) top) (str-cat decl (cdr tn)) (cdr tn))))
                             changed)]
                 [edits (if (assoc-node top changed) edits
                            (cons (edit (syn-start top) (syn-start top) decl) edits))])
            (set! promote-family '())
            (emit-assist "promote"
                         (str-cat "Promote " (string-join (map (lambda (f) (symbol->string (first f))) family) ", ")
                                  " to a define-type " tname " (rewrites " (number->string (length changed))
                                  (if (eq? (length changed) 1) " form)" " forms)"))
                         "patterns"
                         edits)))))))

;; what the file's data says each field holds: every quoted datum and
;; quasiquote template building a family shape contributes the kind
;; of each literal argument -- Int, Str, Bool, or `family` for a nested
;; family shape. A hash head#i -> (kind ...), keyed by an interned
;; symbol: a mutable hash keys pairs and strings by identity.
(define (field-key h i) (string->symbol (str-cat (symbol->string h) "#" (number->string i))))
(define (field-evidence family)
  (let ([ev (make-hash)])
    (define (note! h i kind)
      (hash-set! ev (field-key h i) (cons kind (hash-ref/default ev (field-key h i) '()))))
    (define (from-datum d)
      (when (and (pair? d) (symbol? (car d)) (list? d))
        (when (findf (lambda (f) (and (eq? (first f) (car d)) (eq? (second f) (length (cdr d))))) family)
          (let loop ([as (cdr d)] [i 0])
            (when (pair? as)
              (let ([a (car as)])
                (cond [(fixnum? a) (note! (car d) i 'Int)]
                      [(string? a) (note! (car d) i 'Str)]
                      [(boolean? a) (note! (car d) i 'Bool)]
                      [(and (pair? a) (symbol? (car a))
                            (findf (lambda (f) (and (eq? (first f) (car a)) (eq? (second f) (length (cdr a))))) family))
                       (note! (car d) i 'family)]
                      [(pair? a) (note! (car d) i 'other)]
                      [(symbol? a) (note! (car d) i 'other)]
                      [else (void)])
                (from-datum a))
              (loop (cdr as) (+ i 1)))))))
    (define (walk n)
      (cond [(and (eq? (car n) 'sugar) (eq? (fourth n) 'quote)) (from-datum (syn->datum (fifth n)))]
            ;; a template's unquotes say nothing; its literal parts do
            [(and (eq? (car n) 'sugar) (eq? (fourth n) 'quasiquote))
             (from-datum (strip-unquotes (syn->datum (fifth n))))]
            [else (for-each-node walk (syn-kids n))]))
    (for-each-node walk entry-nodes)
    ev))

;; a template datum with each unquote replaced by a marker that is no
;; kind of evidence
(define (strip-unquotes d)
  (cond [(and (pair? d) (eq? (car d) 'unquote)) (vector)]
        [(pair? d) (cons (strip-unquotes (car d)) (strip-unquotes (cdr d)))]
        [else d]))

;; one field's declared type: what all its evidence agrees on, else _
(define (field-type ev h i tname)
  (let ([kinds (hash-ref/default ev (field-key h i) '())])
    (cond [(null? kinds) "_"]
          [(andmap (lambda (k) (eq? k (car kinds))) kinds)
           (cond [(eq? (car kinds) 'family) tname]
                 [(eq? (car kinds) 'other) "_"]
                 [else (symbol->string (car kinds))])]
          [else "_"])))

(define (assoc-node n pairs)
  (findf (lambda (p) (eq? (car p) n)) pairs))

;; ---- assist: annotate a parameter from its constructor patterns ------------------------

;; a match on an unannotated parameter whose clauses are constructor
;; patterns of one ADT (or catch-alls): the parameter is that type.
;; Annotating it turns on the type's assists (exhaustiveness, fill)
;; and a cast with blame at the function's entry.
(define (annotate-param-assist m path)
  (let ([sp (scrutinee-param m path)])
    (when (and sp (not (param-annotated? path (second sp))))
      (let* ([owners (filter-map (lambda (cl)
                                   (and (lst? cl) (pair? (lst-kids cl))
                                        (let* ([d (syn->datum (car (lst-kids cl)))]
                                               [c (cond [(and (pair? d) (symbol? (car d))) (ctor-by-source (car d))]
                                                        [(symbol? d) (ctor-by-source d)]
                                                        [else #f])])
                                          (if c (ctor-owner (hash-ref (ctors) c)) (if (symbol? d) 'any 'other)))))
                                 (cdr (cdr (lst-kids m))))]
             [types (dedupe-by (lambda (t) t) (filter (lambda (t) (not (eq? t 'any))) owners))])
        (when (and (eq? (length types) 1) (not (eq? (car types) 'other)))
          (let* ([t (car types)]
                 [params (hash-ref (adts) t)]
                 [tname (if (null? params)
                            (symbol->string (nm t))
                            (str-cat "(" (symbol->string (nm t)) (string-concat (map (lambda (p) " _") params)) ")"))]
                 [binder (param-binder-node path (second sp))])
            (when binder
              (emit-assist "annotate-param"
                           (str-cat "Annotate " (symbol->string (third sp)) " : " tname " (its patterns are " tname "'s)")
                           "type"
                           (list (edit (syn-start binder) (syn-end binder)
                                       (str-cat "[" (symbol->string (third sp)) " : " tname "]")))))))))))

;; the atom of the enclosing define's i-th formal
(define (param-binder-node path i)
  (let* ([top (top-of path)]
         [kids (lst-kids top)])
    (and (pair? (cdr kids)) (lst? (car (cdr kids)))
         (let ([formals (cdr (lst-kids (car (cdr kids))))])
           (and (< i (length formals)) (atom? (list-ref formals i)) (list-ref formals i))))))

;; ---- the assists operation --------------------------------------------------------

;; a cursor just past a closer belongs, for assists, to the form it
;; closes when it is not in a match of its own: `(match e)|`
(define (assist-path pos)
  (let ([path (syn-path-at entry-nodes pos)])
    (if (and (> pos 0)
             (not (findf (lambda (n) (eq? (head-sym n) 'match)) path))
             (member (string-byte entry-text (- pos 1)) '(41 93)))
        (syn-path-at entry-nodes (- pos 1))
        path)))

(define (op-assists pos end load-entry assemble)
  (let* ([path (assist-path pos)]
         [fo (load-entry entry-path)]
         [prog (assemble (first fo) (second fo))]
         [forms (match prog [`(program ,fs ...) fs])])
    (set! adt-tables (collect-adts forms))
    ;; a selection [pos, end): extract it
    (when (and end (< pos end)) (extract-assist pos end))
    (when (pair? path)
      (let* ([top (top-of path)]
             [on-hole (and (atom? (car path)) (eq? (atom-datum (car path)) '??))]
             ;; at a hole, the hole is the question: no match assists
             [m (and (not on-hole) (findf (lambda (n) (eq? (head-sym n) 'match)) path))]
             [cl (and m (findf (lambda (n) (memq-node n (cdr (cdr (lst-kids m))))) path))])
        (when (eq? (head-sym top) 'define-type)
          (template-assist top)
          (traversal-assist top))
        (if on-hole
            (hole-assists path load-entry assemble)
            (begin (stub-assist path forms)
                   (did-you-mean-assist path forms)))
        ;; observed shapes need no checker run, so they come first
        (when (and m (pair? (cdr (lst-kids m))))
          (observed-match-assist m path)
          (call-site-match-assist m path)
          (promote-assist m path forms)
          (annotate-param-assist m path))
        (when (and (not on-hole) (eq? (head-sym top) 'define)) (annotate-assist top))
        (when (and m (pair? (cdr (lst-kids m))))
          (let ([scrut (car (cdr (lst-kids m)))])
            (run-probe (syn-start scrut) (syn-end scrut)
                       (lambda (t env)
                         (if (adt-of t)
                             (begin (match-assists m path t)
                                    (when cl (case-split-assist m cl path t)))
                             (pattern-assists m)))
                       load-entry assemble)))))
    (println (json-obj (list (cons "done" "true"))))))

;; ---- facts: what the layers know at a position ------------------------------------

;; the parameter a position names, as (fn index param): the binder
;; in a define's formals, or a reference to it in the body
(define (param-at path)
  (let* ([n (and (pair? path) (car path))]
         [x (and n (atom? n) (symbol? (atom-datum n)) (atom-datum n))]
         [fn (and x (enclosing-function path))]
         [i (and fn (index-of (cdr fn) x))])
    (and i (list fn i x))))

(define (observed-json path)
  (let* ([pa (param-at path)]
         [obs (and pa (observed-of (car (first pa))))])
    (if (and obs (< (second pa) (length (cdr obs))))
        (let* ([fn (first pa)] [i (second pa)] [x (third pa)]
               [shapes (list-ref (cdr obs) i)]
               [avoid (map symbol->string (cons x (cdr fn)))])
          (json-obj (list (cons "function" (json-str (symbol->string (car fn))))
                          (cons "param" (json-str (symbol->string x)))
                          (cons "index" (json-int i))
                          (cons "calls" (json-int (car obs)))
                          (cons "shapes" (json-list (map (lambda (s) (json-str (value->string s))) shapes)))
                          (cons "patterns" (json-list (filter-map (lambda (s)
                                                                     (let ([p (shape-pattern s avoid)])
                                                                       (and p (json-str p))))
                                                                   shapes))))))
        "null")))

(define (op-facts pos load-entry assemble)
  (let* ([path (syn-path-at entry-nodes pos)]
         [fo (load-entry entry-path)]
         [prog (assemble (first fo) (second fo))]
         [forms (match prog [`(program ,fs ...) fs])])
    (set! adt-tables (collect-adts forms))
    (let ([obs (observed-json path)])
      (cond
        [(and (pair? path) (atom? (car path)) (eq? (atom-datum (car path)) '??))
         ;; a hole: its goal
         (hole-goal path
                    (lambda (goal env)
                      (println (json-obj (list (cons "type" (json-str "_"))
                                               (cons "goal" (json-str (render-type goal)))
                                               (cons "observed" obs)))))
                    load-entry assemble)]
        [(or (null? path) (binder-position? path))
         (println (json-obj (list (cons "type" (let ([t (declared-binder-type path)])
                                                 (if t (json-str t) "null")))
                                  (cons "observed" obs))))]
        [else
          (let* ([n (car path)]
                 [fired (run-probe (syn-start n) (syn-end n)
                                   (lambda (t env)
                                     (println (json-obj (list (cons "type" (json-str (render-type t)))
                                                              (cons "observed" obs)))))
                                   load-entry assemble)])
            (unless fired (println (json-obj (list (cons "type" "null") (cons "observed" obs))))))]))))

;; ---- lint: facts that warrant a marker ----------------------------------------------

;; a clause that matches anything: _ or a plain binder
(define (catch-all-clause? cl)
  (and (lst? cl) (pair? (lst-kids cl))
       (let ([d (syn->datum (car (lst-kids cl)))])
         (and (symbol? d) (not (ctor-by-source d))))))

;; every match on a parameter, with no catch-all clause, whose
;; parameter the session saw take a shape no clause handles: a
;; match-failure waiting to happen. One JSON object per line.
(define (op-lint load-entry assemble)
  (let* ([fo (load-entry entry-path)]
         [prog (assemble (first fo) (second fo))]
         [forms (match prog [`(program ,fs ...) fs])])
    (set! adt-tables (collect-adts forms))
    (lint-with (observed-of-in observed-record) "observed" " was seen as " " in this session")
    (lint-with (observed-of-in (call-site-record)) "call-site" " is passed " " at a call site in this file")
    (println (json-obj (list (cons "done" "true"))))))

(define (lint-with lookup source verb where)
  (begin
    (for-each-node
     (lambda (top)
       (for-each-node
        (lambda (m)
          (let* ([path (list m top)]
                 [sp (and (pair? (cdr (lst-kids m))) (scrutinee-param m path))]
                 [obs (and sp (lookup (car (first sp))))])
            (when (and obs (< (second sp) (length (cdr obs)))
                       (not (ormap catch-all-clause? (cdr (cdr (lst-kids m))))))
              (let* ([have (clause-keys m)]
                     [missed (dedupe-by shape-key
                                        (filter (lambda (s) (let ([k (shape-key s)]) (and k (not (member k have)))))
                                                (list-ref (cdr obs) (second sp))))])
                (when (pair? missed)
                  (println
                   (json-obj
                    (list (cons "start" (json-int (syn-start m)))
                          (cons "end" (json-int (syn-end m)))
                          (cons "line" (json-int (line-of (syn-start m))))
                          (cons "source" (json-str source))
                          (cons "message"
                                (json-str (str-cat (symbol->string (third sp)) verb
                                                   (string-join (map shape-label missed) ", ")
                                                   where ", and no clause matches it")))))))))))
        (matches-in top)))
     entry-nodes)))

(define (for-each-node f ns)
  (when (pair? ns) (f (car ns)) (for-each-node f (cdr ns))))

;; ---- scope resolution and rename ------------------------------------------------------

;; resolve-names walks the entry's syntax and ties every name
;; occurrence to its binder: a binder atom binds itself, a reference
;; points at the binder in scope, and a name nothing in the file
;; binds is (free NAME). Quoted data, case datums, and annotation
;; types are not names. Result: ((atom . binder) ...) in source order.
(define resolve-acc '())

(define (resolve-names)
  (set! resolve-acc '())
  (let* ([tops (append-map top-binders entry-nodes)]
         [env (map (lambda (a) (cons (atom-datum a) a)) tops)])
    (for-each-node (lambda (a) (occ! a a)) tops)
    (for-each-node (lambda (n) (walk-top n env)) entry-nodes))
  (sort resolve-acc (lambda (p q) (< (syn-start (car p)) (syn-start (car q))))))

(define (occ! a binder) (set! resolve-acc (cons (cons a binder) resolve-acc)))

;; the name atoms a top-level form binds: a define's name, a
;; define-type's constructors
(define (top-binders n)
  (let ([kids (if (lst? n) (lst-kids n) '())])
    (cond
      [(and (eq? (head-sym n) 'define) (pair? (cdr kids)))
       (let ([h (car (cdr kids))])
         (cond [(and (atom? h) (symbol? (atom-datum h))) (list h)]
               [(and (lst? h) (pair? (lst-kids h)) (atom? (car (lst-kids h)))) (list (car (lst-kids h)))]
               [else '()]))]
      [(eq? (head-sym n) 'define-type)
       (filter-map (lambda (c) (cond [(and (lst? c) (pair? (lst-kids c)) (atom? (car (lst-kids c))))
                                      (car (lst-kids c))]
                                     [else #f]))
                   (cdr (cdr kids)))]
      [else '()])))

(define (name-atom? n)
  (and (atom? n) (symbol? (atom-datum n))
       (let ([s (symbol->string (atom-datum n))])
         (not (or (eq? (string-byte s 0) 35)          ;; #:kw, #%internal
                  (member (atom-datum n) '(... _ :)))))))

(define (ref! a env)
  (when (name-atom? a)
    (let ([hit (assoc (atom-datum a) env)])
      (occ! a (if hit (cdr hit) (list 'free (atom-datum a)))))))

(define (bind a env)   ;; a binder atom: record it, extend env
  (if (name-atom? a)
      (begin (occ! a a) (cons (cons (atom-datum a) a) env))
      env))

(define (walk-top n env)
  (let ([h (head-sym n)] [kids (if (lst? n) (lst-kids n) '())])
    (cond
      [(eq? h 'define) (walk-define-rest n env)]
      [(member h '(define-type require define-foreign-type foreign)) (void)]
      [(eq? h ':) (when (pair? (cdr kids)) (ref! (car (cdr kids)) env))]
      [(eq? h 'provide) (for-each-node (lambda (k) (when (atom? k) (ref! k env))) (cdr kids))]
      [else (walk-expr n env)])))

;; formals: a list of names or [x : T], a dotted tail, or one name
(define (bind-formals f env)
  (cond
    [(atom? f) (bind f env)]
    [(lst? f)
     (let ([env (foldl (lambda (k env)
                         (if (and (lst? k) (pair? (lst-kids k)))
                             (bind (car (lst-kids k)) env)
                             (bind k env)))
                       env (lst-kids f))])
       (if (lst-tail f) (bind (lst-tail f) env) env))]   ;; (a b . rest)
    [else env]))

(define (walk-define-rest n env)
  (let ([kids (lst-kids n)])
    (when (pair? (cdr kids))
      (let ([h (car (cdr kids))] [body (cdr (cdr kids))])
        (if (lst? h)
            ;; (define (f . formals) [: rt] body ...): f is bound by the
            ;; enclosing body (or the top level); the formals here
            (let ([env (bind-formals (list 'lst 0 0 40 (cdr (lst-kids h)) (lst-tail h)) env)])
              (walk-body (strip-result-type body) env))
            (walk-body body env))))))

(define (strip-result-type body)
  (if (and (pair? body) (atom? (car body)) (eq? (atom-datum (car body)) ':) (pair? (cdr body)))
      (cdr (cdr body))
      body))

;; a body: its internal defines scope over all of it (letrec*)
(define (walk-body forms env)
  (let* ([inner (append-map (lambda (f) (if (eq? (head-sym f) 'define) (top-binders f) '())) forms)]
         [env (foldl (lambda (a env) (bind a env)) env inner)])
    (for-each-node (lambda (f) (if (eq? (head-sym f) 'define) (walk-define-rest f env) (walk-expr f env)))
                   forms)))

(define (walk-each ns env) (for-each-node (lambda (n) (walk-expr n env)) ns))

;; a binding [x e] or [x : T e]: (name-atom . init-node)
(define (binding-of b)
  (let ([kids (if (lst? b) (lst-kids b) '())])
    (and (pair? kids) (cons (car kids) (last kids)))))

(define (walk-expr n env)
  (cond
    [(atom? n) (ref! n env)]
    [(eq? (car n) 'sugar)
     (cond [(eq? (fourth n) 'quote) (void)]
           [(eq? (fourth n) 'quasiquote) (walk-template (fifth n) env)]
           [else (walk-expr (fifth n) env)])]
    [else
     (let ([h (head-sym n)] [kids (lst-kids n)])
       (cond
         [(eq? h 'quote) (void)]
         [(eq? h 'define) (walk-define-rest n env)]
         [(member h '(lambda λ))
          (ref! (car kids) env)
          (when (pair? (cdr kids))
            (walk-body (cdr (cdr kids)) (bind-formals (car (cdr kids)) env)))]
         [(and (eq? h 'let) (pair? (cdr kids)) (atom? (car (cdr kids))))
          ;; named let: inits outside, name and variables in the body
          (ref! (car kids) env)
          (let* ([bs (if (and (pair? (cdr (cdr kids))) (lst? (car (cdr (cdr kids)))))
                         (filter-map binding-of (lst-kids (car (cdr (cdr kids))))) '())])
            (for-each-node (lambda (b) (walk-expr (cdr b) env)) bs)
            (walk-body (cdr (cdr (cdr kids)))
                       (foldl (lambda (b env) (bind (car b) env))
                              (bind (car (cdr kids)) env) bs)))]
         [(and (member h '(let let* letrec)) (pair? (cdr kids)) (lst? (car (cdr kids))))
          (ref! (car kids) env)
          (let* ([bs (filter-map binding-of (lst-kids (car (cdr kids))))]
                 [body-env
                  (cond
                    [(eq? h 'let)
                     (for-each-node (lambda (b) (walk-expr (cdr b) env)) bs)
                     (foldl (lambda (b e) (bind (car b) e)) env bs)]
                    [(eq? h 'let*)
                     (foldl (lambda (b e) (walk-expr (cdr b) e) (bind (car b) e)) env bs)]
                    [else
                     (let ([e (foldl (lambda (b e) (bind (car b) e)) env bs)])
                       (for-each-node (lambda (b) (walk-expr (cdr b) e)) bs)
                       e)])])
            (walk-body (cdr (cdr kids)) body-env))]
         [(eq? h 'match)
          (ref! (car kids) env)
          (when (pair? (cdr kids))
            (walk-expr (car (cdr kids)) env)
            (for-each-node
             (lambda (cl)
               (when (and (lst? cl) (pair? (lst-kids cl)))
                 (let ([e (walk-pattern (car (lst-kids cl)) env env)])
                   (walk-body (filter (lambda (k) (not (and (atom? k) (not (name-atom? k))))) (cdr (lst-kids cl)))
                              e))))
             (cdr (cdr kids))))]
         [(eq? h 'case)
          (ref! (car kids) env)
          (when (pair? (cdr kids))
            (walk-expr (car (cdr kids)) env)
            (for-each-node (lambda (cl) (when (and (lst? cl) (pair? (lst-kids cl)))
                                          (walk-each (cdr (lst-kids cl)) env)))
                           (cdr (cdr kids))))]
         [(eq? h 'ann) (ref! (car kids) env) (when (pair? (cdr kids)) (walk-expr (car (cdr kids)) env))]
         [else (walk-each kids env)]))]))

;; a quasiquote template in an expression: only its unquotes are code
(define (walk-template n env)
  (cond
    [(eq? (car n) 'sugar)
     (if (member (fourth n) '(unquote unquote-splicing))
         (walk-expr (fifth n) env)
         (walk-template (fifth n) env))]
    [(lst? n) (for-each-node (lambda (k) (walk-template k env)) (syn-kids n))]
    [else (void)]))

;; a match pattern: binders extend `env`; predicates and constructor
;; heads are references, resolved in `outer`. Returns the clause env.
(define (walk-pattern p env outer)
  (cond
    [(atom? p)
     (cond [(not (name-atom? p)) env]
           [(ctor-name-in? (atom-datum p) outer) (ref! p outer) env]
           [else (bind p env)])]
    [(eq? (car p) 'sugar)
     (cond [(eq? (fourth p) 'quote) env]
           [(eq? (fourth p) 'quasiquote) (walk-qq-pattern (fifth p) env outer)]
           [else env])]
    [else
     (let ([h (head-sym p)] [kids (lst-kids p)])
       (cond
         [(eq? h '?)
          (when (pair? (cdr kids)) (walk-expr (car (cdr kids)) outer))
          (if (pair? (cdr (cdr kids))) (walk-pattern (car (cdr (cdr kids))) env outer) env)]
         [(member h '(list cons vector))
          (foldl (lambda (k e) (walk-pattern k e outer)) env (cdr kids))]
         [(and h (ctor-name-in? h outer))
          (ref! (car kids) outer)
          (foldl (lambda (k e) (walk-pattern k e outer)) env (cdr kids))]
         [else (foldl (lambda (k e) (walk-pattern k e outer)) env kids)]))]))

(define (walk-qq-pattern n env outer)
  (cond
    [(eq? (car n) 'sugar)
     (if (eq? (fourth n) 'unquote)
         (walk-pattern (fifth n) env outer)
         env)]
    [(lst? n) (foldl (lambda (k e) (walk-qq-pattern k e outer)) env (syn-kids n))]
    [else env]))

;; is x a constructor, by the file's own define-types or an import?
(define (ctor-name-in? x env)
  (or (and (ctor-by-source x) #t)
      (let ([hit (assoc x env)])
        (and hit (atom? (cdr hit))
             (ormap (lambda (top) (and (eq? (head-sym top) 'define-type)
                                       (memq-node (cdr hit) (top-binders top))))
                    entry-nodes)))))

(define (valid-name? s)
  (and (> (string-length s) 0)
       (not (string->number s))
       (let loop ([i 0])
         (or (eq? i (string-length s))
             (let ([b (string-byte s i)])
               (and (not (ws-byte? b)) (not (member b '(40 41 91 93 34 59 39 96 44)))
                    (loop (+ i 1))))))
       (not (eq? (string-byte s 0) 35))))

;; occurrences as comparable binder identities: a binder's index in
;; the occurrence list, or (free NAME)
(define (binder-ids occs)
  (map (lambda (o)
         (let ([b (cdr o)])
           (if (atom? b)
               (index-of-node b (map car occs))
               b)))
       occs))

(define (op-rename pos new load-entry assemble)
  (let* ([fo (load-entry entry-path)]
         [prog (assemble (first fo) (second fo))]
         [forms (match prog [`(program ,fs ...) fs])])
    (set! adt-tables (collect-adts forms))
    (let* ([occs (resolve-names)]
           [hit (findf (lambda (o) (and (<= (syn-start (car o)) pos) (< pos (syn-end (car o))))) occs)])
      (cond
        [(not hit) (println (json-obj (list (cons "error" (json-str "the cursor is not on a name")))))]
        [(not (atom? (cdr hit)))
         (println (json-obj (list (cons "error" (json-str (str-cat (symbol->string (atom-datum (car hit)))
                                                                   " is not defined in this file"))))))]
        [(not (valid-name? new))
         (println (json-obj (list (cons "error" (json-str (str-cat new " is not a name")))))) ]
        ;; the top level is one scope that resolution cannot see
        ;; doubled: two defines of one name would both bind it
        [(and (memq-node (cdr hit) (append-map top-binders entry-nodes))
              (ormap (lambda (a) (and (not (eq? a (cdr hit))) (eq? (atom-datum a) (string->symbol new))))
                     (append-map top-binders entry-nodes)))
         (println (json-obj (list (cons "error" (json-str (str-cat new " is already defined at the top level"))))))]
        [else
         (let* ([b (cdr hit)]
                [mine (filter (lambda (o) (eq? (cdr o) b)) occs)]
                [edits (map (lambda (o) (list (syn-start (car o)) (syn-end (car o)))) mine)]
                [before (binder-ids occs)]
                [renamed (map (lambda (o) (eq? (cdr o) b)) occs)]
                [new-text (apply-edits entry-text edits new)])
           ;; resolve again with the new name in place: every occurrence
           ;; must keep its binder, or the rename captured something
           (set! entry-text new-text)
           (set! entry-nodes (read-syntax-from-string new-text))
           (let* ([occs2 (resolve-names)]
                  [after (binder-ids occs2)]
                  [bad (and (eq? (length occs2) (length occs))
                            (findf (lambda (i) (not (equal? (list-ref before i) (list-ref after i))))
                                   (range 0 (length occs))))])
             (if (or bad (not (eq? (length occs2) (length occs))))
                 (println (json-obj (list (cons "error"
                                                (json-str (str-cat "renaming " (symbol->string (atom-datum (car hit)))
                                                                   " to " new " would change what "
                                                                   (if bad (symbol->string (atom-datum (car (list-ref occs2 bad))))
                                                                       "a name")
                                                                   (if bad (str-cat " on line " (number->string (line-of (syn-start (car (list-ref occs2 bad))))))
                                                                       "")
                                                                   " refers to"))))))
                 (println (json-obj (list (cons "edits"
                                                (json-list (map (lambda (e) (edit (first e) (second e) new))
                                                                edits)))))))))]))))

;; text with each [start, end) span replaced by `new` (spans disjoint)
(define (apply-edits text spans new)
  (let loop ([spans (sort spans (lambda (a b) (< (first a) (first b))))] [at 0] [acc '()])
    (if (null? spans)
        (string-concat (reverse (cons (substring text at (string-length text)) acc)))
        (loop (cdr spans) (second (car spans))
              (cons new (cons (substring text at (first (car spans))) acc))))))

;; ---- check ----------------------------------------------------------------------

(define (op-check load-entry assemble)
  (let ([fo (load-entry entry-path)])
    (desugar (assemble (first fo) (second fo)))
    (println (json-obj (list (cons "ok" "true"))))))

;; ---- entry point ------------------------------------------------------------------

(define (run-assist op path args load-entry assemble)
  (load-observed!)
  (set! entry-path path)
  (set! entry-text (read-source path))
  (set! entry-nodes (read-syntax-from-string entry-text))
  (let ([pos (if (pair? args) (string->number (car args)) #f)]
        ;; assists FILE POS END: a selection
        [end (if (and (pair? args) (pair? (cdr args))) (string->number (car (cdr args))) #f)])
    (cond
      [(string=? op "check") (op-check load-entry assemble)]
      [(string=? op "forms") (op-forms)]
      [(and (string=? op "type-at") pos) (op-type-at pos load-entry assemble)]
      [(and (string=? op "assists") pos) (op-assists pos end load-entry assemble)]
      [(and (string=? op "facts") pos) (op-facts pos load-entry assemble)]
      [(string=? op "lint") (op-lint load-entry assemble)]
      [(and (string=? op "rename") pos (pair? (cdr args)))
       (op-rename pos (car (cdr args)) load-entry assemble)]
      [else (error (str-cat "puffincc: unknown --assist operation or missing position: " op))])
    ;; the driver prints a non-void result: an operation's output is
    ;; only what it printed
    (void)))

;; ---- --repl --observe: report arguments to the session's observer ---------------

;; (define (f a b) body ...) -> (define (f a b) (begin (#%observe 'f
;; (list a b)) (let () body ...))): the body keeps its own tail
;; position and internal-define scoping. Variadic and #%-named
;; defines are left alone.
(define (observe-forms forms)
  (map (lambda (f)
         (match f
           [`(define (,g ,ps ...) : ,rt ,body ...)
            #:when (observable? g ps)
            `(define (,g ,@ps) : ,rt ,(observe-body g ps body))]
           [`(define (,g ,ps ...) ,body ...)
            #:when (observable? g ps)
            `(define (,g ,@ps) ,(observe-body g ps body))]
           [_ f]))
       forms))

(define (observable? g ps)
  (and (symbol? g)
       (not (eq? (string-byte (symbol->string g) 0) 35))
       (andmap (lambda (p) (or (symbol? p) (and (list? p) (eq? (length p) 3)))) ps)))

(define (observe-body g ps body)
  `(begin (#%observe (quote ,g) (list ,@(map (lambda (p) (match p [`(,x : ,_) x] [x x])) ps)))
          (let () ,@body)))

;; ---- --repl --trace NAME: print a function's calls and returns ------------------

;; (define (f a b) body ...) ->
;;   (define (f a b)
;;     (#%trace-enter 'f (list a b))
;;     (#%trace-exit 'f (let () body ...)))
;; The body loses its tail position -- a trace shows every return, as
;; Racket's does. The printing lives in the session runtime
;; (studio/observe.puf).
(define (trace-forms names forms)
  (map (lambda (f)
         (match f
           [`(define (,g ,ps ...) : ,rt ,body ...)
            #:when (and (member g names) (observable? g ps))
            `(define (,g ,@ps) : ,rt ,(trace-body g ps body))]
           [`(define (,g ,ps ...) ,body ...)
            #:when (and (member g names) (observable? g ps))
            `(define (,g ,@ps) ,(trace-body g ps body))]
           [_ f]))
       forms))

(define (trace-body g ps body)
  `(begin (#%trace-enter (quote ,g) (list ,@(map (lambda (p) (match p [`(,x : ,_) x] [x x])) ps)))
          (#%trace-exit (quote ,g) (let () ,@body))))
