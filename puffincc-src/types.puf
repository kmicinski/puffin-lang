;; puffincc -- types.puf: the gradual typechecker (docs/TYPES.md),
;; the Puffin port of src/types.rkt.
;;
;; Runs on the module-resolved SURFACE program, invoked at the top of
;; desugar (so every route checks: interp, chain, both backends).
;; Bidirectional with the Siek-Taha consistency relation: `_` (Any) is
;; consistent with everything; consistency is congruent and NOT
;; transitive. Unannotated code is `_`-typed by construction and never
;; errors. v1 is check-then-erase (desugar drops annotations).
;;
;; Dialect notes vs src/types.rkt (Racket):
;;  - no structs: adt registry is two mutable hashes (name->params,
;;    ctor->(list owner params fields)); no multiple values.
;;  - no exceptions: a type error calls the runtime `error` prim,
;;    which aborts the compile with the message on stderr.
;;  - no `(or ...)` match patterns and no `match*`: head symbols are
;;    dispatched with #:when guards; `consistent?` uses cond.
;;  - the literal type `_` is matched with (eq? t '_), never a bare
;;    `_` pattern (that is puffincc's wildcard).
;;
;; Prim types come from the manifest: tables.puf (generated from
;; src/stdlib.rkt) carries each prim's type, so the two checkers
;; consume the SAME single source of truth. The local table below
;; covers only desugar-level non-manifest forms (+ - * eq? < <= > >=
;; not). Exhaustiveness warnings go to stderr via the eprintln prim;
;; strict-exhaustiveness (system.puf; --strict-types) promotes them
;; to errors.

(require "system.puf")   ;; prim?, prim-arity, strict-exhaustiveness
(require "tables.puf")   ;; stdlib-prim?, stdlib-prim-type

;; side-effecting iteration (no for-each in the prelude)
(define (for-each f xs)
  (if (null? xs) (void) (begin (f (car xs)) (for-each f (cdr xs)))))

;; ---- type errors ----------------------------------------------------
;; every type error carries the nearest enclosing top-level form's
;; source position when known (system.puf origin-suffix)
(define (type-error msg)
  (when type-error-hook
    (type-error-hook (string-append "typecheck: " msg) check-focus))
  (error (string-append "typecheck: " (string-append msg (origin-suffix)))))

;; ---- type syntax helpers --------------------------------------------

;; a type variable is a symbol whose first character is lowercase
(define (tyvar? t)
  (and (symbol? t)
       (let ([s (symbol->string t)])
         (and (> (string-length s) 0)
              (let ([b (string-byte s 0)]) (and (>= b 97) (<= b 122)))))))

(define (base-type? s) (if (member s '(Int Bool Sym Str Void _)) #t #f))

;; structural type formers: never user-definable (define-type of one
;; is rejected in collect-adts), never renamed by the module system
(define (type-former-name? s)
  (if (member s '(-> ->* List Vec Hash Set Pairof Mut)) #t #f))

;; ---- diagnostic rendering (mirrors src/types.rkt nm/ty) -------------
;; names and types in error/warning messages go through the module
;; demangling table (system.puf), so a message shows the SOURCE
;; spelling (Shape), never the module-mangled one
;; (Shape_shapes_826109a6). Rendering only -- every comparison in this
;; file uses the mangled spellings, which ARE the type identities.

(define (nm x) (if (symbol? x) (module-demangle x) x))
(define (ty t)
  (cond [(sexp-type? t) (string->symbol (render-sexp-type (car (cdr t))))]
        [(symbol? t) (module-demangle t)]
        [(pair? t) (cons (ty (car t)) (ty (cdr t)))]
        [else t]))

;; ---- type aliases (docs/TYPES.md §3) --------------------------------
;; (define-type-alias Name τ) and (define-type-alias (Name a ...) τ):
;; Name abbreviates τ, transparently. Aliases are unfolded before
;; anything else reads a type, so the checker, desugar's casts and the
;; backends only ever see what they abbreviate; the form itself stays
;; in the program (the walkers ignore it) and desugar drops it.
;; aliases: mutable hash  name -> (params . body)

(define (alias-head-np head f)
  (match head
    [`(,n ,ps ...) #:when (and (symbol? n) (andmap symbol? ps)) (cons n ps)]
    [(? symbol? n) (cons n '())]
    [_ (type-error (format "malformed define-type-alias: ~a" (ty f)))]))

(define (collect-aliases forms)
  (define aliases (make-hash))
  ;; the heads of the ADTs and foreign types, to refuse a name used both ways
  (define type-heads (make-set))
  (for-each-form
   (lambda (f)
     (match f
       [`(define-type ,head ,_ ...)
        (set-add! type-heads (match head [`(,n ,_ ...) n] [n n]))]
       [`(define-grammar ,head ,_ ...)
        (set-add! type-heads (match head [`(,n ,_ ...) n] [n n]))]
       [`(#%extern-type ,head ,_ ...)
        (set-add! type-heads (match head [`(,n ,_ ...) n] [n n]))]
       [`(,h ,n) #:when (or (eq? h 'define-foreign-type) (eq? h '#%extern-foreign-type))
        (set-add! type-heads n)]
       [_ (void)]))
   forms)
  (for-each-form
   (lambda (f)
     (match f
       [`(define-type-alias ,head ,body)
        (let* ([np (alias-head-np head f)] [n (car np)])
          (when (or (base-type? n) (type-former-name? n))
            (type-error (format "define-type-alias cannot redefine built-in type ~a" n)))
          (when (tyvar? n)
            (type-error (format "define-type-alias ~a: a type name is capitalized (a lowercase name is a type variable)" n)))
          (when (or (set-member? type-heads n) (hash-has-key? aliases n))
            (type-error (format "type ~a defined twice" (nm n))))
          (hash-set! aliases n (cons (cdr np) body)))]
       [`(define-type-alias ,_ ...)
        (type-error (format "malformed define-type-alias: ~a" (ty f)))]
       [_ (void)]))
   forms)
  aliases)

(define (subst-type t env)
  (cond [(symbol? t) (let ([hit (assoc t env)]) (if hit (cdr hit) t))]
        [(pair? t) (cons (subst-type (car t) env) (subst-type (cdr t) env))]
        [else t]))

;; τ with every alias unfolded; `seen` holds the aliases being
;; unfolded, so a cycle is an error rather than a loop
(define (expand-alias-type t aliases) (expand-alias-type* t aliases '()))
(define (expand-alias-type* t aliases seen)
  (define (unfold n args)
    (let* ([a (hash-ref aliases n)] [ps (car a)] [body (cdr a)])
      (when (member n seen)
        (type-error (format "type alias ~a is recursive" (nm n))))
      (unless (eq? (length ps) (length args))
        (type-error (format "type alias ~a expects ~a parameters, got ~a"
                            (nm n) (length ps) (length args))))
      (expand-alias-type* (subst-type body (map2 (lambda (p a) (cons p a)) ps args))
                          aliases (cons n seen))))
  (define (expand s) (expand-alias-type* s aliases seen))
  (match t
    [(? symbol? s) (if (hash-has-key? aliases s) (unfold s '()) s)]
    ;; the fixed-argument list of a ->* is a list of types, not an application
    [`(->* (,ts ...) ,tr ,tres) (list '->* (map expand ts) (expand tr) (expand tres))]
    [`(,h ,args ...) #:when (and (symbol? h) (hash-has-key? aliases h))
     (unfold h (map expand args))]
    ;; any other list: its elements are types (never its tails, which
    ;; would read (-> Env Int)'s (Env Int) as an application)
    [(? list? l) (map expand l)]
    [(cons a d) (cons (expand a) (expand d))]
    [_ t]))

;; the program with every type position unfolded: [x : τ] formals and
;; bindings, the `: τ` result of a define or lambda, (: n τ),
;; (#%prelude: n τ), (ann e τ), define-type and #%extern-type fields,
;; and foreign declarations (: n τ). Quoted data is left alone, a
;; template is entered only through its escapes, and the alias forms
;; themselves stay (checked for well-formedness in typecheck-program).
(define (expand-type-aliases forms aliases)
  (define (tyx t) (expand-alias-type t aliases))
  (define (walk-ctor c)
    (match c [`(,cn ,fts ...) (cons cn (map tyx fts))] [_ c]))
  ;; a production: its type leaves unfold, its literals (quoted data,
  ;; and the symbols no alias names) stay
  (define (walk-prod q)
    (match q
      [(? symbol? s) (if (hash-has-key? aliases s) (tyx s) s)]
      [(list 'quote _) q]
      [`(,h ,_ ...) #:when (and (symbol? h) (or (type-former-name? h) (hash-has-key? aliases h)))
       (tyx q)]
      [(cons a d) (cons (walk-prod a) (walk-prod d))]
      [_ q]))
  (define (walk-grammar rest)
    (if (and (pair? rest) (eq? (car rest) kw-keywords) (pair? (cdr rest)))
        (cons (car rest) (cons (car (cdr rest)) (map walk-prod (cdr (cdr rest)))))
        (map walk-prod rest)))
  (define (walk-template q depth)
    (match q
      [(list 'unquote x)
       (list 'unquote (if (eq? depth 1) (walk x) (walk-template x (- depth 1))))]
      [(list 'unquote-splicing x)
       (list 'unquote-splicing (if (eq? depth 1) (walk x) (walk-template x (- depth 1))))]
      [(list 'quasiquote x) (list 'quasiquote (walk-template x (+ depth 1)))]
      [(cons a d) (cons (walk-template a depth) (walk-template d depth))]
      [_ q]))
  (define (walk e)
    (match e
      [`(quote ,_) e]
      [`(quasiquote ,q) (list 'quasiquote (walk-template q 1))]
      [`(define-type-alias ,_ ,_) e]
      [`(define-type ,head ,cs ...) (cons 'define-type (cons head (map walk-ctor cs)))]
      [`(define-grammar ,head . ,rest) (cons 'define-grammar (cons head (walk-grammar rest)))]
      [`(#%extern-type ,head ,cs ...) (cons '#%extern-type (cons head (map walk-ctor cs)))]
      [`(: ,n ,t) (list ': n (tyx t))]
      [`(#%prelude: ,n ,t) (list '#%prelude: n (tyx t))]
      [`(ann ,x ,t) (list 'ann (walk x) (tyx t))]
      ;; [x : τ] and [x : τ e]
      [`(,x : ,t . ,rest) #:when (symbol? x) (cons x (cons ': (cons (tyx t) (walk rest))))]
      ;; (define (f ...) : τ body ...), (lambda (...) : τ body ...)
      [`(,h ,formals : ,t . ,body) #:when (member h '(define lambda λ))
       (cons h (cons (walk formals) (cons ': (cons (tyx t) (walk body)))))]
      [(cons a d) (cons (walk a) (walk d))]
      [_ e]))
  (if (eq? (hash-count aliases) 0)
      forms
      (map-form walk forms)))

;; ---- the ADT registry -----------------------------------------------
;; adts:  mutable hash  name -> params-list
;; ctors: mutable hash  ctor -> (list owner params fields)

(define (ctor-owner ci) (first ci))
(define (ctor-params ci) (second ci))
(define (ctor-fields ci) (third ci))

;; collected in two passes (heads, then bodies): all of a module's
;; types are mutually recursive. Returns (list adts ctors ctor-orders),
;; where ctor-orders maps a type name to its constructor names in
;; declaration order (exhaustiveness reports depend on that order).
(define (collect-adts forms0)
  ;; constructor fields may name type aliases: unfold them first
  (define forms (expand-type-aliases forms0 (collect-aliases forms0)))
  (define adts (make-hash))
  (define ctors (make-hash))
  (define ctor-orders (make-hash))
  ;; pass 0: define-foreign-type heads (docs/FFI.md §6) -- opaque
  ;; nullary types. They enter `adts` (annotations resolve; zero
  ;; constructors, so exhaustiveness never fires) AND the
  ;; foreign-type set (the FFI's handle-marshaling test).
  ;; #%extern-foreign-type is the separate-compilation splice.
  (define ftypes (make-set))
  (for-each-form
   (lambda (f)
     (match f
       [`(,head ,rest ...)
        #:when (or (eq? head 'define-foreign-type) (eq? head '#%extern-foreign-type))
        (begin
          (unless (and (pair? rest) (symbol? (car rest)) (null? (cdr rest)))
            (type-error (format "malformed define-foreign-type: ~a" f)))
          (let ([n (car rest)])
            (begin
              (when (or (base-type? n) (type-former-name? n))
                (type-error (format "define-foreign-type cannot redefine built-in type ~a" n)))
              (when (hash-has-key? adts n)
                (type-error (format "type ~a defined twice" (nm n))))
              (hash-set! adts n '())
              (set-add! ftypes n))))]
       [_ (void)]))
   forms)
  ;; pass 1: heads (define-type and define-grammar alike)
  (for-each-form
   (lambda (f)
     (match f
       [`(,dt ,head ,_ ...) #:when (or (eq? dt 'define-type) (eq? dt 'define-grammar))
        (let ([np (match head
                    [`(,n ,ps ...) (cons n ps)]
                    [n (cons n '())])])
          (let ([n (car np)] [ps (cdr np)])
            (when (or (base-type? n) (type-former-name? n))
              (type-error (format "~a cannot redefine built-in type ~a" dt n)))
            (when (hash-has-key? adts n)
              (type-error (format "type ~a defined twice" (nm n))))
            (hash-set! adts n ps)))]
       [_ (void)]))
   forms)
  ;; pass 2: constructor signatures
  (for-each-form
   (lambda (f)
     (match f
       [`(define-type ,head ,cs ...)
        (let ([n (match head [`(,n ,_ ...) n] [n n])])
          (let ([ps (hash-ref adts n)])
            ;; every constructor is (Name field-type ...): a bare Name is the
            ;; mistake the reference syntax (None, not (None)) invites
            (for-each
             (lambda (c)
               (match c
                 [`(,cn ,_ ...) #:when (symbol? cn) (void)]
                 [(? symbol? s)
                  (type-error (format "define-type ~a: constructor ~a is declared (~a), referenced bare"
                                      (nm n) (nm s) (nm s)))]
                 [_ (type-error (format "define-type ~a: malformed constructor, expected (Name field-type ...)"
                                        (nm n)))]))
             cs)
            (hash-set! ctor-orders n (map (lambda (c) (car c)) cs))
            (for-each
             (lambda (c)
               (match c
                 [`(,cn ,fts ...)
                  (when (hash-has-key? ctors cn)
                    (type-error (format "constructor ~a defined twice" (nm cn))))
                  (for-each (lambda (ft) (check-type-wf ft ps adts)) fts)
                  (hash-set! ctors cn (list n ps fts))]))
             cs)))]
       [_ (void)]))
   forms)
  ;; pass 3: the grammar table -- every define-type and define-grammar
  ;; as its productions (docs/GRAMMARS.md)
  (set! grammar-table (make-hash))
  (for-each-form
   (lambda (f)
     (match f
       [`(define-type ,head ,cs ...)
        (let ([n (match head [`(,n ,_ ...) n] [n n])])
          (hash-set! grammar-table n
                     (list (hash-ref adts n) '() (map ctor->shape cs) 'type (map car cs))))]
       [`(define-grammar ,head . ,rest)
        (let* ([n (match head [`(,n ,_ ...) n] [n n])]
               [ps (hash-ref adts n)]
               [kp (grammar-parts n rest)])
          (when (null? (cdr kp))
            (type-error (format "define-grammar ~a: expected at least one production" (nm n))))
          (hash-set! grammar-table n
                     (list ps (car kp)
                           (map (lambda (q) (prod->shape q n ps (car kp) adts)) (cdr kp))
                           'grammar '())))]
       [_ (void)]))
   forms)
  (list adts ctors ctor-orders ftypes))

;; ---- grammar types (docs/GRAMMARS.md) -------------------------------
;; A grammar is a union of productions over plain s-expressions, and a
;; define-type is one too (literal head symbols, plus constructor
;; functions). Productions, quoted data and templates are all
;; normalized to SHAPES:
;;   (#%lit d)             the literal atom d (symbol, fixnum, string,
;;                         boolean); () is (#%list)
;;   (#%list e ...)        a proper list; at most one element is
;;                         (#%star s): zero or more s
;;   (#%sym-except k ...)  a Sym leaf of a grammar with #:keywords
;;   any type τ            a leaf: every value of τ
;; The type of a quoted datum or a template is (#%sexp s). Mirrors
;; src/types.rkt.

;; name -> (list params keywords prods kind ctors): kind is 'type for a
;; define-type (ctors: its constructor names, one per production) or
;; 'grammar. Set by collect-adts for the program being checked.
(define grammar-table (make-hash))

(define (g-params gi) (first gi))
(define (g-prods gi) (third gi))
(define (g-kind gi) (car (cdr (cdr (cdr gi)))))
(define (g-ctors gi) (car (cdr (cdr (cdr (cdr gi))))))

(define (lit? s) (and (pair? s) (eq? (car s) '#%lit)))
(define (slist? s) (and (pair? s) (eq? (car s) '#%list)))
(define (star? s) (and (pair? s) (eq? (car s) '#%star)))
(define (sym-except? s) (and (pair? s) (eq? (car s) '#%sym-except)))
(define (sexp-type? t) (and (pair? t) (eq? (car t) '#%sexp)))
(define (unstar e) (if (star? e) (car (cdr e)) e))

;; the grammar a type names, or #f
;; An abstract type (docs/MODULES.md "Opaque types") is no grammar to
;; the form being checked: its productions -- its constructors -- are
;; private to the module that owns it, so to everyone else it is a
;; bare name. The main check loop sets abstract-here per form.
(define abstract-here '())
;; the module whose form is being checked (#f: the entry), for the
;; unbound-name message
(define current-module #f)
(define (gram-name t)
  (let ([n (cond [(symbol? t) t]
                 [(and (pair? t) (symbol? (car t))) (car t)]
                 [else #f])])
    (if (and n (hash-has-key? grammar-table n) (not (member n abstract-here))) n #f)))
;; the abstract type t names here, or #f
(define (abstract-name t)
  (let ([n (if (pair? t) (car t) t)])
    (if (member n abstract-here) n #f)))
(define (sexpy? t) (or (sexp-type? t) (if (gram-name t) #t #f)))

;; substitution into a shape: literals are data, never parameters
(define (subst-shape s env)
  (cond [(lit? s) s]
        [(sym-except? s) s]
        [(slist? s) (cons '#%list (map (lambda (e) (subst-shape e env)) (cdr s)))]
        [(star? s) (list '#%star (subst-shape (car (cdr s)) env))]
        [else (subst-type s env)]))

;; a grammar type's productions, its parameters instantiated (a missing
;; argument is _)
(define (gram-prods t)
  (let* ([gi (hash-ref grammar-table (gram-name t))]
         [ps (g-params gi)]
         [args (if (pair? t) (cdr t) '())])
    (if (null? ps)
        (g-prods gi)
        (let ([env (let loop ([ps ps] [as args] [acc '()])
                     (if (null? ps)
                         acc
                         (loop (cdr ps) (if (pair? as) (cdr as) '())
                               (cons (cons (car ps) (if (pair? as) (car as) '_)) acc))))])
          (map (lambda (p) (subst-shape p env)) (g-prods gi))))))

;; a quoted datum as a shape, or #f for an improper list
(define (datum->shape d)
  (cond [(null? d) (list '#%list)]
        [(pair? d)
         (if (list? d)
             (let ([es (map datum->shape d)])
               (if (andmap (lambda (e) (if e #t #f)) es) (cons '#%list es) #f))
             #f)]
        [else (list '#%lit d)]))

(define (capitalized? s)
  (let ([str (symbol->string s)])
    (and (> (string-length str) 0)
         (let ([b (string-byte str 0)]) (and (>= b 65) (<= b 90))))))

;; (define-grammar head [#:keywords (k ...)] prod ...): the keywords
;; and the productions
(define kw-keywords (string->symbol "#:keywords"))
(define (grammar-parts gname rest)
  (if (and (pair? rest) (eq? (car rest) kw-keywords))
      (if (and (pair? (cdr rest)) (list? (car (cdr rest))) (andmap symbol? (car (cdr rest))))
          (cons (car (cdr rest)) (cdr (cdr rest)))
          (type-error (format "define-grammar ~a: #:keywords takes a list of symbols" (nm gname))))
      (cons '() rest)))

;; a production as written -> its shape
(define (prod->shape p gname params kws adts)
  (define (type-sym? s)
    (or (base-type? s) (if (member s params) #t #f) (hash-has-key? adts s)))
  (define (conv p)
    (match p
      [(? symbol? s)
       (cond [(type-sym? s)
              (begin (check-type-wf s params adts)
                     (if (and (eq? s 'Sym) (pair? kws)) (cons '#%sym-except kws) s))]
             [(eq? s '...) (type-error (format "define-grammar ~a: ... must follow an element" (nm gname)))]
             [(capitalized? s)
              (type-error (format "define-grammar ~a: unknown type ~a (quote it for the literal symbol)"
                                  (nm gname) (nm s)))]
             [else (list '#%lit s)])]
      [(list 'quote d)
       (let ([s (datum->shape d)])
         (if s s (type-error (format "define-grammar ~a: dotted productions are not supported" (nm gname)))))]
      [(cons h _)
       #:when (and (symbol? h)
                   (or (type-former-name? h)
                       (and (hash-has-key? adts h) (pair? (hash-ref adts h)))))
       (begin (check-type-wf p params adts) p)]
      [(? list? l) (cons '#%list (conv-elems l))]
      [(? pair? _) (type-error (format "define-grammar ~a: dotted productions are not supported" (nm gname)))]
      [_ (list '#%lit p)]))
  (define (conv-elems l)
    (let loop ([l l] [acc '()] [stars 0])
      (cond
        [(null? l) (reverse acc)]
        [(eq? (car l) '...)
         (type-error (format "define-grammar ~a: ... must follow an element" (nm gname)))]
        [(and (pair? (cdr l)) (eq? (car (cdr l)) '...))
         (begin
           (when (> stars 0)
             (type-error (format "define-grammar ~a: at most one ... per list" (nm gname))))
           (loop (cdr (cdr l)) (cons (list '#%star (conv (car l))) acc) (+ stars 1)))]
        [else (loop (cdr l) (cons (conv (car l)) acc) stars)])))
  (conv p))

;; a define-type constructor (Cn ft ...) as a production: its head is
;; the constructor's SOURCE spelling (what the constructor builds)
(define (ctor->shape c)
  (match c
    [`(,cn) (list '#%lit (module-demangle cn))]
    [`(,cn ,fts ...) (cons '#%list (cons (list '#%lit (module-demangle cn)) fts))]))

;; ---- inclusion: every value of a is a value of b --------------------
;; `_` and type variables include and are included by everything (the
;; gradual reading). Grammar pairs are assumed included while their
;; productions are compared (coinduction); a non-grammar revisiting a
;; grammar it is already being compared against fails (left recursion).
(define (sx-sub? a b) (sub* a b '()))

(define (sub* a b as)
  (cond
    [(equal? a b) #t]
    [(or (eq? a '_) (eq? b '_) (tyvar? a) (tyvar? b)) #t]
    [(sexp-type? a) (sub* (car (cdr a)) b as)]
    [(sexp-type? b) (sub* a (car (cdr b)) as)]
    [(gram-name a)
     (or (if (member (cons a b) as) #t #f)
         (let ([as+ (cons (cons a b) as)])
           (andmap (lambda (p) (sub* p b as+)) (gram-prods a))))]
    [(gram-name b)
     (if (member (cons a b) as)
         #f
         (let ([as+ (cons (cons a b) as)])
           (ormap (lambda (q) (sub* a q as+)) (gram-prods b))))]
    [(lit? a) (lit-in? (car (cdr a)) b)]
    [(sym-except? a)
     (cond [(eq? b 'Sym) #t]
           [(sym-except? b) (andmap (lambda (k) (if (member k (cdr a)) #t #f)) (cdr b))]
           [else #f])]
    [(slist? a) (list-in? (cdr a) b as)]
    ;; a is an ordinary type
    [(or (lit? b) (sym-except? b)) #f]
    [(slist? b) (type-in-list? a (cdr b) as)]
    [else (consistent? a b)]))

;; a literal atom in a shape or type
(define (lit-in? d b)
  (cond [(lit? b) (equal? d (car (cdr b)))]
        [(sym-except? b) (and (symbol? d) (not (member d (cdr b))))]
        [(eq? b 'Sym) (symbol? d)]
        [(eq? b 'Int) (fixnum? d)]
        [(eq? b 'Str) (string? d)]
        [(eq? b 'Bool) (boolean? d)]
        [(eq? b '_) #t]
        [else #f]))

;; a list shape's elements es in b
(define (list-in? es b as)
  (cond
    [(slist? b) (elems-in? es (cdr b) as)]
    [(and (pair? b) (eq? (car b) 'List))
     (andmap (lambda (e) (sub* (unstar e) (car (cdr b)) as)) es)]
    [(and (pair? b) (eq? (car b) 'Pairof))
     (and (pair? es) (not (star? (car es)))
          (sub* (car es) (car (cdr b)) as)
          (sub* (cons '#%list (cdr es)) (car (cdr (cdr b))) as))]
    [else #f]))

;; an ordinary (List τ) / (Pairof x y) type in a list shape
(define (type-in-list? a fs as)
  (match a
    [`(List ,t)
     (match fs
       [`((#%star ,s)) (sub* t s as)]
       [_ #f])]
    [`(Pairof ,x ,y)
     (match fs
       [`((#%star ,s)) (and (sub* x s as) (sub* y (cons '#%list fs) as))]
       [(cons f rest) (and (not (star? f)) (sub* x f as) (sub* y (cons '#%list rest) as))]
       [_ #f])]
    [_ #f]))

;; elements split at their star: (list prefix star-or-#f suffix)
(define (split-star es)
  (let loop ([es es] [pre '()])
    (cond [(null? es) (list (reverse pre) #f '())]
          [(star? (car es)) (list (reverse pre) (car (cdr (car es))) (cdr es))]
          [else (loop (cdr es) (cons (car es) pre))])))

(define (pairwise-sub? xs ys as)
  (cond [(and (null? xs) (null? ys)) #t]
        [(or (null? xs) (null? ys)) #f]
        [(sub* (car xs) (car ys) as) (pairwise-sub? (cdr xs) (cdr ys) as)]
        [else #f]))

(define (elems-in? es fs as)
  (let* ([e3 (split-star es)] [f3 (split-star fs)]
         [pe (first e3)] [se (second e3)] [qe (third e3)]
         [pf (first f3)] [sf (second f3)] [qf (third f3)]
         [lpf (length pf)] [lqf (length qf)])
    (cond
      [(not sf) (and (not se) (pairwise-sub? es fs as))]
      [(not se)
       (let ([n (length es)])
         (and (>= n (+ lpf lqf))
              (pairwise-sub? (take es lpf) pf as)
              (pairwise-sub? (drop es (- n lqf)) qf as)
              (andmap (lambda (e) (sub* e sf as)) (take (drop es lpf) (- n (+ lpf lqf))))))]
      [else
       (and (>= (length pe) lpf) (>= (length qe) lqf)
            (pairwise-sub? (take pe lpf) pf as)
            (pairwise-sub? (drop qe (- (length qe) lqf)) qf as)
            (andmap (lambda (e) (sub* e sf as)) (drop pe lpf))
            (sub* se sf as)
            (andmap (lambda (e) (sub* e sf as)) (take qe (- (length qe) lqf))))])))

;; ---- overlap: a grammar used where an ordinary type is expected -----
;; consistent when some value could be both (car on an Expr); disjoint
;; is the error
(define (sx-overlap? a t) (ovl* a t '()))
(define (ovl* a t vs)
  (cond
    [(or (eq? a '_) (eq? t '_) (tyvar? a) (tyvar? t)) #t]
    [(sexp-type? a) (ovl* (car (cdr a)) t vs)]
    [(gram-name a)
     (if (member a vs)
         #f
         (ormap (lambda (p) (ovl* p t (cons a vs))) (gram-prods a)))]
    [(lit? a) (lit-in? (car (cdr a)) t)]
    [(sym-except? a) (consistent? 'Sym t)]
    [(slist? a)
     (match t
       [`(List ,_) #t]
       [`(Pairof ,_ ,_) (pair? (cdr a))]
       [_ #f])]
    [else (consistent? a t)]))

;; ---- patterns against productions (docs/GRAMMARS.md §5) ------------
;; (list prefix ellipsis-element-or-#f after-ellipsis tail) of a
;; quasiquote pattern list: tail is the pattern of a dotted ,tail, #f,
;; or 'bad
(define (split-qpat q)
  (let loop ([q q] [pre '()])
    (cond
      [(null? q) (list (reverse pre) #f '() #f)]
      [(and (pair? q) (eq? (car q) 'unquote) (pair? (cdr q)) (null? (cdr (cdr q))))
       (list (reverse pre) #f '() (car (cdr q)))]
      [(and (pair? q) (pair? (cdr q)) (eq? (car (cdr q)) '...))
       (list (reverse pre) (car q) (cdr (cdr q)) #f)]
      [(pair? q) (loop (cdr q) (cons (car q) pre))]
      [else (list (reverse pre) #f '() 'bad)])))

;; the base type a type-test establishes
(define (pred-base pred)
  (cond [(member pred '(fixnum? integer?)) 'Int]
        [(eq? pred 'symbol?) 'Sym]
        [(eq? pred 'string?) 'Str]
        [(eq? pred 'boolean?) 'Bool]
        [else #f]))

;; can quasiquote pattern q (depth 1) match some value of shape or type
;; s? The checker's binding alignment (align) succeeds exactly when
;; this does; coverage and the editor's fill-match need only the yes/no
(define (tmpl-overlap? q s vs)
  (cond
    [(and (pair? q) (eq? (car q) 'unquote) (pair? (cdr q)) (null? (cdr (cdr q)))) #t]
    [(sexp-type? s) (tmpl-overlap? q (car (cdr s)) vs)]
    [(gram-name s)
     (if (member s vs)
         #f
         (ormap (lambda (p) (tmpl-overlap? q p (cons s vs))) (gram-prods s)))]
    [(or (eq? s '_) (tyvar? s)) #t]
    [(null? q)
     (cond [(slist? s) (andmap star? (cdr s))]
           [(and (pair? s) (eq? (car s) 'List)) #t]
           [else #f])]
    [(pair? q)
     (cond [(slist? s) (list-overlap? q (cdr s) vs)]
           [(and (pair? s) (eq? (car s) 'List)) (list-overlap? q (list (list '#%star (car (cdr s)))) vs)]
           [(and (pair? s) (eq? (car s) 'Pairof)) #t]
           [else #f])]
    [else (lit-in? q s)]))
(define (all-overlap? ps fs vs)
  (cond [(and (null? ps) (null? fs)) #t]
        [(or (null? ps) (null? fs)) #f]
        [(tmpl-overlap? (car ps) (car fs) vs) (all-overlap? (cdr ps) (cdr fs) vs)]
        [else #f]))
(define (list-overlap? q fs vs)
  (let* ([sp (split-qpat q)]
         [pre (first sp)] [ell (second sp)] [post (third sp)] [tail (car (cdr (cdr (cdr sp))))]
         [f3 (split-star fs)]
         [pf (first f3)] [sf (second f3)] [qf (third f3)]
         [lpre (length pre)] [lpf (length pf)] [lqf (length qf)])
    (cond
      [(eq? tail 'bad) #t]
      [tail
       (cond [(and (not sf) (>= (length fs) lpre)) (all-overlap? pre (take fs lpre) vs)]
             [(and sf (<= lpre lpf)) (all-overlap? pre (take pf lpre) vs)]
             [else #t])]
      [(not ell)
       (cond [(not sf) (and (eq? lpre (length fs)) (all-overlap? pre fs vs))]
             [(>= lpre (+ lpf lqf))
              (and (all-overlap? (take pre lpf) pf vs)
                   (andmap (lambda (p) (tmpl-overlap? p sf vs)) (take (drop pre lpf) (- lpre (+ lpf lqf))))
                   (all-overlap? (drop pre (- lpre lqf)) qf vs))]
             [else #f])]
      [(not (list? post)) #t]
      [(member '... post) #t]
      [else
       (let ([lpost (length post)])
         (cond
           [(not sf)
            (and (<= (+ lpre lpost) (length fs))
                 (all-overlap? pre (take fs lpre) vs)
                 (all-overlap? post (drop fs (- (length fs) lpost)) vs)
                 (andmap (lambda (f) (tmpl-overlap? ell f vs))
                         (take (drop fs lpre) (- (length fs) (+ lpre lpost)))))]
           [else
            (let* ([pre-f (append (take pf (min lpre lpf))
                                  (map (lambda (dummy) sf) (range 0 (max 0 (- lpre lpf)))))]
                   [post-f (append (map (lambda (dummy) sf) (range 0 (max 0 (- lpost lqf))))
                                   (drop qf (max 0 (- lqf lpost))))]
                   [cands (append (drop pf (min lpre lpf))
                                  (cons sf (take qf (max 0 (- lqf lpost)))))])
              (and (all-overlap? pre pre-f vs)
                   (all-overlap? post post-f vs)
                   (ormap (lambda (c) (tmpl-overlap? ell c vs)) cands)))]))])))

;; exhaustiveness coverage: the indices of the productions pattern p
;; can match ('all patterns -- binders, _, cons/list/vector, unknown
;; predicates -- cover every production). ctors: the checker's
;; constructor table (nullary-constructor names and constructor
;; patterns spell their source-named data).
(define (covers-all prods) (range 0 (length prods)))
(define (indices-where ok? prods)
  (let loop ([ps prods] [i 0] [acc '()])
    (if (null? ps)
        (reverse acc)
        (loop (cdr ps) (+ i 1) (if (ok? (car ps)) (cons i acc) acc)))))
;; does production s admit a value of base type b?
(define (admits-base? s b vs)
  (cond [(or (eq? s '_) (tyvar? s)) #t]
        [(lit? s) (lit-in? (car (cdr s)) b)]
        [(sym-except? s) (eq? b 'Sym)]
        [(gram-name s)
         (if (member s vs) #f
             (ormap (lambda (p) (admits-base? p b (cons s vs))) (gram-prods s)))]
        [(symbol? s) (eq? s b)]
        [else #f]))
(define (pattern-cover p prods ctors)
  (match p
    [(? symbol? s)
     (let ([info (hash-ref/default ctors s #f)])
       (if (and info (null? (ctor-fields info)))
           (indices-where (lambda (q) (tmpl-overlap? (module-demangle s) q '())) prods)
           (covers-all prods)))]
    [(list 'quasiquote q)
     (indices-where (lambda (s) (tmpl-overlap? q s '())) prods)]
    [(list 'quote d)
     (indices-where (lambda (s) (tmpl-overlap? d s '())) prods)]
    [`(,cn ,ps ...) #:when (hash-has-key? ctors cn)
     (let ([q (cons (module-demangle cn) (map (lambda (x) (list 'unquote x)) ps))])
       (indices-where (lambda (s) (tmpl-overlap? q s '())) prods))]
    [(list '? pred _)
     (let ([b (pred-base pred)])
       (if b
           (indices-where (lambda (s) (admits-base? s b '())) prods)
           (covers-all prods)))]
    [(? fixnum? _) (indices-where (lambda (s) (tmpl-overlap? p s '())) prods)]
    [(? string? _) (indices-where (lambda (s) (tmpl-overlap? p s '())) prods)]
    [(? boolean? _) (indices-where (lambda (s) (tmpl-overlap? p s '())) prods)]
    [_ (covers-all prods)]))

;; the names some set! assigns, anywhere in forms (quoted data aside)
(define (assigned-names forms)
  (let ([s (make-set)])
    (define (walk e)
      (cond [(and (pair? e) (eq? (car e) 'quote)) (void)]
            [(and (pair? e) (eq? (car e) 'set!) (pair? (cdr e)) (symbol? (car (cdr e))))
             (begin (set-add! s (car (cdr e))) (walk (cdr (cdr e))))]
            [(pair? e) (begin (walk (car e)) (walk (cdr e)))]
            [else (void)]))
    (begin (for-each walk forms) s)))
;; an assigned variable's type: an exact atom as its base type, an
;; exact list shape as _
(define (loosen t)
  (if (sexp-type? t)
      (if (lit? (car (cdr t))) (widen t) '_)
      t))

;; ---- widening: an exact shape as the ordinary type it inhabits ------
(define (widen t) (if (sexp-type? t) (widen-shape (car (cdr t))) t))
(define (widen-shape s)
  (cond
    [(lit? s)
     (let ([d (car (cdr s))])
       (cond [(symbol? d) 'Sym] [(fixnum? d) 'Int] [(string? d) 'Str]
             [(boolean? d) 'Bool] [else '_]))]
    [(sym-except? s) 'Sym]
    [(slist? s)
     (list 'List
           (let loop ([es (cdr s)] [acc #f])
             (if (null? es)
                 (if acc acc '_)
                 (let ([w (widen-shape (unstar (car es)))])
                   (loop (cdr es) (if acc (type-join acc w) w))))))]
    [else s]))

;; a leaf's shape: an exact type contributes its shape, any other type
;; is a leaf
(define (leaf->shape t) (if (sexp-type? t) (car (cdr t)) t))
;; a shape as the type a binder gets
(define (shape->type s)
  (cond [(or (lit? s) (slist? s)) (list '#%sexp s)]
        [(sym-except? s) 'Sym]
        [else s]))

;; ---- rendering ------------------------------------------------------
(define (render-datum d)
  (cond [(symbol? d) (symbol->string (nm d))]
        [(fixnum? d) (number->string d)]
        [(string? d) (string-append "\"" (string-append d "\""))]
        [(eq? d #t) "#t"]
        [(eq? d #f) "#f"]
        [else (format "~a" d)]))
;; leaf renders a type leaf
(define (render-shape s leaf)
  (cond
    [(lit? s) (render-datum (car (cdr s)))]
    [(sym-except? s) (leaf 'Sym)]
    [(slist? s)
     (string-append
      "("
      (string-append
       (string-join (map (lambda (e)
                           (if (star? e)
                               (string-append (render-shape (car (cdr e)) leaf) " ...")
                               (render-shape e leaf)))
                         (cdr s))
                    " ")
       ")"))]
    [else (leaf s)]))
(define (shape-has-leaf? s)
  (cond [(lit? s) #f]
        [(slist? s) (ormap (lambda (e) (shape-has-leaf? (unstar e))) (cdr s))]
        [else #t]))
;; a production as written (exhaustiveness reports)
(define (render-prod s) (render-shape s (lambda (t) (format "~a" (ty t)))))
;; an exact type, as the datum or template it came from
(define (render-sexp-type s)
  (if (shape-has-leaf? s)
      (string-append "`" (render-shape s (lambda (t) (string-append "," (format "~a" (ty t))))))
      (string-append "'" (render-shape s (lambda (t) (format "~a" (ty t)))))))

;; map over top-level forms with current-form-origin set per form
;; (for-each-form, keeping the results)
(define (map-form proc forms)
  (define os
    (if (and form-origins (eq? (length form-origins) (length forms)))
        form-origins
        #f))
  (let loop ([fs forms] [oss os] [acc '()])
    (if (null? fs)
        (begin (set! current-form-origin #f) (reverse acc))
        (begin
          (set! current-form-origin (if oss (car oss) #f))
          (let ([r (proc (car fs))])
            (loop (cdr fs) (if oss (cdr oss) #f) (cons r acc)))))))

;; well-formedness: names resolve, arities match
(define (check-type-wf t params adts)
  (match t
    [(? symbol? s)
     (cond
       [(or (base-type? s) (if (member s params) #t #f) (tyvar? s)) (void)]
       [(hash-has-key? adts s)
        (unless (null? (hash-ref adts s))
          (type-error (format "type ~a expects ~a parameters"
                              (nm s) (length (hash-ref adts s)))))]
       ;; an unresolved type name is an error: it would otherwise
       ;; check as an opaque type and fail every consistency test
       ;; downstream with a baffling message (the cross-module case:
       ;; annotating with a type the exporting module never provided)
       [else (type-error (format "unknown type ~a" (nm s)))])]
    [`(,h ,a ,b) #:when (or (eq? h 'Pairof) (eq? h 'Hash))
     (check-type-wf a params adts) (check-type-wf b params adts)]
    [`(,h ,a) #:when (or (eq? h 'List) (eq? h 'Vec) (eq? h 'Set))
     (check-type-wf a params adts)]
    [`(Mut ,t0)
     (match t0
       [`(,h ,_ ...) #:when (or (eq? h 'Hash) (eq? h 'Vec) (eq? h 'Set))
        (check-type-wf t0 params adts)]
       [_ (type-error (format "(Mut ...) wraps a Hash, Vec, or Set type, got ~a" (ty t0)))])]
    [`(->* (,ts ...) ,tr ,tres)
     (begin (for-each (lambda (s) (check-type-wf s params adts)) ts)
            (check-type-wf tr params adts)
            (check-type-wf tres params adts))]
    [`(,h ,_ ...) #:when (or (eq? h 'Mut) (eq? h '->*))
     (type-error (format "malformed type: ~a" (ty t)))]
    [`(-> ,ts ...) (for-each (lambda (s) (check-type-wf s params adts)) ts)]
    [`(,n ,args ...) #:when (symbol? n)
     (cond [(hash-has-key? adts n)
            (unless (eq? (length args) (length (hash-ref adts n)))
              (type-error (format "type ~a expects ~a parameters, got ~a"
                                  (nm n) (length (hash-ref adts n)) (length args))))
            (for-each (lambda (s) (check-type-wf s params adts)) args)]
           [else (type-error (format "unknown type constructor ~a in ~a" (nm n) (ty t)))])]
    [_ (type-error (format "malformed type: ~a" (ty t)))]))

;; ---- substitution & consistency -------------------------------------

(define (subst t env)   ;; env: hash tyvar -> type
  (match t
    [(? symbol? s) (hash-ref/default env s s)]
    [`(,h ,ts ...) `(,h ,@(map (lambda (s) (subst s env)) ts))]
    [_ t]))

(define (all-consistent? as bs)
  (cond [(and (null? as) (null? bs)) #t]
        [(or (null? as) (null? bs)) #f]
        [(consistent? (car as) (car bs)) (all-consistent? (cdr as) (cdr bs))]
        [else #f]))

;; one-step unfold of (List a) as nil-or-pair for consistency against
;; Pairof (docs/TYPES.md: equi-recursive List).
;;
;; consistent? is called (synthesized, expected) at every site, so the
;; (Mut ...) rules below are DIRECTIONAL: a (Mut t) value fits a plain
;; expectation (unwrap on the left), a plain value never fits a (Mut t)
;; expectation.
(define (consistent? t1 t2)
  (cond
    [(eq? t1 '_) #t]
    [(eq? t2 '_) #t]
    [(tyvar? t1) #t]
    [(tyvar? t2) #t]
    ;; s-expression types (docs/GRAMMARS.md): into a grammar or an
    ;; exact shape is inclusion; an exact shape anywhere is inclusion
    ;; too; a grammar used as an ordinary type needs only to overlap it
    [(sexpy? t2) (sx-sub? t1 t2)]
    [(sexp-type? t1) (sx-sub? t1 t2)]
    [(gram-name t1) (sx-overlap? t1 t2)]
    [(and (symbol? t1) (symbol? t2)) (eq? t1 t2)]
    [(symbol? t1) #f]
    [(symbol? t2) #f]
    [else
     (match (list t1 t2)
       [`((Mut ,a) (Mut ,b)) (consistent? a b)]
       [`((Mut ,a) ,_) (consistent? a t2)]   ;; elimination accepts both flavors
       [`((List ,a) (Pairof ,x ,y))
        (and (consistent? x a) (consistent? y (list 'List a)))]
       [`((Pairof ,x ,y) (List ,a))
        (and (consistent? x a) (consistent? y (list 'List a)))]
       ;; a variadic function fits a fixed arrow that supplies at
       ;; least the fixed arguments (extras check against rest)
       [`((->* (,fs ...) ,fr ,fres) (-> ,abody ...))
        (arrows-consistent? fs fr fres abody)]
       [`((-> ,abody ...) (->* (,fs ...) ,fr ,fres))
        (arrows-consistent? fs fr fres abody)]
       [`((,h1 ,as ...) (,h2 ,bs ...))
        (and (eq? h1 h2) (eq? (length as) (length bs)) (all-consistent? as bs))]
       [_ #f])]))

;; abody is the fixed arrow's formals + result (the ->'s tail);
;; split off the result, then check fixed/extra/result parts
(define (arrows-consistent? fs fr fres abody)
  (let loop ([xs abody] [acc '()])
    (if (null? (cdr xs))
        (let ([as (reverse acc)] [ares (car xs)])
          (and (>= (length as) (length fs))
               (all-consistent? fs (take as (length fs)))
               (andmap (lambda (a) (consistent? a fr)) (drop as (length fs)))
               (consistent? fres ares)))
        (loop (cdr xs) (cons (car xs) acc)))))

;; side-effecting parallel walk (lengths assumed equal)
(define (each2 f xs ys)
  (if (or (null? xs) (null? ys))
      (void)
      (begin (f (car xs) (car ys)) (each2 f (cdr xs) (cdr ys)))))

;; greedy instantiation: bind formal's tyvars against actual; first
;; concrete binding wins, `_` never binds. A (Mut t) actual unwraps
;; against a plain formal (mirroring consistency's direction).
(define (instantiate! formal actual env)
  (cond
    [(tyvar? formal)
     (unless (or (hash-has-key? env formal) (eq? actual '_))
       (hash-set! env formal (if (and (sexp-type? actual) (lit? (car (cdr actual))))
                                 (widen actual)
                                 actual)))]
    ;; an exact shape: a type variable takes a list shape as is (above;
    ;; it may be a grammar's term) and an atom as its base type; a
    ;; structured formal reads the ordinary type it inhabits
    [(sexp-type? actual) (instantiate! formal (widen actual) env)]
    [(and (pair? formal) (eq? (car formal) 'Mut))
     (match actual
       [`(Mut ,b) (instantiate! (car (cdr formal)) b env)]
       [_ (void)])]
    [(and (pair? formal) (pair? actual) (eq? (car actual) 'Mut))
     (instantiate! formal (car (cdr actual)) env)]
    [(and (pair? formal) (eq? (car formal) 'List))
     (let ([a (car (cdr formal))])
       (match actual
         [`(List ,x) (instantiate! a x env)]
         [`(Pairof ,x ,y) (instantiate! a x env)]
         [_ (void)]))]
    ;; the equi-recursive unfold in the other direction: car/cdr's
    ;; (Pairof a d) formal against a (List x) actual
    [(and (pair? formal) (eq? (car formal) 'Pairof))
     (let ([a (car (cdr formal))] [d (car (cdr (cdr formal)))])
       (match actual
         [`(Pairof ,x ,y) (begin (instantiate! a x env) (instantiate! d y env))]
         [`(List ,x) (begin (instantiate! a x env) (instantiate! d (list 'List x) env))]
         [_ (void)]))]
    [(pair? formal)
     (let ([h (car formal)] [as (cdr formal)])
       (match actual
         [`(,h2 ,bs ...) #:when (and (eq? h h2) (eq? (length as) (length bs)))
          (each2 (lambda (a b) (instantiate! a b env)) as bs)]
         [_ (void)]))]
    [else (void)]))

;; join for match-clause / if results: equal stays, else _
(define (type-join a b)
  (cond [(equal? a b) a]
        [(eq? a '_) b]
        [(eq? b '_) a]
        ;; s-expression types: the larger when one includes the other,
        ;; else _ (a widening would lose that both fit some grammar)
        [(and (sexpy? a) (sexpy? b))
         (cond [(sx-sub? a b) b]
               [(sx-sub? b a) a]
               [else '_])]
        [(sexp-type? a) (type-join (widen a) b)]
        [(sexp-type? b) (type-join a (widen b))]
        [(consistent? a b) (if (eq? a '_) b (if (eq? b '_) a '_))]
        [else '_]))

(define (tyvars-of t)
  (cond [(tyvar? t) (set t)]
        [(pair? t) (foldl (lambda (x s) (set-union s (tyvars-of x))) (set) (cdr t))]
        [else (set)]))

(define (blank-tyvars t)
  (cond [(tyvar? t) '_]
        [(pair? t) (cons (car t) (map blank-tyvars (cdr t)))]
        [else t]))

;; ---- prim types (mirrors src/types.rkt) -----------------------------
;; The manifest (tables.puf, generated from src/stdlib.rkt) carries
;; each prim's type; the local table covers only desugar-level
;; non-manifest forms: the open-coded intrinsics + - * eq? <, the
;; comparators that shrink to < (<= > >=), and `not` -- these can
;; also appear as VALUES (e.g. (map not xs)).

(define non-manifest-prim-types
  (foldl (lambda (pr acc) (hash-set acc (car pr) (cdr pr)))
         (hash)
         (list
          (cons '+ '(-> Int Int Int)) (cons '- '(-> Int Int Int)) (cons '* '(-> Int Int Int))
          (cons '< '(-> Int Int Bool)) (cons '<= '(-> Int Int Bool)) (cons '> '(-> Int Int Bool)) (cons '>= '(-> Int Int Bool))
          (cons 'eq? '(-> a b Bool)) (cons 'not '(-> a Bool)))))

(define (prim-type-of op)
  (if (hash-has-key? non-manifest-prim-types op)
      (hash-ref non-manifest-prim-types op)
      (let ([mt (and (stdlib-prim? op) (stdlib-prim-type op))])
        (if mt
            mt
            (if (prim? op)
                `(-> ,@(map (lambda (dummy) '_) (range 0 (prim-arity op))) _)
                '_)))))

;; ---- application checking (pure; closes over nothing) ---------------

(define (split-arrow ft)   ;; (-> t1 ... tn res) -> (formals . res)
  (let loop ([xs (cdr ft)] [acc '()])
    (if (null? (cdr xs))
        (cons (reverse acc) (car xs))
        (loop (cdr xs) (cons (car xs) acc)))))

;; the shared per-argument discipline: instantiate greedily, then
;; contract-check each argument against its (instantiated) formal,
;; demoting inference-only tyvar conflicts to _.
;; Discipline (the gradual guarantee): a formal's CONCRETE structure is
;; a contract -- violating it errors. A constraint that exists only
;; because greedy instantiation bound a type VARIABLE from a sibling
;; argument is an inference hint -- a conflict there demotes the
;; variable to _ instead of erroring.
(define (check-args formals arg-ts res where)
  (let ([tenv (make-hash)])
    (each2 (lambda (f a) (instantiate! f a tenv)) formals arg-ts)
    (let ([conflicted (make-set)])
      (each2 (lambda (f a)
               (let ([fstar (subst f tenv)])
                 (unless (consistent? a fstar)
                   (if (consistent? a (blank-tyvars f))
                       (for-each (lambda (v) (set-add! conflicted v))
                                 (set->list (tyvars-of f)))
                       (type-error (format "~a: argument has type ~a, expected ~a"
                                           (nm where) (ty a) (ty fstar)))))))
             formals arg-ts)
      (for-each (lambda (v) (hash-set! tenv v '_)) (set->list conflicted))
      (subst res tenv))))

(define (check-app ft arg-ts where)
  (cond
    [(eq? ft '_) '_]
    [(tyvar? ft) '_]
    [(and (pair? ft) (eq? (car ft) '->))
     (let* ([fr (split-arrow ft)]
            [formals (car fr)]
            [res (cdr fr)])
       (unless (eq? (length formals) (length arg-ts))
         (type-error (format "~a expects ~a arguments, got ~a"
                             (nm where) (length formals) (length arg-ts))))
       (check-args formals arg-ts res where))]
    [(and (pair? ft) (eq? (car ft) '->*))
     (match ft
       [`(->* (,fixed ...) ,trest ,res)
        (begin
          (when (< (length arg-ts) (length fixed))
            (type-error (format "~a expects at least ~a arguments, got ~a"
                                (nm where) (length fixed) (length arg-ts))))
          ;; every extra argument checks against the rest-element type
          (let ([extras (map (lambda (dummy) trest)
                             (range 0 (- (length arg-ts) (length fixed))))])
            (check-args (append fixed extras) arg-ts res where)))])]
    [else (type-error (format "~a: applying a non-function of type ~a" (nm where) (ty ft)))]))

(define (lambda-head? s) (or (eq? s 'lambda) (eq? s 'λ)))
(define (arith-op? x) (if (member x '(+ - *)) #t #f))

;; the #:when clause marker (a #:kw literal breaks the hosted build if
;; written directly; build it from its string, like desugar.puf)
(define kw-when (string->symbol "#:when"))

;; ---------------------------------------------------------------------
;; the checker proper: everything below closes over adts/ctors/top
;; ---------------------------------------------------------------------

;; ---------------------------------------------------------------------
;; with-handlers (docs/EXCEPTIONS.md): expanded before anything is
;; checked, so every route -- the chain, both backends, the assists --
;; sees only the call-with-handler prim:
;;
;;   (with-handlers ([P H] ...) BODY ...)
;;   => (let ([#%wh-p0 P] [#%wh-h0 H] ...)
;;        (call-with-handler (lambda () BODY ...)
;;                           (lambda (#%wh-e)
;;                             (cond [(#%wh-p0 #%wh-e) (#%wh-h0 #%wh-e)] ...
;;                                   [else (raise #%wh-e)]))))
;;
;; A P or H that is a name or a lambda is used in place. Fixed binder
;; names (no gensym), quote is data, quasiquote is data except under
;; unquote / unquote-splicing. Mirrors src/types.rkt.
;; ---------------------------------------------------------------------

(define (wh-qq t)
  (cond
    [(and (pair? t)
          (if (eq? (car t) 'unquote) #t (eq? (car t) 'unquote-splicing))
          (pair? (cdr t))
          (null? (cdr (cdr t))))
     (list (car t) (expand-with-handlers (car (cdr t))))]
    [(pair? t) (cons (wh-qq (car t)) (wh-qq (cdr t)))]
    [else t]))

(define (wh-clause? c) (and (list? c) (eq? (length c) 2)))

;; a P or H in place, or bound: (list EXPR BINDINGS)
(define (wh-place x tag)
  (let ([x2 (expand-with-handlers x)])
    (if (if (symbol? x2) #t (and (pair? x2) (eq? (car x2) 'lambda)))
        (list x2 '())
        (let ([name (string->symbol (string-append "#%wh-" tag))])
          (list name (list (list name x2)))))))

(define (wh-expand clauses body)
  (let loop ([cs clauses] [i 0] [tests '()] [binds '()])
    (if (null? cs)
        (let ([call (list 'call-with-handler
                          (cons 'lambda (cons '() (map expand-with-handlers body)))
                          (list 'lambda (list '#%wh-e)
                                (cons 'cond (append (reverse tests)
                                                    (list (list 'else (list 'raise '#%wh-e)))))))])
          (if (null? binds) call (list 'let binds call)))
        (let* ([n (number->string i)]
               [pp (wh-place (car (car cs)) (string-append "p" n))]
               [hp (wh-place (car (cdr (car cs))) (string-append "h" n))])
          (loop (cdr cs) (+ i 1)
                (cons (list (list (car pp) '#%wh-e) (list (car hp) '#%wh-e)) tests)
                (append binds (append (car (cdr pp)) (car (cdr hp)))))))))

(define (expand-with-handlers e)
  (cond
    [(not (pair? e)) e]
    [(eq? (car e) 'quote) e]
    [(and (eq? (car e) 'quasiquote) (pair? (cdr e)) (null? (cdr (cdr e))))
     (list 'quasiquote (wh-qq (car (cdr e))))]
    [(and (eq? (car e) 'with-handlers) (list? e) (pair? (cdr e))
          (list? (car (cdr e))) (andmap wh-clause? (car (cdr e)))
          (pair? (cdr (cdr e))))
     (wh-expand (car (cdr e)) (cdr (cdr e)))]
    [(list? e) (map expand-with-handlers e)]
    [else (cons (expand-with-handlers (car e)) (cdr e))]))

(define (typecheck-program p0)
  ;; a previous program's check may have stopped at an error mid-form
  (set! abstract-here '())
  (set! current-module #f)
  (match p0
    [`(program ,forms000 ...)
     (define forms00 (map expand-with-handlers forms000))
     ;; type aliases are unfolded everywhere before any type is read
     (define aliases (collect-aliases forms00))
     (define forms0 (expand-type-aliases forms00 aliases))
     (define ac (collect-adts forms0))
     (define adts (car ac))
     (define ctors (car (cdr ac)))
     (define ctor-orders (car (cdr (cdr ac))))
     (define ftypes (car (cdr (cdr (cdr ac)))))
     ;; quote and quasiquote are data at every depth (docs/GRAMMARS.md):
     ;; nothing is rewritten, the checker types them by their shape
     (define forms forms0)
     (define p (cons 'program forms))
     (define top (make-hash))
     ;; every name some set! assigns: such a variable never keeps an
     ;; exact shape (docs/GRAMMARS.md), which a later assignment of a
     ;; different value would contradict -- the no-refinement-of-
     ;; assigned-variables rule
     (define assigned (assigned-names forms))

     ;; a name cannot be both a type and a value: `provide` resolves a
     ;; name against both namespaces (docs/MODULES.md), so a collision
     ;; would make an export ambiguous -- and locally, references and
     ;; annotations would silently mean different things
     (for-each-form
      (lambda (f)
        (let ([n (match f
                   [`(define (,g . ,_) ,_ ...) (if (symbol? g) g #f)]
                   [`(define ,x ,_) (if (symbol? x) x #f)]
                   [_ #f])])
          (when (and n (or (hash-has-key? adts n) (hash-has-key? aliases n)))
            (type-error (format "~a is defined as both a type and a value" (nm n))))))
      forms)

     ;; every alias abbreviates a well-formed type (its parameters in scope)
     (for-each-form
      (lambda (f)
        (match f
          [`(define-type-alias ,head ,body)
           (let ([np (alias-head-np head f)])
             (check-type-wf (expand-alias-type body aliases) (cdr np) adts))]
          [_ (void)]))
      forms)

     ;; formal helpers for populating `top`
     (define (formal-type f) (match f [`(,x : ,t) t] [_ '_]))
     (define (formal-name f) (match f [`(,x : ,t) x] [x x]))
     (define (valid-formals? formals)
       (andmap (lambda (x) (or (symbol? x) (and (list? x) (eq? (length x) 3)))) formals))
     ;; variadic formals: (a b . rest) -- or a bare symbol, as in
     ;; (lambda args ...). split-dotted returns (cons fixed rest-name).
     (define (dotted-formals? formals)
       (or (symbol? formals)
           (and (pair? formals) (dotted-formals? (cdr formals)))))
     (define (split-dotted formals)
       (if (symbol? formals)
           (cons '() formals)
           (let ([fr (split-dotted (cdr formals))])
             (cons (cons (car formals) (car fr)) (cdr fr)))))

     ;; A name that is neither locally bound, top-level, nor a prim is
     ;; an ERROR outside REPL mode (mirrors src/types.rkt). REPL units
     ;; late-bind by name -- a still-unbound cell errors at run time
     ;; carrying the name. It used to fall through as _ ("dynamic"),
     ;; and no later pass checked scope either: the reference compiled
     ;; into an uninitialized cell holding fixnum 0, which CALLI
     ;; dispatched as function index 0 = the program entry -- calling a
     ;; typo'd name re-entered main until the stack died.
     (define (lookup env x)
       ;; an editor assist checks programs with holes in them: ?? is
       ;; _ while a probe is set (system.puf), unbound otherwise
       (let ([hit (if (and probe-hook (eq? x '??)) (cons x '_) (assoc x env))])
         (if hit
             (cdr hit)
             (let ([tv (hash-ref/default top x #f)])
               (if tv
                   tv
                   (if (prim? x)
                       (prim-type-of x)
                       ;; desugar-level forms the local table types
                       ;; but the manifest doesn't know (<= > >=)
                       (let ([pt (hash-ref/default non-manifest-prim-types x #f)])
                         (if pt
                             pt
                             (if repl-mode
                                 '_
                                 ;; ... and when a required module
                                 ;; keeps the name private, the
                                 ;; message says so
                                 (let ([dep (module-private-hint current-module x)])
                                   (if dep
                                       (type-error (format "~a is private to ~a" (nm x) dep))
                                       (type-error (format "unbound variable ~a" (nm x))))))))))))))

     ;; collect the binders a quasiquote pattern introduces (all typed
     ;; _; the point is that they ENTER the env so a later reference
     ;; does not fall through to a same-named top-level binding).
     (define (qq-pattern-binds tmpl depth)
       (match tmpl
         [(list 'unquote sub)
          (if (eq? depth 1)
              (map (lambda (b) (cons (car b) '_)) (pattern-bindings sub '_))
              (qq-pattern-binds sub (- depth 1)))]
         [(list 'unquote-splicing sub)
          (if (eq? depth 1)
              (map (lambda (b) (cons (car b) '_)) (pattern-bindings sub '_))
              (qq-pattern-binds sub (- depth 1)))]
         [(list 'quasiquote inner) (qq-pattern-binds inner (+ depth 1))]
         [(? pair? _)
          (append (if (eq? (car tmpl) '...) '() (qq-pattern-binds (car tmpl) depth))
                  (qq-pattern-binds (cdr tmpl) depth))]
         [_ '()]))

     (define (cons-scrut st)
       (match st
         [`(Pairof ,a ,d) (cons a d)]
         [`(List ,a) (cons a (list 'List a))]
         [_ (cons '_ '_)]))

     (define (fields-bindings ps fts tenv)
       (if (or (null? ps) (null? fts))
           '()
           (append (pattern-bindings (car ps) (subst (car fts) tenv))
                   (fields-bindings (cdr ps) (cdr fts) tenv))))

     ;; pattern: returns bindings ((x . t) ...) and checks ctor shapes
     (define (pattern-bindings pat scrut-t)
       ;; only binders, _ and type tests may meet an abstract type:
       ;; every other pattern looks at the representation
       (let ([a (abstract-name scrut-t)])
         (when (and a (pair? pat) (not (eq? (car pat) '?)))
           (type-error (format "~a is abstract outside ~a: a pattern cannot take it apart"
                               (ty scrut-t) (module-abstract-owner a)))))
       (match pat
         [(? symbol? s)
          (if (eq? s '_)
              '()
              (let ([info (hash-ref/default ctors s #f)])
                (if info
                    (begin
                      (unless (null? (ctor-fields info))
                        (type-error (format "constructor ~a used bare but has ~a fields"
                                            (nm s) (length (ctor-fields info)))))
                      '())
                    (list (cons s (if (eq? scrut-t '_) '_ scrut-t))))))]
         [(list 'quote _) '()]
         ;; against an s-expression type, a template's binders take
         ;; their types from the productions it matches (docs/GRAMMARS.md §5)
         [(list 'quasiquote tmpl)
          (if (or (sexpy? scrut-t) (and (pair? scrut-t) (eq? (car scrut-t) 'List)))
              (let ([bs (align tmpl (leaf->shape scrut-t) '())])
                (if bs bs (qq-pattern-binds tmpl 1)))
              (qq-pattern-binds tmpl 1))]
         [(? fixnum? _) '()]
         [(? boolean? _) '()]
         [(? string? _) '()]
         [(list 'cons p0 p1)
          (let* ([ad (cons-scrut scrut-t)])
            (append (pattern-bindings p0 (car ad)) (pattern-bindings p1 (cdr ad))))]
         [(cons 'list ps)
          (let ([a (match scrut-t [`(List ,a) a] [_ '_])])
            (append-map (lambda (p) (pattern-bindings p a)) ps))]
         [(cons 'vector ps)
          (let ([a (match scrut-t [`(Vec ,a) a] [`(Mut (Vec ,a)) a] [_ '_])])
            (append-map (lambda (p) (pattern-bindings p a)) ps))]
         ;; a type-test narrows, when the scrutinee is typed
         [(list '? pred p)
          (if (sexpy? scrut-t)
              (pattern-bindings p (let ([b (pred-base pred)]) (if b b scrut-t)))
              (pattern-bindings p '_))]
         [`(,cn ,ps ...) #:when (hash-has-key? ctors cn)
          (let ([info (hash-ref ctors cn)])
            (unless (eq? (length ps) (length (ctor-fields info)))
              (type-error (format "constructor ~a expects ~a fields, got ~a in pattern"
                                  (nm cn) (length (ctor-fields info)) (length ps))))
            (let ([tenv (make-hash)])
              (match scrut-t
                [`(,n ,args ...) #:when (eq? n (ctor-owner info))
                 (each2 (lambda (p a) (hash-set! tenv p a)) (ctor-params info) args)]
                [_ (void)])
              (fields-bindings ps (ctor-fields info) tenv)))]
         [_ '()]))

     ;; --- templates against shapes (docs/GRAMMARS.md §5) ---
     ;; align: the bindings a quasiquote pattern q (depth 1) makes
     ;; against the shape or type s, or #f when no value of s can match
     ;; it. vs: the grammars being expanded for this q (left
     ;; recursion stops there).
     (define (untyped-binds q) (qq-pattern-binds q 1))
     (define (align q s vs)
       (cond
         [(and (pair? q) (eq? (car q) 'unquote) (pair? (cdr q)) (null? (cdr (cdr q))))
          (pattern-bindings (car (cdr q)) (shape->type s))]
         [(sexp-type? s) (align q (car (cdr s)) vs)]
         [(gram-name s)
          (if (member s vs)
              #f
              (let ([alts (filter-map (lambda (p) (align q p (cons s vs))) (gram-prods s))])
                (if (null? alts) #f (merge-binds alts))))]
         [(or (eq? s '_) (tyvar? s)) (untyped-binds q)]
         [(null? q)
          (cond [(slist? s) (if (andmap star? (cdr s)) '() #f)]
                [(and (pair? s) (eq? (car s) 'List)) '()]
                [else #f])]
         [(pair? q)
          (cond [(slist? s) (align-list q (cdr s) vs)]
                ;; an ordinary (List τ) is "zero or more τ"
                [(and (pair? s) (eq? (car s) 'List)) (align-list q (list (list '#%star (car (cdr s)))) vs)]
                [(and (pair? s) (eq? (car s) 'Pairof)) (untyped-binds q)]
                [else #f])]
         [else (if (lit-in? q s) '() #f)]))
     ;; the alternatives' bindings, joined name by name
     (define (merge-binds alts)
       (map (lambda (b)
              (cons (car b)
                    (foldl (lambda (alt acc)
                             (let ([hit (assoc (car b) alt)])
                               (if hit (type-join acc (cdr hit)) '_)))
                           (cdr b) (cdr alts))))
            (car alts)))
     (define (concat-binds bss)
       (if (andmap (lambda (b) (if b #t #f)) bss) (foldr append '() bss) #f))
     ;; a pattern list: prefix, an ellipsis element and what follows it,
     ;; or a dotted ,tail
     (define (align-list q fs vs)
       (let* ([sp (split-qpat q)]
              [pre (first sp)] [ell (second sp)] [post (third sp)] [tail (car (cdr (cdr (cdr sp))))]
              [f3 (split-star fs)]
              [pf (first f3)] [sf (second f3)] [qf (third f3)]
              [lpre (length pre)] [lpf (length pf)] [lqf (length qf)])
         (cond
           [(eq? tail 'bad) (untyped-binds q)]
           [tail
            ;; (p ... . ,rest): the prefix against the leading fixed
            ;; elements, rest against what remains
            (cond [(and (not sf) (>= (length fs) lpre))
                   (concat-binds
                    (append (map2 (lambda (p f) (align p f vs)) pre (take fs lpre))
                            (list (pattern-bindings tail (list '#%sexp (cons '#%list (drop fs lpre)))))))]
                  [(and sf (<= lpre lpf))
                   (concat-binds
                    (append (map2 (lambda (p f) (align p f vs)) pre (take pf lpre))
                            (list (pattern-bindings tail (list '#%sexp (cons '#%list (drop fs lpre)))))))]
                  ;; the prefix runs into a final star: the rest is more of it
                  [(and sf (null? qf))
                   (concat-binds
                    (append (map2 (lambda (p f) (align p f vs)) (take pre lpf) pf)
                            (append (map (lambda (p) (align p sf vs)) (drop pre lpf))
                                    (list (pattern-bindings tail (list '#%sexp (list '#%list (list '#%star sf))))))))]
                  [else (untyped-binds q)])]
           [(not ell)
            (cond [(not sf)
                   (if (eq? lpre (length fs))
                       (concat-binds (map2 (lambda (p f) (align p f vs)) pre fs))
                       #f)]
                  [(>= lpre (+ lpf lqf))
                   (concat-binds
                    (append (map2 (lambda (p f) (align p f vs)) (take pre lpf) pf)
                            (append (map (lambda (p) (align p sf vs)) (take (drop pre lpf) (- lpre (+ lpf lqf))))
                                    (map2 (lambda (p f) (align p f vs)) (drop pre (- lpre lqf)) qf))))]
                  [else #f])]
           [(not (list? post)) (untyped-binds q)]
           [(member '... post) (untyped-binds q)]
           [else
            (let ([lpost (length post)])
              (cond
                [(not sf)
                 (if (<= (+ lpre lpost) (length fs))
                     (let ([fixed (concat-binds
                                   (append (map2 (lambda (p f) (align p f vs)) pre (take fs lpre))
                                           (map2 (lambda (p f) (align p f vs)) post (drop fs (- (length fs) lpost)))))]
                           [middle (take (drop fs lpre) (- (length fs) (+ lpre lpost)))])
                       (if fixed
                           (let ([eb (ell-binds ell middle vs #t)])
                             (if eb (append fixed eb) #f))
                           #f))
                     #f)]
                [else
                 ;; the prefix runs into the star, the suffix back
                 ;; from the end; the ellipsis element meets whatever
                 ;; fixed elements neither reaches, and the star
                 (let* ([pre-f (append (take pf (min lpre lpf))
                                       (map (lambda (dummy) sf) (range 0 (max 0 (- lpre lpf)))))]
                        [post-f (append (map (lambda (dummy) sf) (range 0 (max 0 (- lpost lqf))))
                                        (drop qf (max 0 (- lqf lpost))))]
                        [fixed (concat-binds
                                (append (map2 (lambda (p f) (align p f vs)) pre pre-f)
                                        (map2 (lambda (p f) (align p f vs)) post post-f)))]
                        [cands (append (drop pf (min lpre lpf))
                                       (cons sf (take qf (max 0 (- lqf lpost)))))])
                   (if fixed
                       (let ([eb (ell-binds ell cands vs #f)])
                         (if eb (append fixed eb) #f))
                       #f))]))])))
     ;; the ellipsis element's binders, each a (List τ) of what it meets
     ;; in cands; all? says every candidate is an element it must match
     (define (ell-binds ell cands vs all?)
       (let* ([alts (map (lambda (c) (align ell c vs)) cands)]
              [ok (filter (lambda (b) (if b #t #f)) alts)])
         (cond
           [(and all? (not (andmap (lambda (b) (if b #t #f)) alts))) #f]
           [(null? ok)
            (if (and (not all?) (pair? cands))
                #f
                (map (lambda (b) (cons (car b) (list 'List '_))) (untyped-binds ell)))]
           [else (map (lambda (b) (cons (car b) (list 'List (cdr b)))) (merge-binds ok))])))
     ;; --- bidirectional core: synth returns the expression's type ---

     (define (synth-cond clauses env)
       (foldl
        (lambda (cl t)
          (match cl
            [`(else ,body ...) (type-join t (synth-body body env))]
            [`(,g ,body ...) (synth g env) (type-join t (synth-body body env))]))
        '_ clauses))

     (define (synth-case-clauses clauses env)
       (for-each
        (lambda (cl)
          (match cl
            [`(else ,body ...) (synth-body body env)]
            [`(,_ ,body ...) (synth-body body env)]))
        clauses))

     (define (match-clause-parts cl)
       (match cl
         [`(,pat ,kw ,guard ,body ...) #:when (eq? kw kw-when) (cons pat (cons guard body))]
         [`(,pat ,body ...) (cons pat (cons #f body))]))

     ;; exhaustiveness over grammars and define-types (docs/GRAMMARS.md
     ;; §5): when the scrutinee's type is a KNOWN grammar (a `_`
     ;; scrutinee is exempt -- the gradual guarantee), a production no
     ;; clause can match is missing. Conservative in the
     ;; no-false-warnings direction: guards are ignored, a clause that
     ;; matches part of a production covers it, and a pattern the
     ;; checker cannot analyze (cons, list, vector, an unknown
     ;; predicate, a binder, _) covers everything. A define-type's
     ;; report names its constructors; a grammar's spells the
     ;; productions. A WARNING on stderr (strict-exhaustiveness
     ;; promotes it to an error).
     (define (check-match-exhaustiveness st clauses)
       (let ([name (gram-name st)])
         (when name
           (let* ([gi (hash-ref grammar-table name)]
                  [prods (gram-prods st)]
                  [covered (foldl (lambda (cl cov)
                                    (set-union cov (list->set (pattern-cover (car (match-clause-parts cl)) prods ctors))))
                                  (set) clauses)]
                  [missing (filter (lambda (i) (not (set-member? covered i))) (covers-all prods))])
             (when (pair? missing)
               (let ([msg (format "match on ~a is not exhaustive: missing ~a"
                                  (nm name)
                                  (string-join
                                   (map (lambda (i)
                                          (if (eq? (g-kind gi) 'type)
                                              (symbol->string (nm (list-ref (g-ctors gi) i)))
                                              (render-prod (list-ref (g-prods gi) i))))
                                        missing)
                                   ", "))])
                 ;; the warning renders the position itself; the
                 ;; strict error gets it from type-error -- same
                 ;; bytes either way
                 (if strict-exhaustiveness
                     (type-error msg)
                     (eprintln (string-append "typecheck warning: "
                                              (string-append msg (origin-suffix)))))))))))

     (define (synth-match scrut clauses env)
       (let ([st (synth scrut env)])
         (let ([res (let loop ([cls clauses] [t '_] [first #t])
                      (if (null? cls)
                          t
                          (let* ([pgb (match-clause-parts (car cls))]
                                 [pat (car pgb)]
                                 [guard (car (cdr pgb))]
                                 [body (cdr (cdr pgb))]
                                 [env+ (append (pattern-bindings pat st) env)])
                            (when (not (eq? guard #f)) (synth guard env+))
                            (let ([bt (synth-body body env+)])
                              (loop (cdr cls) (if first bt (type-join t bt)) #f)))))])
           (check-match-exhaustiveness st clauses)
           res)))

     (define (synth-named-let loop-name bindings body env)
       (let* ([bs (map binding-parts bindings)]
              [env+ (append (map (lambda (b) (cons (car b) (car (cdr b)))) bs) env)])
         (for-each (lambda (b) (check-binding b env)) bs)
         (synth-body body (cons (cons loop-name '_) env+))))

     (define (synth-let bindings body env star?)
       (let ([env+ (foldl
                    (lambda (b acc)
                      (let ([parts (binding-parts b)])
                        (check-binding parts (if star? acc env))
                        (cons (cons (car parts) (car (cdr parts))) acc)))
                    env bindings)])
         (synth-body body env+)))

     (define (synth-lambda formals body env)
       (let* ([fts (map formal-type* formals)]
              [rb (match body
                    [`(: ,t ,rest ...) (cons t rest)]
                    [_ (cons '_ body)])]
              [rt (car rb)]
              [body* (cdr rb)]
              [env+ (append (map2 (lambda (n t) (cons n t)) (map formal-name* formals) fts) env)]
              [bt (synth-body body* env+)])
         (when (and (not (eq? rt '_)) (not (consistent? bt rt)))
           (type-error (format "lambda body has type ~a, declared ~a" (ty bt) (ty rt))))
         `(-> ,@fts ,(if (eq? rt '_) bt rt))))

     ;; variadic lambda -- (lambda (a . rest) ...) or (lambda args
     ;; ...): fixed formals may be annotated, the rest binder is
     ;; (List _) in the body
     (define (synth-varlambda formals body env)
       (let* ([fr (split-dotted formals)]
              [fixed (car fr)]
              [rest-name (cdr fr)]
              [fts (map formal-type* fixed)]
              [rb (match body
                    [`(: ,t ,rest ...) (cons t rest)]
                    [_ (cons '_ body)])]
              [rt (car rb)]
              [body* (cdr rb)]
              [env+ (cons (cons rest-name '(List _))
                          (append (map2 (lambda (n t) (cons n t))
                                        (map formal-name* fixed) fts)
                                  env))]
              [bt (synth-body body* env+)])
         (when (and (not (eq? rt '_)) (not (consistent? bt rt)))
           (type-error (format "lambda body has type ~a, declared ~a" (ty bt) (ty rt))))
         `(->* ,fts _ ,(if (eq? rt '_) bt rt))))

     (define (synth-set! x e0 env)
       (let ([xt (lookup env x)] [et (synth e0 env)])
         (unless (consistent? et xt)
           (type-error (format "(set! ~a ...): value has type ~a, variable is ~a" (nm x) (ty et) (ty xt))))
         'Void))

     (define (synth-arith op es env)
       (for-each
        (lambda (s)
          (let ([t (synth s env)])
            (unless (consistent? t 'Int)
              (type-error (format "~a: argument has type ~a, expected Int" op (ty t))))))
        es)
       'Int)

     (define (synth-app rator rands env)
       (let ([ft (synth rator env)]
             [arg-ts (map (lambda (r) (synth r env)) rands)])
         (check-app ft arg-ts (if (symbol? rator) rator "application"))))

     ;; the expression under synthesis is the focus a type error names
     (define (synth e env)
       (let ([saved check-focus])
         (set! check-focus e)
         (let ([t (synth* e env)])
           (set! check-focus saved)
           t)))
     (define (synth* e env)
       (match e
         [(? fixnum? _) 'Int]
         [#t 'Bool]
         [#f 'Bool]
         [(? string? _) 'Str]
         [`(void) 'Void]
         [`(read) 'Int]
         ;; quoted data and templates have the exact type of their
         ;; shape (docs/GRAMMARS.md §4); () stays (List _)
         [`(quote ,d)
          (if (null? d)
              '(List _)
              (let ([s (datum->shape d)]) (if s (list '#%sexp s) '_)))]
         [(list 'quasiquote q)
          (let ([s (qq->shape q env)]) (if s (list '#%sexp s) '_))]
         [(? symbol? x) (lookup env x)]
         ;; an editor assist's probe (system.puf probe-hook)
         [`(#%probe ,e0) #:when probe-hook
          (let ([t (synth e0 env)]) (probe-hook t env) t)]
         [`(ann ,e0 ,t)
          (check-type-wf t '() adts)
          (let ([et (synth e0 env)])
            (unless (consistent? et t)
              (type-error (format "(ann ...) claims ~a but expression has type ~a" (ty t) (ty et))))
            t)]
         [`(if ,g ,then ,els)
          (synth g env) (type-join (synth then env) (synth els env))]
         [`(cond ,clauses ...) (synth-cond clauses env)]
         [`(when ,g ,body ...) (synth g env) (synth-body body env) '_]
         [`(unless ,g ,body ...) (synth g env) (synth-body body env) '_]
         [`(case ,k ,clauses ...) (synth k env) (synth-case-clauses clauses env) '_]
         [`(match ,scrut ,clauses ...) (synth-match scrut clauses env)]
         [`(let ,loop-name (,bindings ...) ,body ...) #:when (symbol? loop-name)
          (synth-named-let loop-name bindings body env)]
         [`(let (,bindings ...) ,body ...) (synth-let bindings body env #f)]
         [`(let* (,bindings ...) ,body ...) (synth-let bindings body env #t)]
         [`(,lam ,formals ,body ...) #:when (and (lambda-head? lam) (list? formals))
          (synth-lambda formals body env)]
         [`(,lam ,formals ,body ...) #:when (and (lambda-head? lam) (dotted-formals? formals))
          (synth-varlambda formals body env)]
         [`(,lam ,formals ,body ...) #:when (lambda-head? lam) '_]
         [`(begin ,es ... ,lastx)
          (for-each (lambda (s) (synth s env)) es) (synth lastx env)]
         [`(while ,g ,body ...) (synth g env) (synth-body body env) 'Void]
         [`(set! ,x ,e0) (synth-set! x e0 env)]
         [`(and ,es ...) (for-each (lambda (s) (synth s env)) es) '_]
         [`(or ,es ...) (for-each (lambda (s) (synth s env)) es) '_]
         ;; `not` is a desugar-level form (shrink: (not e) -> (if e #f #t)),
         ;; not a prim or prelude function -- without a case here the
         ;; app fallthrough would look it up as a variable
         [`(not ,e0) (begin (synth e0 env) 'Bool)]
         [`(list ,es ...) (list 'List (foldl (lambda (s t) (type-join t (synth s env))) '_ es))]
         ;; vector literals allocate a runtime-mutable vector, like
         ;; make-vector (there is no persistent Vec flavor)
         [`(vector ,es ...)
          (list 'Mut (list 'Vec (foldl (lambda (s t) (type-join t (synth s env))) '_ es)))]
         ;; hash/set literals build PERSISTENT collections: plain
         ;; (Hash _ _)/(Set _), never (Mut ...). make-hash/make-set
         ;; type through the manifest ((-> (Mut (Hash _ _))) etc.).
         [`(hash ,es ...) '(Hash _ _)]
         [`(set ,es ...) '(Set _)]
         [`(,op ,es ...) #:when (arith-op? op) (synth-arith op es env)]
         [`(,rator ,rands ...) (synth-app rator rands env)]
         [_ '_]))

     ;; a template at depth 1 as a shape, or #f when it has none (two
     ;; splices in one list, a dotted non-list tail, nested
     ;; quasiquote). Every hole is synthesized either way.
     (define (qq->shape q env)
       (match q
         [(list 'unquote e) (leaf->shape (synth e env))]
         [(list 'quasiquote _) #f]
         ['() (list '#%list)]
         [(? pair? _) (qq-list->shape q env)]
         [d (list '#%lit d)]))
     ;; a list-typed tail or splice as shape elements, or #f
     (define (tail-elems t)
       (cond [(and (pair? t) (eq? (car t) 'List)) (list (list '#%star (leaf->shape (car (cdr t)))))]
             [(and (sexp-type? t) (slist? (car (cdr t)))) (cdr (car (cdr t)))]
             [(eq? t '_) (list (list '#%star '_))]
             [else #f]))
     (define (count-stars es) (length (filter star? es)))
     (define (qq-list->shape q env)
       (let loop ([q q] [acc '()] [stars 0] [ok #t])
         (match q
           ['() (if (and ok (<= stars 1)) (cons '#%list (reverse acc)) #f)]
           ;; a dotted tail: `(a . ,e)
           [(list 'unquote e)
            (let ([els (tail-elems (synth e env))])
              (if (and ok els (<= (+ stars (count-stars els)) 1))
                  (cons '#%list (append (reverse acc) els))
                  #f))]
           [(list 'quasiquote _) #f]
           [(cons (list 'unquote-splicing e) rest)
            (let ([els (tail-elems (synth e env))])
              (if els
                  (loop rest (append (reverse els) acc) (+ stars (count-stars els)) ok)
                  (loop rest acc stars #f)))]
           [(cons a rest)
            (let ([s (qq->shape a env)])
              (loop rest (cons (if s s '_) acc) stars ok))]
           [_ (loop '() acc stars #f)])))

     (define (synth-body body env)
       (let* ([names (filter-map
                      (lambda (f)
                        (match f
                          [`(define (,g ,_ ...) ,_ ...) g]
                          [`(define (,g . ,_) ,_ ...) #:when (symbol? g) g]
                          [`(define ,x ,_) #:when (symbol? x) x]
                          [_ #f]))
                      body)]
              [env+ (append (map (lambda (n) (cons n '_)) names) env)])
         (foldl
          (lambda (f t)
            (match f
              [`(define ,_ ,_ ...) '_]
              [e (synth e env+)]))
          '_ body)))

     (define (binding-parts b)
       (match b
         [`(,x : ,t ,e) (check-type-wf t '() adts) (list x t e)]
         [`(,x ,e) (list x '_ e)]))

     (define (check-binding parts env)
       (let ([x (car parts)] [t (car (cdr parts))] [e (car (cdr (cdr parts)))])
         (let ([et (synth e env)])
           (unless (consistent? et t)
             (type-error (format "~a is declared ~a but its value has type ~a" (nm x) (ty t) (ty et)))))))

     (define (formal-type* f)
       (match f [`(,x : ,t) (check-type-wf t '() adts) t] [_ '_]))
     (define (formal-name* f)
       (match f [`(,x : ,t) x] [x x]))

     ;; --- populate `top`: declared types, ctors, annotated defines ---

     (for-each-form
      (lambda (f)
        (match f
          [`(: ,n ,t) (check-type-wf t '() adts) (hash-set! top n t)]
          ;; prelude signatures are TRUSTED: they type calls exactly
          ;; like (: n t), but desugar inserts no casts for them
          ;; (docs/TYPES.md §4) -- the manifest-prim trust class
          [`(#%prelude: ,n ,t) (check-type-wf t '() adts) (hash-set! top n t)]
          [`(define-type ,_ ,cs ...)
           (for-each
            (lambda (c)
              (match c
                [`(,cn ,fts ...)
                 (let* ([info (hash-ref ctors cn)]
                        [owner (ctor-owner info)]
                        [params (ctor-params info)]
                        [res (cons owner params)]
                        [res* (if (null? params) owner res)])
                   (hash-set! top cn (if (null? fts) res* `(-> ,@fts ,res*))))]))
            cs)]
          [_ (void)]))
      forms)

     ;; ---- foreign declarations (docs/FFI.md §3, §5.1) ----------------
     ;; mirrors src/types.rkt byte-for-byte: validate each declaration
     ;; (concrete arrow over the marshallable universe, arity <= 6,
     ;; clauses well-formed, default #:c-name derivable) and enter the
     ;; name at its declared type (widths are Int to the checker; a
     ;; (Nullable τ) result is _).
     (define kw-cname (string->symbol "#:c-name"))
     (define kw-gift (string->symbol "#:gift"))
     (define kw-consumes (string->symbol "#:consumes"))
     (define ffi-widths '(I8 I16 I32 I64 U8 U16 U32 U64))
     (define (ffi-ftype? a) (and (symbol? a) (set-member? ftypes a)))
     (define (ffi-arg-ok? a)
       (or (if (member a '(Int Bool Str)) #t #f)
           (if (member a ffi-widths) #t #f)
           (ffi-ftype? a)))
     (define (ffi-nullable? r)
       (and (pair? r) (eq? (car r) 'Nullable)
            (pair? (cdr r)) (null? (cdr (cdr r)))
            (or (eq? (car (cdr r)) 'Str) (ffi-ftype? (car (cdr r))))))
     (define (ffi-ret-ok? r)
       (or (ffi-arg-ok? r) (eq? r 'Void) (ffi-nullable? r)))
     ;; every name a define binds (foreign names must not collide)
     (define ffi-defined-names
       (let ([s (make-set)])
         (begin
           (for-each
            (lambda (f)
              (when (and (pair? f) (eq? (car f) 'define) (pair? (cdr f)))
                (let ([h (car (cdr f))])
                  (cond [(symbol? h) (set-add! s h)]
                        [(and (pair? h) (symbol? (car h))) (set-add! s (car h))]
                        [else (void)]))))
            forms)
           s)))
     ;; #:c-name default: source spelling with `-` -> `_`; any other
     ;; C-hostile character means the clause is required (§3)
     (define (c-name-defaultable? s)
       (let loop ([i 0])
         (or (>= i (string-length s))
             (let ([b (string-byte s i)])
               (and (or (and (>= b 97) (<= b 122))
                        (and (>= b 65) (<= b 90))
                        (and (>= b 48) (<= b 57))
                        (eq? b 95) (eq? b 45))
                    (loop (+ i 1)))))))
     ;; clause parse -> (list c-name gift consumes?)
     (define (parse-foreign-clauses name cs)
       (let loop ([cs cs] [c-name #f] [gift #f] [consumes #f])
         (cond
           [(null? cs) (list c-name gift consumes)]
           [(and (eq? (car cs) kw-cname) (pair? (cdr cs)) (string? (car (cdr cs))))
            (loop (cdr (cdr cs)) (car (cdr cs)) gift consumes)]
           [(and (eq? (car cs) kw-gift) (pair? (cdr cs)) (string? (car (cdr cs))))
            (loop (cdr (cdr cs)) c-name (car (cdr cs)) consumes)]
           [(eq? (car cs) kw-consumes)
            (loop (cdr cs) c-name gift #t)]
           [else (type-error (format "foreign ~a: malformed clause ~a" (nm name) (car cs)))])))
     (define (check-foreign-decl d)
       (begin
         (unless (and (pair? d) (eq? (car d) ':)
                      (pair? (cdr d)) (symbol? (car (cdr d)))
                      (pair? (cdr (cdr d))))
           (type-error (format "foreign: malformed declaration ~a" d)))
         (let* ([name (car (cdr d))]
                [t (car (cdr (cdr d)))]
                [cv (parse-foreign-clauses name (cdr (cdr (cdr d))))])
           (begin
             (when (hash-has-key? adts name)
               (type-error (format "~a is defined as both a type and a value" (nm name))))
             (when (or (hash-has-key? top name) (set-member? ffi-defined-names name))
               (type-error (format "foreign ~a: duplicate declaration" (nm name))))
             (unless (and (pair? t) (eq? (car t) '->) (pair? (cdr t)))
               (type-error (format "foreign ~a: declared type must be a concrete (-> ...) arrow, got ~a"
                                   (nm name) (ty t))))
             (let* ([tail (cdr t)]
                    [args (reverse (cdr (reverse tail)))]
                    [ret (car (reverse tail))])
               (begin
                 (when (> (length args) 6)
                   (type-error (format "foreign ~a: arity ~a exceeds the FFI limit of 6"
                                       (nm name) (length args))))
                 (for-each
                  (lambda (a)
                    (unless (ffi-arg-ok? a)
                      (type-error (format "foreign ~a: argument type ~a is not marshallable"
                                          (nm name) (ty a)))))
                  args)
                 (unless (ffi-ret-ok? ret)
                   (type-error (format "foreign ~a: result type ~a is not marshallable"
                                       (nm name) (ty ret))))
                 (when (car (cdr cv))   ;; #:gift
                   (unless (or (eq? ret 'Str)
                               (and (ffi-nullable? ret) (eq? (car (cdr ret)) 'Str)))
                     (type-error (format "foreign ~a: #:gift requires a Str or (Nullable Str) result"
                                         (nm name)))))
                 (when (car (cdr (cdr cv)))   ;; #:consumes
                   (unless (eq? (length (filter ffi-ftype? args)) 1)
                     (type-error (format "foreign ~a: #:consumes requires exactly one foreign-handle argument"
                                         (nm name)))))
                 (unless (car cv)
                   (unless (c-name-defaultable? (symbol->string (nm name)))
                     (type-error (format "foreign ~a: needs #:c-name (the name has no default C spelling)"
                                         (nm name)))))
                 (hash-set! top name
                            (append (cons '-> (map (lambda (a) (if (member a ffi-widths) 'Int a)) args))
                                    (list (cond [(ffi-nullable? ret) '_]
                                                [(member ret ffi-widths) 'Int]
                                                [else ret]))))))))))
     (define kw-include (string->symbol "#:include"))
     (define kw-static (string->symbol "#:static"))
     (for-each-form
      (lambda (f)
        (when (and (pair? f) (eq? (car f) 'foreign))
          (begin
            (unless (and (pair? (cdr f)) (string? (car (cdr f))))
              (type-error (format "foreign: expected a library path string in ~a" f)))
            (let* ([ds0 (if (and (pair? (cdr (cdr f))) (string? (car (cdr (cdr f)))))
                            (cdr (cdr (cdr f)))
                            (cdr (cdr f)))]
                   ;; form-level clauses: #:include is the header
                   ;; cross-check (desugar runs it); #:static is a
                   ;; designed seam, not v1
                   [ds (let strip ([r ds0])
                         (cond
                           [(and (pair? r) (eq? (car r) kw-include)
                                 (pair? (cdr r)) (string? (car (cdr r))))
                            (strip (cdr (cdr r)))]
                           [(and (pair? r) (eq? (car r) kw-static))
                            (type-error (format "foreign ~a: #:static linking is a designed seam, not yet implemented (docs/FFI.md §10)"
                                                (car (cdr f))))]
                           [else r]))])
              (begin
                (when (null? ds)
                  (type-error (format "foreign ~a: expected at least one (: name type) declaration"
                                      (car (cdr f)))))
                (for-each check-foreign-decl ds))))))
      forms)

     (for-each-form
      (lambda (f)
        (match f
          [`(define (,g ,formals ...) : ,rt ,_ ...) #:when (valid-formals? formals)
           (unless (hash-has-key? top g)
             (hash-set! top g `(-> ,@(map formal-type formals) ,rt)))]
          [`(define (,g ,formals ...) ,_ ...) #:when (valid-formals? formals)
           (unless (hash-has-key? top g)
             (hash-set! top g `(-> ,@(map formal-type formals) _)))]
          [`(define ,x ,_) #:when (symbol? x)
           (unless (hash-has-key? top x) (hash-set! top x '_))]
          ;; variadic defines -- (define (f a b . rest) ...) -- derive
          ;; a (->* (t ...) _ rt) type: annotated fixed formals keep
          ;; their types, the rest-element type is _ (a (: f (->* ...))
          ;; declaration tightens it), and the arity floor is known
          [`(define (,g . ,formals) ,body0 ...)
           #:when (and (symbol? g) (dotted-formals? formals))
           (unless (hash-has-key? top g)
             (let* ([fr (split-dotted formals)]
                    [fixed (car fr)]
                    [rt (match body0 [`(: ,t ,_ ...) t] [_ '_])])
               (hash-set! top g `(->* ,(map formal-type fixed) _ ,rt))))]
          ;; anything else define-shaped still BINDS (typed _), or
          ;; references to it are rejected as unbound by the strict
          ;; lookup
          [`(define (,g . ,_) ,_ ...) #:when (symbol? g)
           (unless (hash-has-key? top g) (hash-set! top g '_))]
          [_ (void)]))
      forms)

     ;; --- check every top-level form under `top` ---

     ;; each form sees through the abstract types of its own module only
     (define form-mids (form-module-ids forms))
     (for-each-form
      (lambda (f)
        (set! current-module (car form-mids))
        (set! abstract-here (abstract-types-in (car form-mids)))
        (set! form-mids (cdr form-mids))
        ;; FFI forms were validated above
        (if (and (pair? f) (member (car f) '(foreign define-foreign-type #%extern-foreign-type)))
            (void)
        (match f
          [`(define-type ,_ ,_ ...) (void)]
          [`(define-grammar ,_ ,_ ...) (void)]
          [`(define-type-alias ,_ ,_) (void)]
          [`(: ,_ ,_) (void)]
          [`(#%prelude: ,_ ,_) (void)]
          [`(define (,g ,formals ...) ,body0 ...) #:when (valid-formals? formals)
           (let* ([rb (match body0
                        [`(: ,t ,rest ...) (check-type-wf t '() adts) (cons t rest)]
                        [_ (cons '_ body0)])]
                  [rt (car rb)]
                  [body (cdr rb)]
                  [ft (hash-ref top g)]
                  [fts (match ft [`(-> ,as ... ,_) as] [_ (map (lambda (dummy) '_) formals)])]
                  [env (map2 (lambda (n t) (cons n t)) (map formal-name* formals) fts)])
             (for-each (lambda (fm) (formal-type* fm)) formals)
             (let ([bt (synth-body body env)])
               (unless (or (eq? rt '_) (consistent? bt rt))
                 (type-error (format "~a: body has type ~a, declared ~a" (nm g) (ty bt) (ty rt))))))]
          ;; variadic define: fixed formals get their (declared or
          ;; annotated) types, the rest binder is (List trest) in the
          ;; body (docs/TYPES.md: ->*)
          [`(define (,g . ,formals) ,body0 ...)
           #:when (and (symbol? g) (dotted-formals? formals))
           (let* ([fr (split-dotted formals)]
                  [fixed (car fr)]
                  [rest-name (cdr fr)]
                  [rb (match body0
                        [`(: ,t ,rest ...) (begin (check-type-wf t '() adts) (cons t rest))]
                        [_ (cons '_ body0)])]
                  [rt (car rb)]
                  [body (cdr rb)]
                  [ft (hash-ref top g)]
                  [ftr (match ft
                         [`(->* (,ts ...) ,tr ,_) #:when (eq? (length ts) (length fixed))
                          (cons ts tr)]
                         [_ (cons (map (lambda (dummy) '_) fixed) '_)])]
                  [fts (car ftr)]
                  [trest (cdr ftr)])
             (for-each (lambda (fm) (formal-type* fm)) fixed)
             (let* ([env (cons (cons rest-name (list 'List trest))
                               (map2 (lambda (n t) (cons n t))
                                     (map formal-name* fixed) fts))]
                    [bt (synth-body body env)])
               (unless (or (eq? rt '_) (consistent? bt rt))
                 (type-error (format "~a: body has type ~a, declared ~a" (nm g) (ty bt) (ty rt))))))]
          [`(define (,_ . ,_) ,_ ...) (void)]
          [`(define ,x ,e) #:when (symbol? x)
           (let* ([et (synth e '())]
                  [dt (hash-ref/default top x '_)])
             (unless (consistent? et dt)
               (type-error (format "~a is declared ~a but its value has type ~a" (nm x) (ty dt) (ty et))))
             (when (eq? dt '_) (hash-set! top x (if (set-member? assigned x) (loosen et) et))))]
          [e (synth e '())])))
      forms)
     (set! abstract-here '())
     (set! current-module #f)

     p]))

;; the recognizer a grammar's casts call (desugar.puf grammar-recognizer)
(define (gram-pred-name n) (string->symbol (string-append "#%gram?-" (symbol->string n))))
