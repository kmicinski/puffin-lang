;; puffin-12: a small interpreter for PCF, the canonical toy typed language
;; (also a golden-corpus program: src/test-programs/puffin-12.scm -- tests and examples share sources)
;; (Plotkin 1977): naturals with succ/pred, the zero test ifz, unary
;; lambdas, application, and general recursion via fix.
;;
;; Programs and values are plain s-expressions, typed by grammars
;; (docs/GRAMMARS.md): PCF is the syntax below, Value what evaluation
;; produces. Every program in this file is checked against PCF when it
;; compiles -- the templates that splice pcf-add into pcf-mul included
;; -- and pcf-eval's quasiquote patterns get their productions' types.
;; Environments are immutable hashes.
;;
;;   e ::= n | x | (lambda (x) e) | (e e)
;;       | (succ e) | (pred e) | (ifz e e e) | (fix e)
;;
;; fix is call-by-value, eta-delayed: (fix f) is a value; applying
;; it to v unrolls one step, applying f to (fix f) and then to v.

(define-grammar PCF
  #:keywords (lambda succ pred ifz fix)
  Int
  Sym
  (lambda (Sym) PCF)
  (succ PCF)
  (pred PCF)
  (ifz PCF PCF PCF)
  (fix PCF)
  (PCF PCF))

(define-grammar Value
  Int
  (closure Sym PCF (Hash Sym Value))
  (fixpoint Value))

(define (pcf-eval [e : PCF] [env : (Hash Sym Value)]) : Value
  (match e
    [(? fixnum? n) n]
    [(? symbol? x)
     (if (hash-has-key? env x)
         (hash-ref env x)
         (error `(unbound ,x)))]
    [`(lambda (,x) ,body) `(closure ,x ,body ,env)]
    [`(succ ,e0) (+ (num (pcf-eval e0 env)) 1)]
    [`(pred ,e0)
     (let ([n (num (pcf-eval e0 env))])
       (if (eq? n 0) 0 (- n 1)))]                 ;; pred 0 = 0, as in PCF
    [`(ifz ,e0 ,e1 ,e2)
     (if (eq? (num (pcf-eval e0 env)) 0)
         (pcf-eval e1 env)
         (pcf-eval e2 env))]
    [`(fix ,e0) `(fixpoint ,(pcf-eval e0 env))]
    [`(,e-f ,e-a)
     (pcf-apply (pcf-eval e-f env) (pcf-eval e-a env))]))

(define (pcf-apply [vf : Value] [va : Value]) : Value
  (match vf
    [`(closure ,x ,body ,env) (pcf-eval body (hash-set env x va))]
    [`(fixpoint ,f) (pcf-apply (pcf-apply f vf) va)]
    [_ (error `(not-a-function ,vf))]))

(define (num [v : Value]) : Int
  (match v
    [(? fixnum? n) n]
    [_ (error `(not-a-number ,v))]))

(define (run [e : PCF]) : Value (pcf-eval e (hash)))

;; addition, defined recursively on the first argument
(define pcf-add
  '(fix (lambda (add)
          (lambda (m)
            (lambda (n)
              (ifz m n (succ ((add (pred m)) n))))))))

(println (run `((,pcf-add 3) 4)))                          ;; 7

;; multiplication, using add
(define pcf-mul
  `(fix (lambda (mul)
          (lambda (m)
            (lambda (n)
              (ifz m 0 ((,pcf-add n) ((mul (pred m)) n))))))))

(println (run `((,pcf-mul 6) 7)))                          ;; 42

;; factorial, using mul
(define pcf-fact
  `(fix (lambda (fact)
          (lambda (n)
            (ifz n (succ 0) ((,pcf-mul n) (fact (pred n))))))))

(println (run `(,pcf-fact 6)))                             ;; 720

;; higher-order: twice, and pred as a first-class function
(println (run '(((lambda (f) (lambda (x) (f (f x))))
                 (lambda (y) (pred y)))
                9)))                                       ;; 7

;; PCF programs are data: count the lambdas in pcf-fact. This walker
;; visits every element of every list -- keywords like fix included,
;; which are not PCF terms -- so it stays unannotated: an untyped
;; walk over any s-expression (annotating e : PCF would make the
;; deep cast reject the bare `fix` it recurses into)
(define (count-lambdas e)
  (match e
    [`(lambda (,_) ,body) (+ 1 (count-lambdas body))]
    [`(,es ...) (foldl (lambda (x acc) (+ acc (count-lambdas x))) 0 es)]
    [_ 0]))

(println (list 'lambdas-in-fact (count-lambdas pcf-fact)))
(run `(,pcf-fact 5))
